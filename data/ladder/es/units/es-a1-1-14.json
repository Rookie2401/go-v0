              "text": "Yo llego a las tres.",
              "english": "(Message) I arrive at three."
            },
            {
              "speaker": "pastor",
              "text": "Está bien.",
              "english": "(Message) Good."
            },
            {
              "speaker": "pastor",
              "text": "Estoy en la iglesia.",
              "english": "I am at the church."
            },
            {
