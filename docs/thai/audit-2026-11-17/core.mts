const words = [...new Set(LIST.split(/\s+/).filter(Boolean))];
const tok = (w: string) => thAdapter.tokenize(w).filter((t) => t.isWord).map((t) => t.surface);
const inList: string[] = []; const dictOnly: string[] = []; const neither: string[] = []; const split: string[] = [];
for (const w of words) {
  const n = thAdapter.normalize(w);
  const cut = tok(w);
  const whole = cut.length === 1;
  if (thLexicon.has(n)) { inList.push(w); if (!whole) split.push(`${w}[list]→${cut.join('+')}`); }
  else if (isDictionaryWord(n)) { dictOnly.push(w); if (!whole) split.push(`${w}[dict]→${cut.join('+')}`); }
  else { neither.push(`${w}→${cut.join('+')}`); }
}
const pct = (a: number) => `${a} of ${words.length} (${(100 * a / words.length).toFixed(0)} %)`;
const out = [
  `${words.length} everyday words checked`,
  `in the course word list (own meaning): ${pct(inList.length)}`,
  `only a dictionary headword (part of speech, no own meaning): ${pct(dictOnly.length)}\n  ${dictOnly.join(' ')}`,
  `in neither list: ${pct(neither.length)}\n  ${neither.join(' ')}`,
  `in a list but cut into pieces by the tokenizer when written alone: ${split.length}\n  ${split.join(' ')}`,
];
fs.writeFileSync('C:/Users/CJWal/dev/tmp-mem/thaudit/core.out.txt', out.join('\n') + '\n', 'utf8');
console.log(out.join('\n'));
