    { "id": "amb-015", "sentence": "Il marche vite.", "target": "marche", "expect": { "lemma": "marcher", "pos": "VERB", "features": { "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "after il, marche is marcher" },
    { "id": "amb-016", "sentence": "La marche est longue.", "target": "marche", "expect": { "lemma": "marche", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "la marche: the walk" },
