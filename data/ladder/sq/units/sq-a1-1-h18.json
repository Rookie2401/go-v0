      "title": "Mëngjesi i Anës",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Ana zgjohet herët.",
              "english": "Ana wakes up early."
            },
            {
              "text": "Ajo punon në klinikë sot.",
              "english": "She works at the clinic today."
            },
            {
              "text": "Ana lahet dhe vishet.",
              "english": "Ana washes and gets dressed."
            },
            {
              "text": "Pastaj ajo shkon në kuzhinë.",
              "english": "Then she goes to the kitchen."
            },
            {
              "text": "Luan është në kuzhinë.",
              "english": "Luan is in the kitchen."
            },
            {
              "text": "Ai përgatit kafe.",
              "english": "He makes coffee."
            },
            {
              "text": "— Mirëmëngjes, Ana!",
              "english": "\"Good morning, Ana!\""
            },
            {
              "text": "— Mirëmëngjes, Luan!",
              "english": "\"Good morning, Luan!\""
            },
            {
              "text": "Luan i jep kafe.",
              "english": "Luan gives her coffee."
            },
            {
              "text": "Ana pi kafe dhe ha bukë.",
              "english": "Ana drinks coffee and eats bread."
            },
            {
              "text": "Është mëngjes i bukur.",
              "english": "It is a beautiful morning."
            },
            {
              "text": "Tani Ana shkon në klinikë.",
              "english": "Now Ana goes to the clinic."
            }
          ]
        }
      ]
    }
