      "title": "Pas punës",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Ana vjen nga puna.",
              "english": "Ana comes home from work."
            },
            {
              "text": "Ajo punon shumë në klinikë.",
              "english": "She works a lot at the clinic."
            },
            {
              "text": "Ajo është e lodhur.",
              "english": "She is tired."
            },
            {
              "text": "Luan është në kuzhinë.",
              "english": "Luan is in the kitchen."
            },
            {
              "text": "Ai bën darkë.",
              "english": "He makes dinner."
            },
            {
              "text": "Ana ulet në tavolinë.",
              "english": "Ana sits down at the table."
            },
            {
              "text": "Mbi tavolinë ka dy pjata.",
              "english": "On the table there are two plates."
            },
            {
              "text": "Luan i jep çaj.",
              "english": "Luan gives her tea."
            },
            {
              "text": "Ana pi çaj dhe lexon.",
              "english": "Ana drinks tea and reads."
            },
            {
              "text": "Pastaj Luan dhe Ana hanë.",
              "english": "Then Luan and Ana eat."
            },
            {
              "text": "Orizi dhe buka janë të mira.",
              "english": "The rice and the bread are good."
            },
            {
              "text": "Ana thotë: — Faleminderit, Luan!",
              "english": "Ana says: \"Thank you, Luan!\""
            }
          ]
        }
      ]
    }
