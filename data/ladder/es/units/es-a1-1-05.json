            },
            {
              "speaker": "marta",
              "text": "Mucho gusto, Daniel.",
              "english": "Nice to meet you, Daniel."
            },
            {
              "speaker": "marta",
              "text": "Aquí tiene un plato.",
              "english": "Here is a plate."
            },
            {
              "speaker": "daniel",
              "text": "Gracias, doña Marta.",
              "english": "Thank you, doña Marta."
            },
            {
              "speaker": "nico",
              "text": "Abuela, tengo hambre.",
              "english": "Grandma, I am hungry."
            },
            {
              "speaker": "marta",
              "text": "Vamos a dar gracias por la comida.",
              "english": "Let us give thanks for the food."
            },
            {
              "speaker": "ricardo",
              "text": "Gracias por la familia y por la comida.",
