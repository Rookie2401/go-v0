    {"text":"Vamos a cenar en un restaurante italiano.","tokens":["Vamos","a","cenar","en","un","restaurante","italiano"],"heads":[2,2,-1,5,5,2,5],"relations":["aux","mark","root","case","det","obl","amod"]},
    {"text":"El gobierno anunció nuevas medidas económicas.","tokens":["El","gobierno","anunció","nuevas","medidas","económicas"],"heads":[1,2,-1,4,2,4],"relations":["det","nsubj","root","amod","obj","amod"]},
    {"text":"Estudiamos mucho porque queremos aprobar el examen.","tokens":["Estudiamos","mucho","porque","queremos","aprobar","el","examen"],"heads":[-1,0,3,0,3,6,4],"relations":["root","advmod","mark","advcl","xcomp","det","obj"]},
    {"text":"Dijo que no volvería nunca más.","tokens":["Dijo","que","no","volvería","nunca","más"],"heads":[-1,3,3,0,3,4],"relations":["root","mark","advmod","ccomp","advmod","advmod"]},
    {"text":"Los precios han subido mucho este año.","tokens":["Los","precios","han","subido","mucho","este","año"],"heads":[1,3,3,-1,3,6,3],"relations":["det","nsubj","aux","root","advmod","det","obl"]},
    {"text":"Si tienes tiempo, llámame esta tarde.","tokens":["Si","tienes","tiempo","llámame","esta","tarde"],"heads":[1,3,1,-1,5,3],"relations":["mark","advcl","obj","root","det","obl"]},
    {"text":"La película empezó a las ocho de la noche.","tokens":["La","película","empezó","a","las","ocho","de","la","noche"],"heads":[1,2,-1,5,5,2,8,8,5],"relations":["det","nsubj","root","case","det","obl","case","det","nmod"]},
    {"text":"Mi hermana pequeña quiere ser médica.","tokens":["Mi","hermana","pequeña","quiere","ser","médica"],"heads":[1,3,1,-1,5,3],"relations":["det","nsubj","amod","root","cop","xcomp"]},
    {"text":"Vi a tus padres en la calle.","tokens":["Vi","a","tus","padres","en","la","calle"],"heads":[-1,3,3,0,6,6,0],"relations":["root","case","det","obj","case","det","obl"]},
