    {"text":"Ellos no saben nada de política.","tokens":["Ellos","no","saben","nada","de","política"],"heads":[2,2,-1,2,5,3],"relations":["nsubj","advmod","root","obj","case","nmod"]},
    {"text":"El profesor dijo que los exámenes serán difíciles.","tokens":["El","profesor","dijo","que","los","exámenes","serán","difíciles"],"heads":[1,2,-1,7,5,7,7,2],"relations":["det","nsubj","root","mark","det","nsubj","cop","ccomp"]},
    {"text":"Tengo una hermana que vive en Madrid.","tokens":["Tengo","una","hermana","que","vive","en","Madrid"],"heads":[-1,2,0,4,2,6,4],"relations":["root","det","obj","nsubj","acl","case","obl"]},
