    {
      "id": "l1",
      "text": "Det regner. I kveld spiser vi hos Marta.",
      "en": "It is raining. Tonight we are eating at Marta's.",
      "speaker": "ana",
      "picture": "🌧️🌆🍽️",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l2",
      "text": "I kveld spiser vi klokka sju. Jeg har ris og brød. Hva vil du ha, Sam?",
      "en": "We eat at seven o'clock tonight. I have rice and bread. What do you want, Sam?",
      "speaker": "marta",
      "picture": "🕖🍚🍞❓",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l3",
      "text": "Jeg vil ha ris, fordi jeg er sulten.",
      "en": "I want rice, because I am hungry.",
      "speaker": "sam",
      "picture": "🍚😋",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l4",
      "text": "Jeg er også sulten. Bestemor, hva koster brødet i dag?",
      "en": "I am hungry too. Grandma, how much is the bread today?",
      "speaker": "nico",
      "picture": "😋🍞💵❓",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l5",
      "text": "Det koster ingenting, Nils.",
      "en": "It costs nothing, Nils.",
      "speaker": "marta",
      "picture": "😄",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l6",
      "text": "Ingenting? Dette er veldig bra!",
      "en": "Nothing? This is very good!",
      "speaker": "sam",
      "picture": "🙂",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l7",
      "text": "Takk, bestemor! Jeg rydder av bordet.",
      "en": "Thank you, Grandma! I will clear the table.",
      "speaker": "nico",
      "picture": "🙏🍽️",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l8",
      "text": "Jeg rydder av bordet også.",
      "en": "I will clear the table too.",
