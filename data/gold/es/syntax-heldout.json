    {"text":"Quiero hablar con el director de la escuela.","tokens":["Quiero","hablar","con","el","director","de","la","escuela"],"heads":[-1,0,4,4,1,7,7,4],"relations":["root","xcomp","case","det","obl","case","det","nmod"]},
    {"text":"Mi tío trabaja en un hospital grande.","tokens":["Mi","tío","trabaja","en","un","hospital","grande"],"heads":[1,2,-1,5,5,2,5],"relations":["det","nsubj","root","case","det","obl","amod"]},
