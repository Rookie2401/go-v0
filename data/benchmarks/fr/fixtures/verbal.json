    { "id": "verb-071", "sentence": "Allons-y !", "target": "Allons", "expect": { "lemma": "aller", "pos": "VERB", "features": { "Mood": "Imp", "Person": "1", "Number": "Plur" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "first person plural imperative" },
    { "id": "verb-072", "sentence": "Il allait à Paris.", "target": "allait", "expect": { "lemma": "aller", "pos": "VERB", "features": { "Tense": "Imp", "Person": "3" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "aller imparfait" },
    { "id": "verb-073", "sentence": "Nous faisons un gâteau.", "target": "faisons", "expect": { "lemma": "faire", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "1", "Number": "Plur" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "faire: faisons is irregular in spelling and sound" },
