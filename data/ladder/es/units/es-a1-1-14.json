              "speaker": "sam",
              "text": "¡Aquí está mi celular!",
              "english": "Here is my phone!"
            },
            {
              "speaker": "sam",
              "text": "Está en mi libro.",
              "english": "It is in my book."
            },
            {
              "speaker": "karla",
              "text": "¡Qué bueno!",
              "english": "How good!"
            }
          ]
        },
        {
          "sentences": [
            {
              "speaker": "pastor",
              "text": "Karla, vas a enviar un mensaje.",
              "english": "Karla, you are going to send a message."
            },
            {
              "text": "Karla tiene el teléfono en la mano.",
              "english": "Karla has the phone in her hand."
            },
            {
              "speaker": "karla",
              "text": "Reunión el sábado a las tres en la iglesia.",
              "english": "(Message) Meeting on Saturday at three at the church."
            },
            {
              "speaker": "karla",
              "text": "Favor venir.",
              "english": "(Message) Please come."
            },
            {
              "text": "Karla envía el mensaje al equipo.",
              "english": "Karla sends the message to the team."
            },
            {
              "speaker": "ana",
              "text": "Aquí está, Karla.",
              "english": "Here it is, Karla."
            },
            {
              "speaker": "daniel",
              "text": "Dice: sábado, a las tres.",
              "english": "It says: Saturday, at three."
            },
            {
              "speaker": "sam",
              "text": "¿Está cerca?",
              "english": "Is it near?"
            },
            {
              "speaker": "sam",
              "text": "¿Está lejos?",
              "english": "Is it far?"
            },
            {
