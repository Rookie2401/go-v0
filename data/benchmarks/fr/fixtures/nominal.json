{
  "category": "nominal",
  "note": "Gender, plurals (regular, irregular, invariable, look-alike), articles, demonstratives, possessives, contractions, du/des/la/le/les by context, adjective agreement and position. Contractions (au, aux, du, des) assert only `parts` (the contract does not name a lemma for the contraction). An AI's judgement, not native-reviewed.",
  "cases": [
    { "id": "nom-001", "sentence": "Le cheval court.", "target": "cheval", "expect": { "lemma": "cheval", "pos": "NOUN", "features": { "Gender": "Masc", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "regular masculine noun" },
    { "id": "nom-002", "sentence": "Les chevaux courent.", "target": "chevaux", "expect": { "lemma": "cheval", "pos": "NOUN", "features": { "Gender": "Masc", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-al nouns make -aux plurals" },
    { "id": "nom-003", "sentence": "Les journaux sont là.", "target": "journaux", "expect": { "lemma": "journal", "pos": "NOUN", "features": { "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "journal → journaux" },
    { "id": "nom-004", "sentence": "Elle a de beaux yeux.", "target": "yeux", "expect": { "lemma": "œil", "pos": "NOUN", "features": { "Gender": "Masc", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "suppletive plural: yeux is the plural of œil" },
    { "id": "nom-005", "sentence": "Ces travaux durent longtemps.", "target": "travaux", "expect": { "lemma": "travail", "pos": "NOUN", "features": { "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-ail → -aux (travail)" },
    { "id": "nom-006", "sentence": "Les messieurs entrent.", "target": "messieurs", "expect": { "lemma": "monsieur", "pos": "NOUN", "features": { "Gender": "Masc", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "monsieur → messieurs, an irregular plural" },
    { "id": "nom-007", "sentence": "Les hommes parlent.", "target": "hommes", "expect": { "lemma": "homme", "pos": "NOUN", "features": { "Gender": "Masc", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "regular -s plural" },
    { "id": "nom-008", "sentence": "Les bals sont beaux.", "target": "bals", "expect": { "lemma": "bal", "pos": "NOUN", "features": { "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "bal is an exception to -al → -aux" },
    { "id": "nom-009", "sentence": "Ces festivals sont connus.", "target": "festivals", "expect": { "lemma": "festival", "pos": "NOUN", "features": { "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "festival is an exception to -al → -aux" },
    { "id": "nom-010", "sentence": "Elle porte des bijoux.", "target": "bijoux", "expect": { "lemma": "bijou", "pos": "NOUN", "features": { "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "bijou takes -x in the plural" },
    { "id": "nom-011", "sentence": "Les cieux sont immenses.", "target": "cieux", "expect": { "lemma": "ciel", "pos": "NOUN", "features": { "Number": "Plur" } }, "source": "kaikki", "level": "advanced", "why": "ciel has two plurals; cieux is the literary one" },
    { "id": "nom-012", "sentence": "Son fils est grand.", "target": "fils", "expect": { "lemma": "fils", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "fils is invariable: same form singular and plural" },
    { "id": "nom-013", "sentence": "Le temps passe vite.", "target": "temps", "expect": { "lemma": "temps", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "a noun in -s is not a plural of a shorter word" },
    { "id": "nom-014", "sentence": "Sa voix est douce.", "target": "voix", "expect": { "lemma": "voix", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "voix is invariable and feminine" },
    { "id": "nom-015", "sentence": "Il a un grand nez.", "target": "nez", "expect": { "lemma": "nez", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "a final -z is not a plural mark" },
    { "id": "nom-016", "sentence": "Une souris mange le fromage.", "target": "souris", "expect": { "lemma": "souris", "pos": "NOUN", "features": { "Gender": "Fem" }, "notLemma": "souri" }, "source": "kaikki", "level": "core", "why": "souris only looks plural: the lemma is souris" },
    { "id": "nom-017", "sentence": "Ce héros est courageux.", "target": "héros", "expect": { "lemma": "héros", "pos": "NOUN", "features": { "Gender": "Masc" }, "notLemma": "héro" }, "source": "kaikki", "level": "core", "why": "héros only looks plural" },
    { "id": "nom-018", "sentence": "Il a le bras cassé.", "target": "bras", "expect": { "lemma": "bras", "pos": "NOUN", "features": { "Gender": "Masc" }, "notLemma": "bra" }, "source": "kaikki", "level": "core", "why": "bras only looks plural" },
    { "id": "nom-019", "sentence": "La maison est grande.", "target": "maison", "expect": { "lemma": "maison", "pos": "NOUN", "features": { "Gender": "Fem", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "regular feminine noun" },
    { "id": "nom-020", "sentence": "Les maisons sont grandes.", "target": "maisons", "expect": { "lemma": "maison", "pos": "NOUN", "features": { "Gender": "Fem", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "regular -s plural" },
    { "id": "nom-021", "sentence": "Le chat dort.", "target": "Le", "expect": { "lemma": "le", "pos": "DET", "features": { "Gender": "Masc", "Definite": "Def", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "definite article, masculine singular" },
    { "id": "nom-022", "sentence": "La chatte dort.", "target": "La", "expect": { "lemma": "le", "pos": "DET", "features": { "Gender": "Fem", "Definite": "Def", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "definite article, feminine singular; its lemma is le" },
    { "id": "nom-023", "sentence": "Les chats dorment.", "target": "Les", "expect": { "lemma": "le", "pos": "DET", "features": { "Definite": "Def", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "definite article, plural" },
    { "id": "nom-024", "sentence": "Un chat dort.", "target": "Un", "expect": { "lemma": "un", "pos": "DET", "features": { "Gender": "Masc", "Definite": "Ind", "Number": "Sing" } }, "alsoAcceptPos": ["NUM"], "source": "kaikki", "level": "core", "why": "indefinite article, masculine" },
    { "id": "nom-025", "sentence": "Une chatte dort.", "target": "Une", "expect": { "lemma": "un", "pos": "DET", "features": { "Gender": "Fem", "Definite": "Ind", "Number": "Sing" } }, "alsoAcceptPos": ["NUM"], "source": "kaikki", "level": "core", "why": "indefinite article, feminine: une is a form of un" },
    { "id": "nom-026", "sentence": "Il mange du pain.", "target": "du", "expect": { "lemma": "du", "pos": "DET", "features": { "PronType": "Part" }, "construction": "partitive-article" }, "source": "kaikki", "level": "advanced", "why": "du before a mass noun is the partitive article, not the contraction de + le" },
    { "id": "nom-027", "sentence": "Il vient du marché.", "target": "du", "expect": { "parts": ["de", "le"], "construction": "contraction-article" }, "source": "grammar", "level": "advanced", "why": "du after a verb of origin is the contraction de + le (from the market)" },
    { "id": "nom-028", "sentence": "Il mange de la viande.", "target": "la", "expect": { "lemma": "le", "pos": "DET", "features": { "Gender": "Fem" }, "construction": "partitive-article" }, "source": "grammar", "level": "advanced", "why": "de la before a mass noun is the feminine partitive" },
    { "id": "nom-029", "sentence": "Elle va au marché.", "target": "au", "expect": { "parts": ["à", "le"], "construction": "contraction-article" }, "source": "grammar", "level": "core", "why": "au = à + le" },
    { "id": "nom-030", "sentence": "Elle parle aux enfants.", "target": "aux", "expect": { "parts": ["à", "le"], "construction": "contraction-article" }, "source": "grammar", "level": "core", "why": "aux = à + les (the second half's lemma is le)" },
    { "id": "nom-031", "sentence": "Il parle des enfants.", "target": "des", "expect": { "parts": ["de", "le"], "construction": "contraction-article" }, "source": "grammar", "level": "advanced", "why": "des after parler is the contraction de + les (about the children)" },
    { "id": "nom-032", "sentence": "Il a des amis.", "target": "des", "expect": { "lemma": "un", "pos": "DET", "features": { "Number": "Plur", "Definite": "Ind" } }, "source": "kaikki", "level": "advanced", "why": "des before the object of avoir is the plural indefinite article (a form of un)" },
    { "id": "nom-033", "sentence": "Je la vois.", "target": "la", "expect": { "pos": "PRON", "features": { "Gender": "Fem", "Case": "Acc" } }, "source": "grammar", "level": "core", "why": "la before a verb is the direct-object pronoun, not the article" },
    { "id": "nom-034", "sentence": "Je vois la maison.", "target": "la", "expect": { "lemma": "le", "pos": "DET", "features": { "Gender": "Fem" } }, "source": "grammar", "level": "core", "why": "la before a noun is the article" },
    { "id": "nom-035", "sentence": "Je le vois.", "target": "le", "expect": { "lemma": "le", "pos": "PRON", "features": { "Gender": "Masc", "Case": "Acc" } }, "source": "grammar", "level": "core", "why": "le before a verb is the direct-object pronoun" },
    { "id": "nom-036", "sentence": "Je les vois.", "target": "les", "expect": { "lemma": "le", "pos": "PRON", "features": { "Number": "Plur", "Case": "Acc" } }, "source": "kaikki", "level": "core", "why": "les before a verb is the plural direct-object pronoun" },
    { "id": "nom-037", "sentence": "Ce livre est bon.", "target": "Ce", "expect": { "lemma": "ce", "pos": "DET", "features": { "PronType": "Dem", "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "ce before a masculine noun is the demonstrative determiner" },
    { "id": "nom-038", "sentence": "Cet homme est grand.", "target": "Cet", "expect": { "lemma": "ce", "pos": "DET", "features": { "PronType": "Dem", "Gender": "Masc", "Number": "Sing" } }, "source": "ud", "level": "core", "why": "cet before a vowel is the form of ce (UD GSD lemma ce; the extract lists cet as a lemma of its own, and the demonstrative lemma is chosen as ce here)" },
    { "id": "nom-039", "sentence": "Cette femme est grande.", "target": "Cette", "expect": { "lemma": "ce", "pos": "DET", "features": { "PronType": "Dem", "Gender": "Fem", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "cette is the feminine of ce" },
    { "id": "nom-040", "sentence": "Ces livres sont bons.", "target": "Ces", "expect": { "lemma": "ce", "pos": "DET", "features": { "PronType": "Dem", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "ces is the plural of ce" },
    { "id": "nom-041", "sentence": "Mon père dort.", "target": "Mon", "expect": { "lemma": "mon", "pos": "DET", "features": { "Poss": "Yes", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "possessive determiner" },
    { "id": "nom-042", "sentence": "Ma mère dort.", "target": "Ma", "expect": { "lemma": "mon", "pos": "DET", "features": { "Poss": "Yes", "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "ma is the feminine of mon" },
    { "id": "nom-043", "sentence": "Mes frères dorment.", "target": "Mes", "expect": { "lemma": "mon", "pos": "DET", "features": { "Poss": "Yes", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "mes is the plural of mon" },
    { "id": "nom-044", "sentence": "Leur maison est grande.", "target": "Leur", "expect": { "lemma": "leur", "pos": "DET", "features": { "Poss": "Yes" } }, "source": "kaikki", "level": "core", "why": "leur before a noun is the possessive determiner" },
    { "id": "nom-045", "sentence": "Leurs amis arrivent.", "target": "Leurs", "expect": { "lemma": "leur", "pos": "DET", "features": { "Poss": "Yes", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "leurs is the plural of the possessive leur (UD GSD gives the lemma son: the dictionary's lemma leur is used here)" },
    { "id": "nom-046", "sentence": "Une belle maison est à vendre.", "target": "belle", "expect": { "lemma": "beau", "pos": "ADJ", "features": { "Gender": "Fem", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "belle is the feminine of beau" },
    { "id": "nom-047", "sentence": "J'ai une nouvelle voiture.", "target": "nouvelle", "expect": { "lemma": "nouveau", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "nouvelle is the feminine of nouveau" },
    { "id": "nom-048", "sentence": "Une vieille maison est ici.", "target": "vieille", "expect": { "lemma": "vieux", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "vieille is the feminine of vieux" },
    { "id": "nom-049", "sentence": "C'est une femme heureuse.", "target": "heureuse", "expect": { "lemma": "heureux", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "-eux → -euse" },
    { "id": "nom-050", "sentence": "Elle porte une chemise blanche.", "target": "blanche", "expect": { "lemma": "blanc", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "blanc → blanche" },
    { "id": "nom-051", "sentence": "C'est une loi nationale.", "target": "nationale", "expect": { "lemma": "national", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "regular -al → -ale" },
    { "id": "nom-052", "sentence": "Une longue route nous attend.", "target": "longue", "expect": { "lemma": "long", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "long → longue keeps the hard g" },
    { "id": "nom-053", "sentence": "C'est une rue publique.", "target": "publique", "expect": { "lemma": "public", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "public → publique" },
    { "id": "nom-054", "sentence": "Elle a la peau sèche.", "target": "sèche", "expect": { "lemma": "sec", "pos": "ADJ", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "sec → sèche (accent and -che)" },
    { "id": "nom-055", "sentence": "C'est un bel homme.", "target": "bel", "expect": { "lemma": "beau", "pos": "ADJ", "features": { "Gender": "Masc", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "bel is the masculine of beau before a vowel" },
    { "id": "nom-056", "sentence": "C'est un vieil ami.", "target": "vieil", "expect": { "lemma": "vieux", "pos": "ADJ", "features": { "Gender": "Masc", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "vieil is the masculine of vieux before a vowel" },
    { "id": "nom-057", "sentence": "C'est un grand homme.", "target": "grand", "expect": { "lemma": "grand", "pos": "ADJ" }, "source": "kaikki", "level": "core", "why": "adjective before the noun" },
    { "id": "nom-058", "sentence": "C'est un homme grand.", "target": "grand", "expect": { "lemma": "grand", "pos": "ADJ" }, "source": "kaikki", "level": "core", "why": "adjective after the noun: the same lemma and part of speech" },
    { "id": "nom-059", "sentence": "Ils ont des chevaux blancs.", "target": "blancs", "expect": { "lemma": "blanc", "pos": "ADJ", "features": { "Gender": "Masc", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "masculine plural adjective" },
    { "id": "nom-060", "sentence": "Les belles maisons sont chères.", "target": "belles", "expect": { "lemma": "beau", "pos": "ADJ", "features": { "Gender": "Fem", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "feminine plural of beau" },
    { "id": "nom-061", "sentence": "Ces beaux jours sont finis.", "target": "beaux", "expect": { "lemma": "beau", "pos": "ADJ", "features": { "Gender": "Masc", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "masculine plural of beau" },
    { "id": "nom-062", "sentence": "C'est un garçon courageux.", "target": "courageux", "expect": { "lemma": "courageux", "pos": "ADJ", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "a final -x is not assumed to be a plural" }
  ]
}
