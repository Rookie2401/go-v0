# Copy to .env.local (git-ignored: *.local) and fill in. Read by the dev and preview servers only; they are never
# bundled into the app and never reach import.meta.env. Restart the server after changing them.
# See docs/SPEECH.md.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional exact extension origins permitted by the localhost-only speech proxy (comma separated).
GO_SPEECH_ALLOWED_EXTENSION_ORIGINS=
# Required bearer token for voice listing and synthesis. Clients must send
# Authorization: Bearer <same token>; it is separate from the Azure key and never sent upstream.
GO_SPEECH_AUTH_TOKEN=
# Optional positive limits (defaults: 20480 bytes, 5000 chars, 30 requests/minute, 20 seconds).
GO_SPEECH_MAX_BODY_BYTES=
GO_SPEECH_MAX_TEXT_CHARS=
GO_SPEECH_RATE_LIMIT_PER_MINUTE=
GO_SPEECH_UPSTREAM_TIMEOUT_MS=
# In-memory daily character budget; resets when the speech server restarts.
GO_SPEECH_DAILY_CHARACTER_LIMIT=

# ---------------------------------------------------------------------------------------------------------------------
# Go Repository service (packages/repository-service). Environment of the service process, NOT read from this file:
# on a server put these in /etc/go-repository/env (infra/repository/go-repository.env.example); locally set them in the
# shell that starts the service. Every one is optional. Nothing secret belongs in the repository. docs/ops/DEPLOY.md
# ---------------------------------------------------------------------------------------------------------------------
# Postgres instead of the SQLite file in --data (postgres://user:password@host:5432/dbname?sslmode=require). docs/ops/SCALING.md
DATABASE_URL=
# Behind Caddy: 1 (last X-Forwarded-For entry). Behind the Cloudflare tunnel: cloudflare (CF-Connecting-IP). Else leave empty.
# Set it only when nothing but the proxy can reach the service (listen on 127.0.0.1).
TRUST_PROXY=
# json = one JSON object per request with a request id.
LOG_FORMAT=
# Bearer token for GET /metrics. Empty: only the local machine (and not through a proxy) may scrape. docs/ops/MONITORING.md
METRICS_TOKEN=
# Rate limits: RATE_LIMIT=off disables; otherwise RATE_<NAME>_MAX and RATE_<NAME>_WINDOW_S for SIGNIN (10/60), SIGNUP (5/3600),
# SYNC_PUSH (60/60, per account), GENERAL (600/60), RECOVERY (10/3600), EXPORT (3/3600, per account).
RATE_LIMIT=
# Email (verification, password reset). Choose one; with neither, messages are written to <data>/outbox and verification is not enforced.
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM=
# The hosted GoLearn setup app. Emails link to <APP_PUBLIC_URL>#/verify?token=... and <APP_PUBLIC_URL>#/reset?token=...
# No default: without it an email carries the code alone.
APP_PUBLIC_URL=
# Days an unverified account may still sign in (7). Days a requested account deletion waits before the purge (14).
GRACE_DAYS=
DELETE_GRACE_DAYS=
# Backups (scripts/ops/backup.mts). docs/ops/BACKUP-RESTORE.md
BACKUP_PASSPHRASE=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_UPLOAD_CMD=
