INTJ","s":[{"g":"woe!, alas!"}],"ety":{"text":"Possibly from Proto-Albanian *wai, from Proto-Indo-European *wáy (“woe!, alas!”); similar words are found in several European languages. Cognate to Ancient Greek ὀά (oá, “woe!, alas!”) and Old Armenian վայ (vay, “cry of pain”), Latin vae, Icelandic vei, Dutch wee, English woe. Compare also Romanian vai, Serbo-Croatian авај (avaj), Italian guai. In view of a widespread secondary meaning 'to cry', one may also consider Proto-Albanian *vabja, connected with Old Church Slavonic вабимо (vabimo, “being lured”), Gothic 𐍅𐍉𐍀𐌾𐌰𐌽 (wōpjan, “call out”), Old English wēpan (“weep, cry”).","tpl":[{"k":35,"lang":36,"form":"*wai"},{"k":35,"lang":38,"form":"*wáy","gloss":"woe!, alas!"},{"k":29,"lang":45,"form":"ὀά","gloss":"woe!, alas!"},{"k":29,"lang":90,"form":"վայ","gloss":"cry of pain"},{"k":29,"lang":"la","form":"vae"},{"k":29,"lang":"is","form":"vei"},{"k":29,"lang":"nl","form":"wee"},{"k":29,"lang":"en","form":"woe"},{"k":29,"lang":"ro","form":"vai"},{"k":29,"lang":"sh","form":"авај"},{"k":29,"lang":"it","form":"guai"},{"k":31,"lang":36,"form":"*vabja"},{"k":29,"lang":"cu","form":"вабимо","gloss":"being lured"},{"k":29,"lang":77,"form":"𐍅𐍉𐍀𐌾𐌰𐌽","gloss":"call out"},{"k":29,"lang":72,"form":"wēpan","gloss":"weep, cry"}]},"rel":{"r":["vajtoj","kukuvajkë"]}}],"valbona":[{"w":"Valbona","p":"PROPN","s":[{"g":"a female given name","t":20}],"ety":{"text":"From Latin Vallis bona (“good valley”).","tpl":[{"k":37,"lang":"la","form":"Vallis bona","gloss":"good valley"}]}}],"vangjel":[{"w":"Vangjel","p":"PROPN","s":[{"g":"a male given name"}],"f":[["Vangjél",160],["Vangjel",4,3],["Vangjeli",3,3],["Vangjel",2,3],["Vangjelin",1,3],["Vangjeli",22,3],["Vangjelit",21,3]],"tpl":["sq-noun-m-unc"]}],"vorr":[{"w":"vorr","p":"NOUN","s":[{"g":"grave","t":0}],"f":[["vorre",6],["vorri",5],["vorret",18],["varr",24]],"ety":{"text":"Gheg variant of varr.","tpl":[]},"rel":{"d":["vorraxhi"]}}],"ylldrita":[{"w":"Ylldrita","p":"PROPN","s":[{"g":"a female given nam