/// <reference types="node" />
/**
 * npx vite-node --config scripts/vite.config.ts scripts/ru-alphabet-deck.mts
 *
 * Writes the Russian rows of GoReview's Alphabet deck (packages/goreview/app/alphabetLetters.ts, `const RU`) from the Russian analyser's
 * own letter table (src/adapters/russian/alphabet.ts `alphabetDeckRows()`). The deck keeps a copy so that it does not pull the analyser
 * into GoReview's bundle; test/language-packs/russian.test.ts fails when the two differ: run this script again.
 */
import fs from 'node:fs';
import { alphabetDeckRows } from '../src/adapters/russian/alphabet';

const file = 'packages/goreview/app/alphabetLetters.ts';
const BS = String.fromCharCode(92);
const q = (x: string): string => `'${x.split(BS).join(BS + BS).split("'").join(BS + "'")}'`;
const rows = alphabetDeckRows().map(([a, b]) => `  [${q(a)}, ${q(b)}],`).join('\n');
const START = '// RU-LETTERS-START (generated by scripts/ru-alphabet-deck.mts; do not edit by hand)\n';
const END = '// RU-LETTERS-END\n';
const block = `${START}/**\n * Russian: the 33 letters of the Cyrillic alphabet as Russian uses it, in alphabet order: the Russian analyser's own letter table\n * (src/adapters/russian/alphabet.ts). Written for this deck, not reviewed by a native speaker.\n */\nconst RU: readonly LetterRow[] = [\n${rows}\n];\n${END}`;

let s = fs.readFileSync(file, 'utf8');
const anchor = '/** By language id. */\n';
if (s.includes(START)) s = s.slice(0, s.indexOf(START)) + block + s.slice(s.indexOf(END) + END.length);
else {
  if (!s.includes(anchor)) throw new Error('anchor not found');
  s = s.replace(anchor, `${block}\n${anchor}`);
}
if (!s.includes('ru: RU')) {
  if (!s.includes('arc: ARC };')) throw new Error('HAND_LETTERS not found');
  s = s.replace('arc: ARC };', 'arc: ARC, ru: RU };');
}
fs.writeFileSync(file, s);
console.log(`wrote ${alphabetDeckRows().length} Russian letters to ${file}`);
