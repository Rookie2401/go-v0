  "sentences": [
    {"text":"Juan tiene un libro.","tokens":["Juan","tiene","un","libro"],"heads":[1,-1,3,1],"relations":["nsubj","root","det","obj"]},
    {"text":"El libro es muy bueno.","tokens":["El","libro","es","muy","bueno"],"heads":[1,4,4,4,-1],"relations":["det","nsubj","cop","advmod","root"]},
