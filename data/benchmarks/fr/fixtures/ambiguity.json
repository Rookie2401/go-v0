    { "id": "amb-022", "sentence": "La tour est haute.", "target": "tour", "expect": { "lemma": "tour", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "la tour (the tower) is feminine" },
