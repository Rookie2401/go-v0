      ], "constructions": ["verb-final-subordinate", "konjunktiv-2"], "notConstructions": ["modal-particle"] },
    { "id": "r3-k08", "category": "native prose (Kafka)", "text": "Vom Pult hätte er fallen müssen!",
      "note": "hätte … fallen müssen: the perfect of a modal with the infinitive in place of the participle.",
