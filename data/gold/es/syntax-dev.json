    {"text":"Pedro, Rosa, Luis y Marta viven en una casa.","tokens":["Pedro","Rosa","Luis","y","Marta","viven","en","una","casa"],"heads":[5,0,0,4,0,-1,8,8,5],"relations":["nsubj","conj","conj","cc","conj","root","case","det","obl"]},
    {"text":"En la mesa hay pan, huevos y café.","tokens":["En","la","mesa","hay","pan","huevos","y","café"],"heads":[2,2,3,-1,3,4,7,4],"relations":["case","det","obl","root","obj","conj","cc","conj"]},
    {"text":"Sol corre y Luis corre también.","tokens":["Sol","corre","y","Luis","corre","también"],"heads":[1,-1,4,4,1,4],"relations":["nsubj","root","cc","nsubj","conj","advmod"]},
    {"text":"Marta quiere un perro como Sol.","tokens":["Marta","quiere","un","perro","como","Sol"],"heads":[1,-1,3,1,5,3],"relations":["nsubj","root","det","obj","case","nmod"]},
    {"text":"Lo buscó en la sala y en la cama.","tokens":["Lo","buscó","en","la","sala","y","en","la","cama"],"heads":[1,-1,4,4,1,8,8,8,4],"relations":["obj","root","case","det","obl","cc","case","det","conj"]},
    {"text":"Ana llegó a la casa de Juan.","tokens":["Ana","llegó","a","la","casa","de","Juan"],"heads":[1,-1,4,4,1,6,4],"relations":["nsubj","root","case","det","obl","case","nmod"]},
    {"text":"Tenían que comprar frutas y verduras para la semana.","tokens":["Tenían","que","comprar","frutas","y","verduras","para","la","semana"],"heads":[-1,2,0,2,5,3,8,8,2],"relations":["root","mark","xcomp","obj","cc","conj","case","det","obl"]},
    {"text":"Rosa pagó y dio las gracias.","tokens":["Rosa","pagó","y","dio","las","gracias"],"heads":[1,-1,3,1,5,3],"relations":["nsubj","root","cc","conj","det","obj"]},
    {"text":"Luis y Marta iban a ir al parque con Sol.","tokens":["Luis","y","Marta","iban","a","ir","al","parque","con","Sol"],"heads":[5,2,0,5,5,-1,7,5,9,5],"relations":["nsubj","cc","conj","aux","mark","root","case","obl","case","obl"]},
    {"text":"Pedro abrió la carta y la leyó.","tokens":["Pedro","abrió","la","carta","y","la","leyó"],"heads":[1,-1,3,1,6,6,1],"relations":["nsubj","root","det","obj","cc","obj","conj"]},
    {"text":"Marta limpió la mesa y Luis puso las sillas.","tokens":["Marta","limpió","la","mesa","y","Luis","puso","las","sillas"],"heads":[1,-1,3,1,6,6,1,8,6],"relations":["nsubj","root","det","obj","cc","nsubj","conj","det","obj"]},
    {"text":"Rosa hizo un pastel de chocolate.","tokens":["Rosa","hizo","un","pastel","de","chocolate"],"heads":[1,-1,3,1,5,3],"relations":["nsubj","root","det","obj","case","nmod"]},
    {"text":"—¿Es para mí? —preguntó Marta.","tokens":["Es","para","mí","preguntó","Marta"],"heads":[2,2,3,-1,3],"relations":["cop","case","ccomp","root","nsubj"]},
    {"text":"Salieron de la casa temprano.","tokens":["Salieron","de","la","casa","temprano"],"heads":[-1,3,3,0,0],"relations":["root","case","det","obl","advmod"]},
    {"text":"Por la ventana vieron montañas, ríos y vacas.","tokens":["Por","la","ventana","vieron","montañas","ríos","y","vacas"],"heads":[2,2,3,-1,3,4,7,4],"relations":["case","det","obl","root","obj","conj","cc","conj"]},
    {"text":"—Cuando yo era niña, vivía en esta misma casa.","tokens":["Cuando","yo","era","niña","vivía","en","esta","misma","casa"],"heads":[3,3,3,4,-1,8,8,8,4],"relations":["mark","nsubj","cop","advcl","root","case","det","amod","obl"]},
    {"text":"Marta dijo: —Me gusta tu historia.","tokens":["Marta","dijo","Me","gusta","tu","historia"],"heads":[1,-1,3,1,5,3],"relations":["nsubj","root","iobj","ccomp","det","nsubj"]},
    {"text":"Después había salido a trabajar.","tokens":["Después","había","salido","a","trabajar"],"heads":[2,2,-1,4,2],"relations":["advmod","aux","root","mark","advcl"]},
    {"text":"Aunque la familia era pobre, sus padres querían que ella estudiara.","tokens":["Aunque","la","familia","era","pobre","sus","padres","querían","que","ella","estudiara"],"heads":[4,2,4,4,7,6,7,-1,10,10,7],"relations":["mark","det","nsubj","cop","advcl","det","nsubj","root","mark","nsubj","ccomp"]},
    {"text":"Tomás decidió visitar a su hermano Pedro, al que no veía desde hacía tres años.","tokens":["Tomás","decidió","visitar","a","su","hermano","Pedro","al","que","no","veía","desde","hacía","tres","años"],"heads":[1,-1,1,5,5,2,5,8,10,10,5,12,10,14,12],"relations":["nsubj","root","xcomp","case","det","obj","appos","case","obj","advmod","acl","mark","advcl","nummod","obj"]},
    {"text":"El camino subía por las montañas, y por la ventana Tomás veía campos verdes y casas pequeñas.","tokens":["El","camino","subía","por","las","montañas","y","por","la","ventana","Tomás","veía","campos","verdes","y","casas","pequeñas"],"heads":[1,2,-1,5,5,2,11,9,9,11,11,2,11,12,15,12,15],"relations":["det","nsubj","root","case","det","obl","cc","case","det","obl","nsubj","conj","obj","amod","cc","conj","amod"]},
    {"text":"Pero cuando llegó a la ciudad, vio a su hermano en la estación, con una linterna en la mano.","tokens":["Pero","cuando","llegó","a","la","ciudad","vio","a","su","hermano","en","la","estación","con","una","linterna","en","la","mano"],"heads":[6,2,6,5,5,2,-1,9,9,6,12,12,6,15,15,6,18,18,15],"relations":["cc","mark","advcl","case","det","obl","root","case","det","obj","case","det","obl","case","det","obl","case","det","nmod"]},
    {"text":"El padre se lo dio, aunque le dolía mucho.","tokens":["El","padre","se","lo","dio","aunque","le","dolía","mucho"],"heads":[1,4,4,4,-1,7,7,4,7],"relations":["det","nsubj","iobj","obj","root","mark","iobj","advcl","advmod"]},
    {"text":"Al acercarse a la casa, oyó música y supo que había una fiesta.","tokens":["Al","acercarse","a","la","casa","oyó","música","y","supo","que","había","una","fiesta"],"heads":[1,5,4,4,1,-1,5,8,5,10,8,12,10],"relations":["mark","advcl","case","det","obl","root","obj","cc","conj","mark","ccomp","det","obj"]},
    {"text":"La historia no dice si el hijo mayor entró a la fiesta.","tokens":["La","historia","no","dice","si","el","hijo","mayor","entró","a","la","fiesta"],"heads":[1,3,3,-1,8,6,8,6,3,11,11,8],"relations":["det","nsubj","advmod","root","mark","det","nsubj","amod","ccomp","case","det","obl"]},
    {"text":"Los primeros días me perdí tres veces, y una señora tuvo que acompañarme hasta la casa.","tokens":["Los","primeros","días","me","perdí","tres","veces","y","una","señora","tuvo","que","acompañarme","hasta","la","casa"],"heads":[2,2,4,4,-1,6,4,10,9,10,4,12,10,15,15,12],"relations":["det","amod","obl","expl","root","nummod","obl","cc","det","nsubj","conj","mark","xcomp","case","det","obl"]},
    {"text":"No entiendo por qué Dios perdona el pecado.","tokens":["No","entiendo","por","qué","Dios","perdona","el","pecado"],"heads":[1,-1,3,5,5,1,7,5],"relations":["advmod","root","case","obl","nsubj","ccomp","det","obj"]},
    {"text":"Hay frutas, verduras, queso y tortillas.","tokens":["Hay","frutas","verduras","queso","y","tortillas"],"heads":[-1,0,1,1,5,1],"relations":["root","obj","conj","conj","cc","conj"]},
    {"text":"—Son cincuenta lempiras, señora —dice la vendedora.","tokens":["Son","cincuenta","lempiras","señora","dice","la","vendedora"],"heads":[2,2,4,2,-1,6,4],"relations":["cop","nummod","ccomp","vocative","root","det","nsubj"]},
    {"text":"Karla come la baleada y dice: —Está muy rica.","tokens":["Karla","come","la","baleada","y","dice","Está","muy","rica"],"heads":[1,-1,3,1,5,1,8,8,5],"relations":["nsubj","root","det","obj","cc","conj","cop","advmod","ccomp"]},
    {"text":"Los dos suben al autobús y buscan sus asientos.","tokens":["Los","dos","suben","al","autobús","y","buscan","sus","asientos"],"heads":[1,2,-1,4,2,6,2,8,6],"relations":["det","nsubj","root","case","obl","cc","conj","det","obj"]},
    {"text":"—Yo voy a ver a mi tío —dice Daniel.","tokens":["Yo","voy","a","ver","a","mi","tío","dice","Daniel"],"heads":[3,3,3,7,6,6,3,-1,7],"relations":["nsubj","aux","mark","ccomp","case","det","obj","root","nsubj"]},
    {"text":"Es domingo y la familia de Karla se levanta temprano.","tokens":["Es","domingo","y","la","familia","de","Karla","se","levanta","temprano"],"heads":[1,-1,8,4,8,6,4,8,1,8],"relations":["cop","root","cc","det","nsubj","case","nmod","expl","conj","advmod"]},
    {"text":"En la casa de doña Reina, todos ayudan con la comida.","tokens":["En","la","casa","de","doña","Reina","todos","ayudan","con","la","comida"],"heads":[2,2,7,4,2,4,7,-1,10,10,7],"relations":["case","det","obl","case","nmod","flat","nsubj","root","case","det","obl"]},
    {"text":"Karla sirve jugo de naranja a todos.","tokens":["Karla","sirve","jugo","de","naranja","a","todos"],"heads":[1,-1,1,4,2,6,1],"relations":["nsubj","root","obj","case","nmod","case","iobj"]},
    {"text":"Yo no creía en Dios.","tokens":["Yo","no","creía","en","Dios"],"heads":[2,2,-1,4,2],"relations":["nsubj","advmod","root","case","obl"]},
    {"text":"Un día Sol salió de la casa y no volvió.","tokens":["Un","día","Sol","salió","de","la","casa","y","no","volvió"],"heads":[1,3,3,-1,6,6,3,9,9,3],"relations":["det","obl","nsubj","root","case","det","obl","cc","advmod","conj"]},
    {"text":"Luis compró globos y los puso en la sala.","tokens":["Luis","compró","globos","y","los","puso","en","la","sala"],"heads":[1,-1,1,5,5,1,8,8,5],"relations":["nsubj","root","obj","cc","obj","conj","case","det","obl"]},
    {"text":"Por la tarde ayudaba a mi madre a hacer tortillas.","tokens":["Por","la","tarde","ayudaba","a","mi","madre","a","hacer","tortillas"],"heads":[2,2,3,-1,6,6,3,8,3,8],"relations":["case","det","obl","root","case","det","obj","mark","xcomp","obj"]},
    {"text":"—Mañana les voy a enseñar a hacer tortillas —dijo la abuela.","tokens":["Mañana","les","voy","a","enseñar","a","hacer","tortillas","dijo","la","abuela"],"heads":[4,4,4,4,8,6,4,6,-1,10,8],"relations":["advmod","iobj","aux","mark","ccomp","mark","xcomp","obj","root","det","nsubj"]},
    {"text":"Juan se sentó e intentó recordar lo que había hecho esa mañana.","tokens":["Juan","se","sentó","e","intentó","recordar","lo","que","había","hecho","esa","mañana"],"heads":[2,2,-1,4,2,4,5,9,9,6,11,9],"relations":["nsubj","expl","root","cc","conj","xcomp","obj","obj","aux","acl","det","obl"]},
    {"text":"Cuando tenía quince años, su maestro le dijo que ella también podía ser maestra.","tokens":["Cuando","tenía","quince","años","su","maestro","le","dijo","que","ella","también","podía","ser","maestra"],"heads":[1,7,3,1,5,7,7,-1,11,11,11,7,13,11],"relations":["mark","advcl","nummod","obj","det","nsubj","iobj","root","mark","nsubj","advmod","ccomp","cop","xcomp"]},
    {"text":"Hoy Elena tiene setenta años y ya no enseña, pero muchos de sus alumnos han llegado a ser maestros, enfermeros y agricultores.","tokens":["Hoy","Elena","tiene","setenta","años","y","ya","no","enseña","pero","muchos","de","sus","alumnos","han","llegado","a","ser","maestros","enfermeros","y","agricultores"],"heads":[2,2,-1,4,2,8,8,8,2,15,15,13,13,10,15,2,18,18,15,18,21,18],"relations":["advmod","nsubj","root","nummod","obj","cc","advmod","advmod","conj","cc","nsubj","case","det","nmod","aux","conj","mark","cop","xcomp","conj","cc","conj"]},
    {"text":"Los hombres bajaron para ayudar al conductor a moverlo.","tokens":["Los","hombres","bajaron","para","ayudar","al","conductor","a","moverlo"],"heads":[1,2,-1,4,2,6,4,8,4],"relations":["det","nsubj","root","mark","advcl","case","obj","mark","xcomp"]},
    {"text":"Allí gastó el dinero en fiestas y en cosas que no necesitaba.","tokens":["Allí","gastó","el","dinero","en","fiestas","y","en","cosas","que","no","necesitaba"],"heads":[1,-1,3,1,5,1,8,8,5,11,11,8],"relations":["advmod","root","det","obj","case","obl","cc","case","conj","obj","advmod","acl"]},
    {"text":"El hijo empezó a decir lo que había preparado, pero su padre no lo dejó terminar.","tokens":["El","hijo","empezó","a","decir","lo","que","había","preparado","pero","su","padre","no","lo","dejó","terminar"],"heads":[1,2,-1,4,2,4,8,8,5,14,11,14,14,14,2,14],"relations":["det","nsubj","root","mark","xcomp","obj","obj","aux","acl","cc","det","nsubj","advmod","obj","conj","xcomp"]},
    {"text":"Preguntó qué pasaba, y un criado le dijo que su hermano había vuelto.","tokens":["Preguntó","qué","pasaba","y","un","criado","le","dijo","que","su","hermano","había","vuelto"],"heads":[-1,2,0,7,5,7,7,0,12,10,12,12,7],"relations":["root","nsubj","ccomp","cc","det","nsubj","iobj","conj","mark","det","nsubj","aux","ccomp"]},
    {"text":"Pedro contó el dinero y dijo: —Marta, ya has ahorrado la mitad.","tokens":["Pedro","contó","el","dinero","y","dijo","Marta","ya","has","ahorrado","la","mitad"],"heads":[1,-1,3,1,5,1,9,9,9,5,11,9],"relations":["nsubj","root","det","obj","cc","conj","vocative","advmod","aux","ccomp","det","obj"]},
    {"text":"Es sábado por la mañana en Tegucigalpa, la capital de Honduras.","tokens":["Es","sábado","por","la","mañana","en","Tegucigalpa","la","capital","de","Honduras"],"heads":[1,-1,4,4,1,6,1,8,6,10,8],"relations":["cop","root","case","det","obl","case","obl","det","appos","case","nmod"]},
    {"text":"Una baleada es una tortilla de harina con frijoles.","tokens":["Una","baleada","es","una","tortilla","de","harina","con","frijoles"],"heads":[1,4,4,4,-1,6,4,8,4],"relations":["det","nsubj","cop","det","root","case","nmod","case","nmod"]},
    {"text":"Al salir, pasan por la pulpería de la esquina.","tokens":["Al","salir","pasan","por","la","pulpería","de","la","esquina"],"heads":[1,2,-1,5,5,2,8,8,5],"relations":["mark","advcl","root","case","det","obl","case","det","nmod"]},
    {"text":"Los amigos hablan, miran por la ventana y comen algo.","tokens":["Los","amigos","hablan","miran","por","la","ventana","y","comen","algo"],"heads":[1,2,-1,2,6,6,3,8,2,8],"relations":["det","nsubj","root","conj","case","det","obl","cc","conj","obj"]},
    {"text":"Mi hermano compró una casa nueva en la ciudad.","tokens":["Mi","hermano","compró","una","casa","nueva","en","la","ciudad"],"heads":[1,2,-1,4,2,4,8,8,2],"relations":["det","nsubj","root","det","obj","amod","case","det","obl"]},
    {"text":"Los estudiantes leen libros interesantes todos los días.","tokens":["Los","estudiantes","leen","libros","interesantes","todos","los","días"],"heads":[1,2,-1,2,3,7,7,2],"relations":["det","nsubj","root","obj","amod","det","det","obl"]},
    {"text":"Ella siempre me dice la verdad.","tokens":["Ella","siempre","me","dice","la","verdad"],"heads":[3,3,3,-1,5,3],"relations":["nsubj","advmod","iobj","root","det","obj"]},
    {"text":"Quiero que vengas a mi fiesta el sábado.","tokens":["Quiero","que","vengas","a","mi","fiesta","el","sábado"],"heads":[-1,2,0,5,5,2,7,2],"relations":["root","mark","ccomp","case","det","obl","det","obl"]},
    {"text":"Si llueve mañana, no saldremos de casa.","tokens":["Si","llueve","mañana","no","saldremos","de","casa"],"heads":[1,4,1,4,-1,6,4],"relations":["mark","advcl","advmod","advmod","root","case","obl"]},
    {"text":"Ayer vi a tu hermana en el mercado.","tokens":["Ayer","vi","a","tu","hermana","en","el","mercado"],"heads":[1,-1,4,4,1,7,7,1],"relations":["advmod","root","case","det","obj","case","det","obl"]},
    {"text":"El profesor explicó la lección a los alumnos.","tokens":["El","profesor","explicó","la","lección","a","los","alumnos"],"heads":[1,2,-1,4,2,7,7,2],"relations":["det","nsubj","root","det","obj","case","det","iobj"]},
    {"text":"Mis padres viven en una ciudad pequeña y tranquila.","tokens":["Mis","padres","viven","en","una","ciudad","pequeña","y","tranquila"],"heads":[1,2,-1,5,5,2,5,8,6],"relations":["det","nsubj","root","case","det","obl","amod","cc","conj"]},
    {"text":"Estoy leyendo un libro sobre la historia de España.","tokens":["Estoy","leyendo","un","libro","sobre","la","historia","de","España"],"heads":[1,-1,3,1,6,6,3,8,6],"relations":["aux","root","det","obj","case","det","nmod","case","nmod"]},
    {"text":"Ellos han vivido aquí durante muchos años.","tokens":["Ellos","han","vivido","aquí","durante","muchos","años"],"heads":[2,2,-1,2,6,6,2],"relations":["nsubj","aux","root","advmod","case","det","obl"]},
    {"text":"No sé dónde dejé las llaves.","tokens":["No","sé","dónde","dejé","las","llaves"],"heads":[1,-1,3,1,5,3],"relations":["advmod","root","advmod","ccomp","det","obj"]},
    {"text":"Los niños que juegan en el parque son mis vecinos.","tokens":["Los","niños","que","juegan","en","el","parque","son","mis","vecinos"],"heads":[1,9,3,1,6,6,3,9,9,-1],"relations":["det","nsubj","nsubj","acl","case","det","obl","cop","det","root"]},
    {"text":"La casa donde nací está muy lejos de aquí.","tokens":["La","casa","donde","nací","está","muy","lejos","de","aquí"],"heads":[1,6,3,1,6,6,-1,8,6],"relations":["det","nsubj","advmod","acl","cop","advmod","root","case","obl"]},
    {"text":"Tengo que trabajar mañana por la mañana.","tokens":["Tengo","que","trabajar","mañana","por","la","mañana"],"heads":[-1,2,0,2,6,6,2],"relations":["root","mark","xcomp","advmod","case","det","obl"]},
    {"text":"Mi madre y mi tía cocinan juntas los domingos.","tokens":["Mi","madre","y","mi","tía","cocinan","juntas","los","domingos"],"heads":[1,5,4,4,1,-1,5,8,5],"relations":["det","nsubj","cc","det","conj","root","advmod","det","obl"]},
    {"text":"Cuando era niño, vivía en un pueblo pequeño.","tokens":["Cuando","era","niño","vivía","en","un","pueblo","pequeño"],"heads":[2,2,3,-1,6,6,3,6],"relations":["mark","cop","advcl","root","case","det","obl","amod"]},
    {"text":"Me gustan los libros de aventuras.","tokens":["Me","gustan","los","libros","de","aventuras"],"heads":[1,-1,3,1,5,3],"relations":["iobj","root","det","nsubj","case","nmod"]},
    {"text":"El perro de mi vecino ladra toda la noche.","tokens":["El","perro","de","mi","vecino","ladra","toda","la","noche"],"heads":[1,5,4,4,1,-1,8,8,5],"relations":["det","nsubj","case","det","nmod","root","det","det","obl"]},
    {"text":"Dime la verdad, por favor.","tokens":["Dime","la","verdad","por","favor"],"heads":[-1,2,0,4,0],"relations":["root","det","obj","case","obl"]},
    {"text":"Juan quiere comprar un coche, pero no tiene dinero.","tokens":["Juan","quiere","comprar","un","coche","pero","no","tiene","dinero"],"heads":[1,-1,1,4,2,7,7,1,7],"relations":["nsubj","root","xcomp","det","obj","cc","advmod","conj","obj"]},
    {"text":"Ana está cansada porque trabajó todo el día.","tokens":["Ana","está","cansada","porque","trabajó","todo","el","día"],"heads":[2,2,-1,4,2,7,7,4],"relations":["nsubj","cop","root","mark","advcl","det","det","obl"]},
    {"text":"Nos vamos a la playa el próximo fin de semana.","tokens":["Nos","vamos","a","la","playa","el","próximo","fin","de","semana"],"heads":[1,-1,4,4,1,7,7,1,9,7],"relations":["expl","root","case","det","obl","det","amod","obl","case","nmod"]},
    {"text":"Mi hermano menor estudia medicina en la universidad.","tokens":["Mi","hermano","menor","estudia","medicina","en","la","universidad"],"heads":[1,3,1,-1,3,7,7,3],"relations":["det","nsubj","amod","root","obj","case","det","obl"]},
    {"text":"La profesora nos dio un examen muy difícil.","tokens":["La","profesora","nos","dio","un","examen","muy","difícil"],"heads":[1,3,3,-1,5,3,7,5],"relations":["det","nsubj","iobj","root","det","obj","advmod","amod"]},
    {"text":"Creo que tienes razón.","tokens":["Creo","que","tienes","razón"],"heads":[-1,2,0,2],"relations":["root","mark","ccomp","obj"]},
