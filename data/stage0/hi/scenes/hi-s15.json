      "picture": "👨🏫",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l6",
      "text": "रविवार को हम दस बजे चर्च जाते हैं।",
      "en": "On Sunday we go to church at ten.",
      "speaker": "sam",
      "picture": "⛪🕙",
