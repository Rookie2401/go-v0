      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Es una semana buena para el equipo.",
              "english": "It is a good week for the team."
            },
            {
              "text": "El pastor Jorge tiene que escribir un mensaje.",
              "english": "Pastor Jorge has to write a message."
            },
