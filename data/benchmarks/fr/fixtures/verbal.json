    { "id": "verb-061", "sentence": "Il aurait un chat.", "target": "aurait", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Mood": "Cnd" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "avoir conditionnel" },
    { "id": "verb-062", "sentence": "Il faut qu'il ait un chat.", "target": "ait", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Mood": "Sub", "Person": "3" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "avoir subjunctive" },
    { "id": "verb-063", "sentence": "Ayez du courage !", "target": "Ayez", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Mood": "Imp", "Person": "2", "Number": "Plur" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "imperative of avoir" },
    { "id": "verb-064", "sentence": "Ayant faim, il mange.", "target": "Ayant", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Pres" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "present participle of avoir" },
    { "id": "verb-065", "sentence": "Je vais au marché.", "target": "vais", "expect": { "lemma": "aller", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "1", "Number": "Sing" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "aller present, first person (suppletive stem)" },
    { "id": "verb-066", "sentence": "Nous allons à Paris.", "target": "allons", "expect": { "lemma": "aller", "pos": "VERB", "features": { "Person": "1", "Number": "Plur" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "aller first person plural" },
