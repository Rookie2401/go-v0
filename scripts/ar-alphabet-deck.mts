/// <reference types="node" />
/**
 * npx vite-node --config scripts/vite.config.ts scripts/ar-alphabet-deck.mts
 *
 * Writes the Arabic rows of GoReview's Alphabet deck (packages/goreview/app/alphabetLetters.ts, `const AR`) from the Arabic analyser's
 * own letter table (src/adapters/arabic/alphabet.ts `AR_ALPHABET`). The deck keeps a copy so that it does not pull the analyser into
 * GoReview's bundle; test/goreview-app/alphabet-deck.test.ts fails when the two differ: run this script again.
 * The glyph is the bare letter (the key of the card); the back says the name, the sound, the transliteration, the dots and the shapes.
 */
import fs from 'node:fs';
import { AR_ALPHABET } from '../src/adapters/arabic/alphabet';

const file = 'packages/goreview/app/alphabetLetters.ts';
const BS = String.fromCharCode(92);
const q = (x: string): string => `'${x.split(BS).join(BS + BS).split("'").join(BS + "'")}'`;
/** The name and the sound first (as every language's card), then what fits in the deck's 140 characters: the transliteration, the dots. */
const back = (l: (typeof AR_ALPHABET)[number]): string => {
  let out = `${l.name} (${l.nameTranslit}): ${l.sound}`;
  for (const extra of [`transliterated ${l.translit}`, l.dots === 'none' ? '' : l.dots]) if (extra && `${out} · ${extra}`.length <= 140) out += ` · ${extra}`;
  return out;
};
const rows = AR_ALPHABET.map((l) => `  [${q(l.letter)}, ${q(back(l))}],`).join('\n');
const START = '// AR-LETTERS-START (generated by scripts/ar-alphabet-deck.mts; do not edit by hand)\n';
const END = '// AR-LETTERS-END\n';
const block = `${START}/**\n * Arabic: the 28 letters in alphabet order: the Arabic analyser's own letter table (src/adapters/arabic/alphabet.ts), the card's key the bare letter.\n * Written for this deck, not reviewed by a native speaker or an Arabist; the sounds are approximations for an English speaker.\n */\nconst AR: readonly LetterRow[] = [\n${rows}\n];\n${END}`;

let s = fs.readFileSync(file, 'utf8');
const anchor = '/** By language id. */\n';
if (s.includes(START)) s = s.slice(0, s.indexOf(START)) + block + s.slice(s.indexOf(END) + END.length);
else {
  if (!s.includes(anchor)) throw new Error('anchor not found');
  s = s.replace(anchor, `${block}\n${anchor}`);
}
if (!s.includes('ar: AR')) {
  if (!s.includes('fr: FR_ALPHABET_ROWS };')) throw new Error('HAND_LETTERS not found');
  s = s.replace('fr: FR_ALPHABET_ROWS };', 'fr: FR_ALPHABET_ROWS, ar: AR };');
}
fs.writeFileSync(file, s);
console.log(`wrote ${AR_ALPHABET.length} Arabic letters to ${file}`);
