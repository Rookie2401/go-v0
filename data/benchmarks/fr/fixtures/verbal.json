    { "id": "verb-075", "sentence": "Ils font un gâteau.", "target": "font", "expect": { "lemma": "faire", "pos": "VERB", "features": { "Person": "3", "Number": "Plur" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "faire third person plural" },
