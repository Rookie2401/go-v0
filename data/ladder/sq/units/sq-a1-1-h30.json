      "title": "Te Ana",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Mira dhe Dritani vijnë te Ana dhe Luan.",
              "english": "Mira and Dritan come to Ana and Luan's."
            },
            {
              "text": "— Mirë se vini! Hyni, ju lutem.",
              "english": "\"Welcome! Come in, please.\""
            },
            {
              "text": "— Faleminderit, Ana.",
              "english": "\"Thank you, Ana.\""
            },
            {
              "text": "— Uluni. A doni kafe?",
              "english": "\"Sit down. Do you want coffee?\""
            },
            {
              "text": "— Unë dua kafe, — thotë Dritani.",
              "english": "\"I want coffee,\" says Dritan."
            },
            {
              "text": "— Unë dua çaj, — thotë Mira.",
              "english": "\"I want tea,\" says Mira."
            },
            {
              "text": "Luan sjell kafe dhe çaj.",
              "english": "Luan brings coffee and tea."
            },
            {
              "text": "— Ku janë fëmijët? — pyet Ana.",
              "english": "\"Where are the children?\" asks Ana."
            },
            {
              "text": "— Janë me gjyshen.",
              "english": "\"They are with their grandmother.\""
            },
            {
              "text": "— Shumë mirë.",
              "english": "\"Very good.\""
            },
            {
              "text": "Ata pinë kafe dhe çaj.",
              "english": "They drink coffee and tea."
            },
            {
              "text": "Ata flasin shumë dhe janë të lumtur.",
              "english": "They talk a lot and are happy."
            }
          ]
        }
      ]
    }
