    { "id": "r3-k03", "category": "native prose (Kafka)", "text": "»Was ist mit mir geschehen?« dachte er.",
      "tokens": [
        { "form": "ist", "lemma": "sein", "pos": "AUX" },
        { "form": "geschehen", "lemma": "geschehen", "pos": "VERB", "morph": { "VerbForm": "Part", "Tense": "Past" } },
