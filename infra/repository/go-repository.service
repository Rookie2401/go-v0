[Unit]
Description=Go Repository account sync service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=go-repository
Group=go-repository
WorkingDirectory=/opt/go-v0
Environment=NODE_ENV=production
# Settings and secrets (DATABASE_URL, SMTP_URL, METRICS_TOKEN, TRUST_PROXY, ...): infra/repository/go-repository.env.example. The dash: start without the file.
EnvironmentFile=-/etc/go-repository/env
ExecStart=/opt/go-v0/node_modules/.bin/vite-node --config server/goread/vite.config.ts packages/repository-service/src/main.ts --port 8790 --host 127.0.0.1 --data /var/lib/go-repository
Restart=on-failure
RestartSec=3
# held /sync/wait requests are answered at once on SIGTERM; give the rest a moment
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/go-repository

[Install]
WantedBy=multi-user.target
