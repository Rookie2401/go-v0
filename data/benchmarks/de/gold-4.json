        { "form": "dich", "pos": "PRON", "morph": { "Case": "Acc" } }
      ], "constructions": ["separable-prefix-verb", "imperative"] },
    { "id": "r4-09", "category": "native prose (Kafka)", "text": "Aber weiterhin wurde es schwierig, besonders weil er so ungemein breit war.",
