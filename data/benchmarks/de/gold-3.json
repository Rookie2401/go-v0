        { "form": "mir", "pos": "PRON", "morph": { "Case": "Dat" } }
      ], "constructions": ["sentence-bracket-perfect"] },
    { "id": "r3-k04", "category": "native prose (Kafka)", "text": "Der Mensch muß seinen Schlaf haben.",
      "tokens": [
        { "form": "muß", "lemma": "müssen", "pos": "AUX", "orthography": { "modern": "muss", "period": "de-1901" } },
