    { "id": "verb-057", "sentence": "Vous avez un chat.", "target": "avez", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Person": "2", "Number": "Plur" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "avoir second person plural" },
