{
  "category": "verbal",
  "note": "Simple tenses and moods of regular verbs, spelling-change verbs and the irregular verbs. Features listed are the certain ones; where one written form has several readings (parle: 1st or 3rd person, indicative or subjunctive) only a feature true of the sentence's reading is asserted, and it is judged on the analyser's first reading of that lemma. An AI's judgement, not native-reviewed.",
  "cases": [
    { "id": "verb-001", "sentence": "Je parle français.", "target": "parle", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "regular -er, present, first person singular" },
    { "id": "verb-002", "sentence": "Tu parles trop.", "target": "parles", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "2", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "-es is second person singular" },
    { "id": "verb-003", "sentence": "Elle parle bien.", "target": "parle", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "-e is also the third person singular" },
    { "id": "verb-004", "sentence": "Nous parlons ensemble.", "target": "parlons", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Tense": "Pres", "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-ons is first person plural" },
    { "id": "verb-005", "sentence": "Vous parlez trop.", "target": "parlez", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Person": "2", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-ez is second person plural" },
    { "id": "verb-006", "sentence": "Ils parlent bas.", "target": "parlent", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Person": "3", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-ent is third person plural" },
    { "id": "verb-007", "sentence": "Je parlais souvent.", "target": "parlais", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Imp", "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "imparfait, first person singular" },
    { "id": "verb-008", "sentence": "Nous parlions souvent.", "target": "parlions", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Imp", "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "imparfait, first person plural" },
    { "id": "verb-009", "sentence": "Il parlera demain.", "target": "parlera", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Fut", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "futur simple" },
    { "id": "verb-010", "sentence": "Je parlerais volontiers.", "target": "parlerais", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Cnd", "Tense": "Pres", "Person": "1" } }, "source": "kaikki", "level": "core", "why": "conditionnel is Mood Cnd, Tense Pres" },
    { "id": "verb-011", "sentence": "Il faut que tu parles.", "target": "parles", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Sub", "Person": "2" } }, "source": "kaikki", "level": "advanced", "why": "after il faut que the same form as the indicative is a subjunctive; needs the context" },
    { "id": "verb-012", "sentence": "Parlez doucement !", "target": "Parlez", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Imp", "Person": "2", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "imperative at the start of an exclamation" },
    { "id": "verb-013", "sentence": "Il aime parler.", "target": "parler", "expect": { "lemma": "parler", "pos": "VERB", "features": { "VerbForm": "Inf" } }, "source": "kaikki", "level": "core", "why": "infinitive after a verb" },
    { "id": "verb-014", "sentence": "En parlant, il rit.", "target": "parlant", "expect": { "lemma": "parler", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Pres" } }, "source": "kaikki", "level": "core", "why": "present participle (gérondif after en)" },
    { "id": "verb-015", "sentence": "Nous finissons le travail.", "target": "finissons", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "second group with -iss-" },
    { "id": "verb-016", "sentence": "Je finis tôt.", "target": "finis", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Tense": "Pres", "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "-is: first person singular (the second is the same form)" },
    { "id": "verb-017", "sentence": "Ils finissent tard.", "target": "finissent", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Person": "3", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "second group, third plural" },
    { "id": "verb-018", "sentence": "Elle finissait toujours la première.", "target": "finissait", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Tense": "Imp", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "second group imparfait" },
    { "id": "verb-019", "sentence": "Il finira bientôt.", "target": "finira", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Tense": "Fut", "Person": "3" } }, "source": "kaikki", "level": "core", "why": "second group futur" },
    { "id": "verb-020", "sentence": "Il faut que je finisse tôt.", "target": "finisse", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Mood": "Sub", "Person": "1" } }, "source": "kaikki", "level": "advanced", "why": "second group subjunctive after il faut que" },
    { "id": "verb-021", "sentence": "Je vends ma voiture.", "target": "vends", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "-re verb, first person singular" },
    { "id": "verb-022", "sentence": "Il vend du pain.", "target": "vend", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "-re verb, third person singular has no ending" },
    { "id": "verb-023", "sentence": "Nous vendons des fruits.", "target": "vendons", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-re verb, first person plural" },
    { "id": "verb-024", "sentence": "Ils vendaient du pain.", "target": "vendaient", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "Tense": "Imp", "Person": "3", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-re verb, imparfait" },
    { "id": "verb-025", "sentence": "Il vendra sa maison.", "target": "vendra", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "Tense": "Fut", "Person": "3" } }, "source": "kaikki", "level": "core", "why": "-re verb, futur drops the e" },
    { "id": "verb-026", "sentence": "Je vendrais ma maison.", "target": "vendrais", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "Mood": "Cnd" } }, "source": "kaikki", "level": "core", "why": "-re verb, conditionnel" },
    { "id": "verb-027", "sentence": "Nous mangeons du pain.", "target": "mangeons", "expect": { "lemma": "manger", "pos": "VERB", "features": { "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "spelling change: g keeps its soft sound before o with a silent e" },
    { "id": "verb-028", "sentence": "Il mangeait du pain.", "target": "mangeait", "expect": { "lemma": "manger", "pos": "VERB", "features": { "Tense": "Imp", "Person": "3" } }, "source": "kaikki", "level": "core", "why": "spelling change before a in the imparfait" },
    { "id": "verb-029", "sentence": "Nous plaçons le livre ici.", "target": "plaçons", "expect": { "lemma": "placer", "pos": "VERB", "features": { "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "spelling change: c becomes ç before o" },
    { "id": "verb-030", "sentence": "Il appelle son frère.", "target": "appelle", "expect": { "lemma": "appeler", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "spelling change: l doubles before a silent e" },
    { "id": "verb-031", "sentence": "Il appellera demain.", "target": "appellera", "expect": { "lemma": "appeler", "pos": "VERB", "features": { "Tense": "Fut", "Person": "3" } }, "source": "kaikki", "level": "core", "why": "the doubled l continues in the futur" },
    { "id": "verb-032", "sentence": "Il achète du pain.", "target": "achète", "expect": { "lemma": "acheter", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "spelling change: e becomes è before a silent e" },
    { "id": "verb-033", "sentence": "Il achètera du pain.", "target": "achètera", "expect": { "lemma": "acheter", "pos": "VERB", "features": { "Tense": "Fut", "Person": "3" } }, "source": "kaikki", "level": "core", "why": "the è of acheter continues in the futur" },
    { "id": "verb-034", "sentence": "Je cède ma place.", "target": "cède", "expect": { "lemma": "céder", "pos": "VERB", "features": { "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "spelling change: é becomes è before a silent e" },
    { "id": "verb-035", "sentence": "Nous cédons la place.", "target": "cédons", "expect": { "lemma": "céder", "pos": "VERB", "features": { "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "the é stays before a sounded ending" },
    { "id": "verb-036", "sentence": "Il emploie dix personnes.", "target": "emploie", "expect": { "lemma": "employer", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "spelling change: y becomes i before a silent e" },
    { "id": "verb-037", "sentence": "Il emploiera dix personnes.", "target": "emploiera", "expect": { "lemma": "employer", "pos": "VERB", "features": { "Tense": "Fut" } }, "source": "kaikki", "level": "core", "why": "y becomes i in the futur" },
    { "id": "verb-038", "sentence": "Il paie son loyer.", "target": "paie", "expect": { "lemma": "payer", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3" } }, "source": "kaikki", "level": "core", "why": "payer has two present spellings, paie and paye" },
    { "id": "verb-039", "sentence": "J'enverrai la lettre demain.", "target": "enverrai", "expect": { "lemma": "envoyer", "pos": "VERB", "features": { "Tense": "Fut", "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "envoyer has an irregular futur stem enverr-" },
    { "id": "verb-040", "sentence": "Il jette la balle.", "target": "jette", "expect": { "lemma": "jeter", "pos": "VERB", "features": { "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "spelling change: t doubles before a silent e" },
    { "id": "verb-041", "sentence": "Nous nettoyons la table.", "target": "nettoyons", "expect": { "lemma": "nettoyer", "pos": "VERB", "features": { "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "the y stays before a sounded ending" },
    { "id": "verb-042", "sentence": "Je suis grand.", "target": "suis", "expect": { "lemma": "être", "pos": "AUX", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "1", "Number": "Sing" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être, present, first person; before an adjective it is être, not suivre" },
    { "id": "verb-043", "sentence": "Tu es grand.", "target": "es", "expect": { "lemma": "être", "pos": "AUX", "features": { "Person": "2", "Number": "Sing" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être second person singular" },
    { "id": "verb-044", "sentence": "Il est grand.", "target": "est", "expect": { "lemma": "être", "pos": "AUX", "features": { "Person": "3", "Number": "Sing" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être third person singular" },
    { "id": "verb-045", "sentence": "Nous sommes grands.", "target": "sommes", "expect": { "lemma": "être", "pos": "AUX", "features": { "Person": "1", "Number": "Plur" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être first person plural" },
    { "id": "verb-046", "sentence": "Vous êtes grands.", "target": "êtes", "expect": { "lemma": "être", "pos": "AUX", "features": { "Person": "2", "Number": "Plur" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être second person plural" },
    { "id": "verb-047", "sentence": "Ils sont grands.", "target": "sont", "expect": { "lemma": "être", "pos": "AUX", "features": { "Person": "3", "Number": "Plur" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être third person plural" },
    { "id": "verb-048", "sentence": "J'étais petit.", "target": "étais", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Imp", "Person": "1" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être imparfait" },
    { "id": "verb-049", "sentence": "Il sera grand.", "target": "sera", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Fut", "Person": "3" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être futur" },
    { "id": "verb-050", "sentence": "Je serais content.", "target": "serais", "expect": { "lemma": "être", "pos": "AUX", "features": { "Mood": "Cnd" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "être conditionnel" },
    { "id": "verb-051", "sentence": "Il faut qu'il soit content.", "target": "soit", "expect": { "lemma": "être", "pos": "AUX", "features": { "Mood": "Sub", "Person": "3" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "advanced", "why": "soit after il faut que is the subjunctive of être (the same word is also a conjunction)" },
    { "id": "verb-052", "sentence": "Sois sage !", "target": "Sois", "expect": { "lemma": "être", "pos": "AUX", "features": { "Mood": "Imp", "Person": "2", "Number": "Sing" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "imperative of être" },
    { "id": "verb-053", "sentence": "Étant malade, il dort.", "target": "Étant", "expect": { "lemma": "être", "pos": "AUX", "features": { "VerbForm": "Part", "Tense": "Pres" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "present participle of être" },
    { "id": "verb-054", "sentence": "J'ai un chat.", "target": "ai", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "1", "Number": "Sing" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "avoir as a main verb, first person" },
