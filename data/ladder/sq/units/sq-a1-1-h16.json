        {
          "sentences": [
            {
              "text": "— Mirëdita, Drita!",
              "english": "\"Good afternoon, Drita!\""
            },
            {
              "text": "— Mirëdita, Sam! A do kafe?",
              "english": "\"Good afternoon, Sam! Do you want coffee?\""
            },
            {
              "text": "— Po, faleminderit.",
              "english": "\"Yes, thank you.\""
            },
            {
              "text": "— Ja kafeja. A do qumësht?",
              "english": "\"Here is the coffee. Do you want milk?\""
            },
            {
              "text": "— Jo, faleminderit.",
              "english": "\"No, thank you.\""
            },
            {
              "text": "— Ky është qeni im.",
              "english": "\"This is my dog.\""
            },
            {
              "text": "— Qeni është shumë i madh!",
              "english": "\"The dog is very big!\""
            },
            {
              "text": "— Po. Dhe ja macja e Ardit.",
              "english": "\"Yes. And here is Ardi's cat.\""
            },
            {
              "text": "— Ku është Ardi?",
              "english": "\"Where is Ardi?\""
            },
            {
              "text": "— Ardi është në shkollë.",
              "english": "\"Ardi is at school.\""
            },
            {
              "text": "— Macja është shumë e bukur.",
              "english": "\"The cat is very beautiful.\""
            },
            {
              "text": "— Po. Ardit i pëlqen shumë.",
              "english": "\"Yes. Ardi likes it very much.\""
            }
          ]
        }
      ]
