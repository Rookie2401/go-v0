/// <reference types="node" />
/**
 * npx vite-node --config scripts/vite.config.ts scripts/ru-pack-grammar.mts
 *
 * Writes packages/language-packs/src/packs/ru-grammar.ts: the Russian pack's grammar tables (the features and the sentence patterns the
 * card explains) as plain data. They are WRITTEN in the analyser (src/adapters/russian/tags.ts `RU_FEATURES`, constructions.ts
 * `RU_CONSTRUCTIONS`), where the code that produces those features and patterns lives; the pack manifest must not import the analyser
 * (every manifest is linked into the extension's background worker, which must not carry an analyser), so it reads this copy.
 * test/language-packs/russian.test.ts fails when the copy and the analyser's tables differ: run this script again.
 */
import fs from 'node:fs';
import path from 'node:path';
import { RU_FEATURES } from '../src/adapters/russian/tags';
import { RU_CONSTRUCTIONS } from '../src/adapters/russian/constructions';

const out = path.join(process.cwd(), 'packages/language-packs/src/packs/ru-grammar.ts');
const q = (s: string): string => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
const values = (v: Record<string, string>): string => `{ ${Object.entries(v).map(([k, x]) => `${/^[A-Za-z_]\w*$/.test(k) ? k : q(k)}: ${q(x)}`).join(', ')} }`;

const lines: string[] = [
  '/* GENERATED by scripts/ru-pack-grammar.mts from src/adapters/russian/tags.ts (RU_FEATURES) and constructions.ts (RU_CONSTRUCTIONS).',
  ' * Do not edit: change the analyser\'s table and run the script. Machine-drafted; not reviewed by a native speaker or a Russianist. */',
  "import type { GrammarConstruction, GrammarFeature } from '../manifest';",
  '',
  'export const RU_GRAMMAR_FEATURES: GrammarFeature[] = [',
  ...RU_FEATURES.map((f) => `  { key: ${q(f.key)}, label: ${q(f.label)}, values: ${values(f.values)}, explain: ${q(f.explain)} },`),
  '];',
  '',
  'export const RU_GRAMMAR_CONSTRUCTIONS: GrammarConstruction[] = [',
  ...RU_CONSTRUCTIONS.map((c) => `  { id: ${q(c.id)}, label: ${q(c.label)}, explain: ${q(c.explain)} },`),
  '];',
  '',
];
fs.writeFileSync(out, lines.join('\n'));
console.log(`wrote ${path.relative(process.cwd(), out)}: ${RU_FEATURES.length} features, ${RU_CONSTRUCTIONS.length} constructions`);
