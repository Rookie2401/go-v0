  "notes": [
    {
      "id": "n1",
      "kind": "grammar",
      "title": "det regner, fordi, men",
      "text": "\"Det regner\" is \"it is raining\": Norwegian needs a little \"det\" (it) in front, just as English does. \"Men\" is \"but\" and \"fordi\" is \"because\". Look at \"i dag regner det\": the verb stays in second place, so the subject \"det\" comes after it.",
      "explains": [
        "nb.det-weather",
        "nb.fordi",
        "nb.men-og",
        "nb.verb-second"
      ],
      "afterScenes": 0
    },
    {
      "id": "n2",
      "kind": "grammar",
      "title": "bestemora si",
      "text": "\"Nils går med bestemora si\": \"si\" means \"his own\" and is used when the owner is the one doing the action. It is the same pattern as \"søstera mi\", but for \"his / her / their own\": bestemora si.",
      "explains": [
        "nb.reflexive-si"
      ],
      "afterScenes": 1
    }
