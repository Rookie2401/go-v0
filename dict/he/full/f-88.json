”).","tpl":[{"k":39,"lang":40,"form":"*śahr-","gloss":"moon"},{"k":20,"lang":34,"form":"סהרא","gloss":"moon"},{"k":20,"lang":"ar","form":"شَهْر","gloss":"month, new moon"},{"k":20,"lang":139,"form":"𐩦𐩠𐩧","gloss":"beginning of the lunar month"},{"k":20,"lang":67,"form":"ሣህር","gloss":"moon, first day of the month"}]}}],"שסק":[{"w":"שסק","p":"NOUN","s":[{"g":"loquat"}],"f":[["קֶטֶל",48],["שֶׁסֶק",3],["shések",0],["שְׁסָקִים",2],["שִׁסְקֵי־",24]],"audio":[{"u":"c/c8/LL-Q9288_%28heb%29-YaronSh-%D7%A9%D7%A1%D7%A7.wav/LL-Q9288_%28heb%29-YaronSh-%D7%A9%D7%A1%D7%A7.wav.ogg","b":23,"n":"LL-Q9288 (heb)-YaronSh-שסק.wav"}],"ety":{"text":"Originally from Aramaic שִׁסְקָא, mentioned in the Talmud, the identification of which is unclear, although it was variously applied to the plum, almond or medlar by medieval commentators. The interpretation as medlar was adopted in the revival of Hebrew by Eliezer Ben-Yehuda, which was subsequently re-nativized to mean loquat, likely influenced by Arabic إِسْكِدُنْيَا (ʔiskidunyā, “medlar, loquat”). Also compare Portuguese nêspera, as well as Italian nespola del Giappone, Spanish níspero japonés, French nèfle du Japon, German Japanische Mispel.","tpl":[{"k":29,"lang":34,"form":"שִׁסְקָא"},{"k":20,"lang":"ar","form":"إِسْكِدُنْيَا","gloss":"medlar, loquat"},{"k":20,"lang":"pt","form":"nêspera"},{"k":20,"lang":"it","form":"nespola del Giappone"},{"k":20,"lang":"es","form":"níspero japonés"},{"k":20,"lang":"fr","form":"nèfle du Japon"},{"k":20,"lang":"de","form":"Japanische Mispel"}]}}],"תמונה":[{"w":"תמונה","p":"NOUN","s":[{"g":"photograph, photo, picture"},{"g":"image"}],"f":[["תְּמוּנָה",42],["tmuná",0],["תְּמוּנוֹת",2]],"ipa":[{"i":"/tmuˈna/"}],"audio":[{"u":"2/20/LL-Q9288_%28heb%29-Uziel302-%D7%AA%D7%9E%D7%95%D7%A0%D7%94.wav/LL-Q9288_%28heb%29-Uziel302-%D7%AA%D7%9E%D7%95%D7%A0%D7%94.wav.ogg","b":23,"n":"LL-Q9288_(heb)-Uziel302-תמונה.wav"}],"rel":{"r":["תַּצְלוּם"]}}],"תעלת סואץ":[{"w":"תעלת סואץ","p":"PROPN","s":[{"g":"Suez Canal"}],"f":[["תְ