              "text": "La iglesia está cerca.",
              "english": "The church is near."
            },
            {
              "speaker": "daniel",
              "text": "Yo vivo lejos.",
              "english": "I live far away."
            },
            {
              "speaker": "daniel",
              "text": "Puedo venir en autobús.",
              "english": "I can come by bus."
            },
            {
              "speaker": "sam",
              "text": "Yo puedo venir con vos, Daniel.",
              "english": "I can come with you, Daniel."
            },
            {
              "speaker": "sam",
              "text": "Voy a enviar 9987-2345 a doña Marta.",
              "english": "I am going to send 9987-2345 to doña Marta."
            }
          ]
        },
        {
          "sentences": [
            {
              "speaker": "marta",
              "text": "Nico: pan en la mesa.",
              "english": "(Message) Nico: bread on the table."
            },
            {
              "speaker": "marta",
              "text": "Vení a la casa.",
              "english": "Come home."
            },
            {
              "speaker": "nico",
              "text": "Voy, abuela.",
