/**
 * Shared helpers of the Alphabet Sprint word-list builders (scripts/alphabet-sprint/<lang>.mts). Each builder reads the pack's
 * COMMITTED word data (lexicons, tutorials, Stage 0, glossed corpus words), keeps real words with a meaning, ranks them by the local
 * frequency list when this machine has one (public/dict/<lang>/frequency.json, git-ignored), and writes
 * src/alphabet/sprint/words/<lang>.ts. The written module is committed, so the app never needs the local data.
 *
 *   npx vite-node scripts/alphabet-sprint/<lang>.mts            write
 *   npx vite-node scripts/alphabet-sprint/<lang>.mts --check    compare only (exit 1 when the module differs)
 */
import fs from 'node:fs';
import path from 'node:path';
import type { StarterPhrase, StarterWord } from '../../src/alphabet/sprint/types';

export interface Row { lemma: string; gloss: string; pos?: string }

/** `lemma(/tag) = gloss [tags] | forms` rows of a pack lexicon (lines starting # set the POS, // and blank lines are skipped). */
export function lexiconRows(text: string): Row[] {
  const out: Row[] = [];
  let pos: string | undefined;
  for (const raw of text.split('\n')) {
    const line = raw.trim();
    if (!line || line.startsWith('//')) continue;
    if (line.startsWith('#')) { pos = line.slice(1).trim().split(/\s+/)[0]; continue; }
    const m = /^([^=|[]+?)\s*=\s*([^[|]+)/.exec(line);
    if (!m) continue;
    const lemma = m[1].split('/')[0].trim().normalize('NFC');
    const gloss = m[2].trim();
    if (lemma && gloss) out.push({ lemma, gloss, ...(pos ? { pos } : {}) });
  }
  return out;
}

/** The first sense of a gloss, short: "to keep, watch; to guard" → "to keep, watch". */
export const firstSense = (gloss: string): string => gloss.split(';')[0].replace(/\s*\(.*?\)\s*/g, ' ').replace(/\s+/g, ' ').trim();

/** Rank (0 = most frequent) of each lemma in the local frequency list, or an empty map when this machine has none. */
export function frequencyRanks(lang: string, root = process.cwd()): Map<string, number> {
  const f = path.join(root, 'public/dict', lang, 'frequency.json');
  const out = new Map<string, number>();
  if (!fs.existsSync(f)) return out;
  const data = JSON.parse(fs.readFileSync(f, 'utf8')) as { lemmas: Array<[string, number]> };
  data.lemmas.forEach(([lemma], i) => { const k = lemma.normalize('NFC'); if (!out.has(k)) out.set(k, i); });
  return out;
}

/** Weight 0..1 from a frequency rank (1 for the most frequent, 0.05 floor); a word with no rank gets `fallback`. */
export const weightFromRank = (rank: number | undefined, fallback = 0.2): number =>
  rank === undefined ? fallback : Math.max(0.05, Math.round((1 - Math.log10(rank + 1) / 4) * 1000) / 1000);

export interface BuildResult { lang: string; words: StarterWord[]; phrases: StarterPhrase[]; sources: string[]; note: string; /** The script that builds it, when not scripts/alphabet-sprint/<lang>.mts. */ script?: string }

/** Write (or check) src/alphabet/sprint/words/<lang>.ts. Words are deduplicated by form, sorted by weight then form. */
export function writeWords(r: BuildResult): void {
  const seen = new Set<string>();
  const words = r.words.filter((w) => { const k = w.form.normalize('NFC'); if (seen.has(k)) return false; seen.add(k); return true; })
    .map((w) => ({ ...w, form: w.form.normalize('NFC') }))
    .sort((a, b) => b.weight - a.weight || (a.form < b.form ? -1 : a.form > b.form ? 1 : 0));
  const phraseSeen = new Set<string>();
  const phrases = r.phrases.filter((p) => { const k = p.form.normalize('NFC'); if (phraseSeen.has(k)) return false; phraseSeen.add(k); return true; })
    .map((p) => ({ ...p, form: p.form.normalize('NFC') }));
  const body = `/**
 * GENERATED by ${r.script ?? `scripts/alphabet-sprint/${r.lang}.mts`} — do not edit by hand. Real words and phrases for Alphabet Sprint decoding practice,
 * with the meanings the pack's own data gives them. ${r.note}
 * Sources: ${r.sources.join('; ')}.
 */
import type { StarterPhrase, StarterWord } from '../types';

export const WORDS: readonly StarterWord[] = ${JSON.stringify(words, null, 1)};

export const PHRASES: readonly StarterPhrase[] = ${JSON.stringify(phrases, null, 1)};
`;
  const out = path.join('src/alphabet/sprint/words', `${r.lang}.ts`);
  if (process.argv.includes('--check')) {
    const same = fs.existsSync(out) && fs.readFileSync(out, 'utf8') === body;
    console.log(JSON.stringify({ lang: r.lang, words: words.length, phrases: phrases.length, same }));
    if (!same) process.exitCode = 1;
    return;
  }
  fs.mkdirSync(path.dirname(out), { recursive: true });
  fs.writeFileSync(out, body);
  console.log(JSON.stringify({ lang: r.lang, words: words.length, phrases: phrases.length, out }));
}
