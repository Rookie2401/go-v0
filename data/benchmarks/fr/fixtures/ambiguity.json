    { "id": "amb-011", "sentence": "J'entends un son aigu.", "target": "son", "expect": { "lemma": "son", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "un son: the noun (sound)" },
    { "id": "amb-012", "sentence": "La ferme est grande.", "target": "ferme", "expect": { "lemma": "ferme", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "la ferme: the farm" },
    { "id": "amb-013", "sentence": "Il ferme la porte.", "target": "ferme", "expect": { "lemma": "fermer", "pos": "VERB", "features": { "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "after il, ferme is fermer" },
