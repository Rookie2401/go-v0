            {
              "speaker": "anna",
              "text": "Ist es gut?",
              "english": "Is it good?"
            },
            {
              "speaker": "sam",
              "text": "Ja, es ist sehr gut.",
              "english": "Yes, it is very good."
            },
            {
              "speaker": "anna",
              "text": "Sam spricht sehr gut Deutsch, Marta.",
              "english": "Sam speaks German very well, Marta."
            },
            {
              "speaker": "marta",
              "text": "Ja, das ist gut.",
              "english": "Yes, that is good."
            },
            {
              "speaker": "marta",
              "text": "Ben ist ein schöner Name, Sam.",
              "english": "Ben is a lovely name, Sam."
            },
            {
              "speaker": "lukas",
              "text": "Wo ist das Bad, Marta?",
              "english": "Where is the bathroom, Marta?"
            },
            {
              "speaker": "marta",
              "text": "Da, bei der Küche.",
              "english": "There, by the kitchen."
            },
            {
              "speaker": "marta",
              "text": "Das Bad ist klein.",
              "english": "The bathroom is small."
            }
          ]
        }
      ]
    },
    {
      "title": "Ben und Mama und Papa",
      "paragraphs": [
        {
          "sentences": [
            {
              "speaker": "ben",
              "text": "Wo ist Mama?",
              "english": "Where is Mama?"
            },
            {
              "speaker": "marta",
              "text": "Mama arbeitet heute, Ben.",
              "english": "Mama is working today, Ben."
            },
            {
              "speaker": "ben",
              "text": "Und Papa?",
              "english": "And Papa?"
            },
            {
              "speaker": "marta",
              "text": "Papa ist in Dresden.",
              "english": "Papa is in Dresden."
            },
            {
              "speaker": "ben",
              "text": "Mama und Papa sind nicht hier.",
              "english": "Mama and Papa are not here."
            },
            {
              "speaker": "marta",
              "text": "Ich weiß.",
              "english": "I know."
            },
            {
              "speaker": "marta",
              "text": "Aber deine Mutter ist meine Tochter.",
              "english": "But your mother is my daughter."
            },
            {
              "speaker": "marta",
              "text": "Ich bin alt, aber ich bin hier, Ben.",
              "english": "I am old, but I am here, Ben."
            },
            {
              "speaker": "ben",
              "text": "Ja, Oma.",
              "english": "Yes, Grandma."
            },
            {
              "speaker": "ben",
              "text": "Du bist sehr gut.",
              "english": "You are very good."
            },
            {
              "speaker": "sam",
              "text": "Marta, ich habe ein Bild von meiner Familie.",
              "english": "Marta, I have a picture of my family."
            },
            {
              "speaker": "marta",
              "text": "Wie schön!",
              "english": "How lovely!"
            },
            {
              "speaker": "marta",
              "text": "Das ist dein Vater?",
              "english": "That is your father?"
            },
            {
              "speaker": "sam",
              "text": "Ja.",
              "english": "Yes."
            },
            {
              "speaker": "sam",
              "text": "Er kocht auch am Sonntag, wie du.",
              "english": "He cooks on Sundays too, like you."
            }
          ]
        }
      ]
    },
    {
      "title": "Der Kuchen",
      "paragraphs": [
        {
          "sentences": [
            {
              "speaker": "marta",
              "text": "Möchtet ihr Kuchen?",
              "english": "Would you like cake?"
