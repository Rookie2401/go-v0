# Required for release preparation. Must be the public HTTPS origin for the Repository service: the default of every system is the Render address (2026-10-27).
REPOSITORY_SERVICE_URL=https://go-v0.onrender.com

# Optional: where THIS machine reaches the same service for the pre-build health check (the bundle still carries REPOSITORY_SERVICE_URL).
# Not needed for the Render address, which this PC reaches directly; it was for the canonical name the home router blocks.
# REPOSITORY_HEALTH_CHECK_URL=http://127.0.0.1:8790

# The Bundle ID registered in the Apple Developer account.
BIBLIA_BUNDLE_ID=com.cjwalker.biblia
BIBLIA_BUILD_NUMBER=1
BIBLIA_MARKETING_VERSION=1.0.0

# Optional: the Expo project id written by `npx eas init` (only needed to re-stage after the first stage was deleted).
# BIBLIA_EAS_PROJECT_ID=

# The Expo project for this shell, created 2026-10-24 by `npx eas init` in the stage (https://expo.dev/accounts/rookie56r/projects/biblia-ios). Not a secret; a project address.
BIBLIA_EAS_PROJECT_ID=04e595f4-05bc-44f5-85a5-fa9cb76e9202
