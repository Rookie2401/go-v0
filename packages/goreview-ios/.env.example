# Required for release preparation. Must be the public HTTPS origin for the Repository service: the default of every system is the Render address (2026-10-27).
REPOSITORY_SERVICE_URL=https://go-v0.onrender.com

# Replace the provisional value with the Bundle ID registered in your Apple Developer account.
GOREVIEW_BUNDLE_ID=com.example.provisional.goreview

# Required by build-eas-project.mjs and archive-testflight.sh: a positive integer greater than the last uploaded build.
GOREVIEW_BUILD_NUMBER=1

# Optional: the user-visible version (1.0 or 1.0.1). Defaults to 1.0.0 (EAS stage) or 1.0 (archive script).
# GOREVIEW_MARKETING_VERSION=1.0.0

# Optional: where THIS machine reaches the Repository service for the pre-build /health check when the public name is not reachable from it.
# The bundle still carries REPOSITORY_SERVICE_URL.
# REPOSITORY_HEALTH_CHECK_URL=http://127.0.0.1:8790

# Optional: comma-separated dictionary languages shipped in the web build (default sq,es,de,hi,th).
# GOREVIEW_DICT=sq,es,de,hi,th

# EAS cloud build: set in the shell with .eas-project/ as the working directory (see README.md); read by EAS CLI.
# EAS_NO_VCS=1
# EAS_PROJECT_ROOT=<absolute path of the .eas-project folder>
