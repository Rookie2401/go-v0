{
  "category": "pronouns",
  "note": "Held-out second set. Clitics, disjunctive, demonstrative, indefinite, interrogative and possessive pronouns. An AI's judgement, not native-reviewed.",
  "cases": [
    { "id": "h-pron-001", "sentence": "Je le lui ai dit hier.", "target": "lui", "expect": { "pos": "PRON", "features": { "Case": "Dat" }, "construction": "double-object-pronouns" }, "source": "grammar", "level": "core", "why": "le (direct) before lui (indirect)" },
    { "id": "h-pron-002", "sentence": "Il m’a envoyé un colis.", "target": "m’", "expect": { "lemma": "me", "pos": "PRON", "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "[web] elided object clitic m'" },
    { "id": "h-pron-003", "sentence": "Donne-le-moi tout de suite.", "target": "le", "expect": { "lemma": "le", "pos": "PRON", "features": { "Case": "Acc" }, "construction": "imperative-pronouns" }, "source": "grammar", "level": "core", "why": "positive imperative: le is a clitic (not an article), accusative" },
    { "id": "h-pron-004", "sentence": "Il y pense souvent.", "target": "y", "expect": { "lemma": "y", "pos": "PRON", "construction": "pronoun-y" }, "alsoAcceptPos": ["ADV"], "source": "grammar", "level": "core", "why": "y replaces à + thing" },
    { "id": "h-pron-005", "sentence": "J’en ai besoin.", "target": "en", "expect": { "lemma": "en", "pos": "PRON", "construction": "pronoun-en" }, "alsoAcceptPos": ["ADV", "ADP"], "source": "grammar", "level": "core", "why": "en replaces de + thing" },
    { "id": "h-pron-006", "sentence": "Nous nous lavons les mains.", "target": "nous", "occurrence": 2, "expect": { "pos": "PRON", "features": { "Reflex": "Yes" } }, "source": "grammar", "level": "advanced", "why": "the second nous is the reflexive pronoun of the pronominal verb" },
    { "id": "h-pron-007", "sentence": "Elle les a vus au marché.", "target": "les", "expect": { "lemma": "le", "pos": "PRON", "features": { "Number": "Plur", "Case": "Acc" } }, "source": "grammar", "level": "core", "why": "les before a verb is the clitic, not the article" },
    { "id": "h-pron-008", "sentence": "Ils lui ont écrit une lettre.", "target": "lui", "expect": { "pos": "PRON", "features": { "Case": "Dat" }, "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "indirect object clitic" },
    { "id": "h-pron-009", "sentence": "C’est moi qui ai peur.", "target": "moi", "expect": { "pos": "PRON" }, "source": "grammar", "level": "core", "why": "disjunctive pronoun after c'est" },
    { "id": "h-pron-010", "sentence": "Je pense à toi.", "target": "toi", "expect": { "pos": "PRON", "features": { "Person": "2" } }, "source": "grammar", "level": "core", "why": "disjunctive pronoun after a preposition" },
    { "id": "h-pron-011", "sentence": "Ceux-ci sont plus petits que ceux-là.", "target": "Ceux-ci", "expect": { "pos": "PRON", "features": { "PronType": "Dem" } }, "source": "grammar", "level": "core", "why": "demonstrative pronoun with -ci, one token" },
    { "id": "h-pron-012", "sentence": "Celle qui chante est ma sœur.", "target": "Celle", "expect": { "pos": "PRON", "features": { "PronType": "Dem", "Gender": "Fem" } }, "source": "grammar", "level": "core", "why": "celle: feminine demonstrative before a relative" },
    { "id": "h-pron-013", "sentence": "Chacun peut laisser un avis sur le site.", "target": "Chacun", "expect": { "pos": "PRON", "features": { "PronType": "Ind" } }, "source": "grammar", "level": "core", "why": "indefinite pronoun" },
    { "id": "h-pron-014", "sentence": "Quelqu’un a déjà testé ce produit ?", "target": "Quelqu’un", "expect": { "pos": "PRON", "features": { "PronType": "Ind" } }, "source": "grammar", "level": "core", "why": "indefinite pronoun, one token" },
    { "id": "h-pron-015", "sentence": "Voici mon sac et voilà le tien.", "target": "tien", "expect": { "pos": "PRON" }, "alsoAcceptPos": ["ADJ"], "source": "grammar", "level": "advanced", "why": "possessive pronoun le tien (the possessive adjective is ton)" },
    { "id": "h-pron-016", "sentence": "Leurs enfants jouent dans leur jardin.", "target": "Leurs", "expect": { "lemma": "leur", "pos": "DET", "features": { "Poss": "Yes", "Number": "Plur" } }, "source": "grammar", "level": "core", "why": "possessive determiner (not the pronoun leur)" },
    { "id": "h-pron-017", "sentence": "Cette idée est la leur.", "target": "leur", "expect": { "pos": "PRON", "features": { "Poss": "Yes" } }, "source": "grammar", "level": "advanced", "why": "la leur is a possessive pronoun, not the determiner" },
    { "id": "h-pron-018", "sentence": "Qui a déjà essayé cette recette ?", "target": "Qui", "expect": { "lemma": "qui", "pos": "PRON", "features": { "PronType": "Int" } }, "source": "grammar", "level": "core", "why": "interrogative qui, not the relative" },
    { "id": "h-pron-019", "sentence": "Que cherches-tu ?", "target": "Que", "expect": { "pos": "PRON", "features": { "PronType": "Int" } }, "source": "grammar", "level": "advanced", "why": "Que as an interrogative pronoun (object), not the conjunction" },
    { "id": "h-pron-020", "sentence": "On y va ?", "target": "On", "expect": { "lemma": "on", "pos": "PRON", "features": { "Person": "3", "Number": "Sing" } }, "source": "grammar", "level": "core", "why": "[forum] on is a third-person singular subject" },
    { "id": "h-pron-021", "sentence": "Tu l’as vu, ce film ?", "target": "l’", "expect": { "lemma": "le", "pos": "PRON", "features": { "Case": "Acc" } }, "source": "grammar", "level": "core", "why": "[forum] l' before a verb is the object clitic" },
    { "id": "h-pron-022", "sentence": "Il s’est regardé dans le miroir.", "target": "s’", "expect": { "lemma": "se", "pos": "PRON", "features": { "Reflex": "Yes" } }, "source": "grammar", "level": "core", "why": "reflexive pronoun, elided" },
    { "id": "h-pron-023", "sentence": "Elle nous a vus dans la foule.", "target": "nous", "expect": { "lemma": "nous", "pos": "PRON", "features": { "Person": "1", "Number": "Plur" } }, "source": "grammar", "level": "core", "why": "object clitic nous" },
    { "id": "h-pron-024", "sentence": "Je veux le faire moi-même.", "target": "moi-même", "expect": { "pos": "PRON" }, "source": "grammar", "level": "core", "why": "moi-même is one token and a pronoun" },
    { "id": "h-pron-025", "sentence": "Dites-lui de venir demain.", "target": "lui", "expect": { "pos": "PRON", "features": { "Case": "Dat" }, "construction": "imperative-pronouns" }, "source": "grammar", "level": "core", "why": "positive imperative with an indirect clitic" }
  ]
}
