{
  "name": "go-v0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Go — a missions-oriented language-acquisition system (Comprehensible Input Corpus, Bible Corpus, My Testimony) with GoLearn / GoListen / GoTell engines underneath.",
  "scripts": {
    "stage0:validate": "vite-node scripts/stage0-validate.mts",
    "ladder:check": "vite-node scripts/ladder-check.mts",
    "ladder:place": "vite-node scripts/ladder-place.mts",
    "audio:packet": "vite-node scripts/audio-packet.mts",
    "dev": "vite",
    "build": "tsc -b && vite-node --config scripts/vite.config.ts scripts/rights-gate.mts && vite-node --config scripts/vite.config.ts scripts/check-course-libraries.mts --require hi,de,es,th,sq && node scripts/verify-scripture-canon.mjs && vite-node --config scripts/vite.config.ts scripts/library-audit.mts all && vite-node --config scripts/vite.config.ts scripts/dict-status.mts --require hi,de,es,th,sq && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "ext:build": "vite build -c packages/golearn-extension/vite.config.ts --mode content && vite build -c packages/golearn-extension/vite.config.ts --mode background && vite build -c packages/golearn-extension/vite.config.ts --mode action && vite build -c packages/golearn-extension/vite.config.ts --mode analysers",
    "test": "vitest run",
    "gate": "tsc -b && vitest run",
    "corpus:validate": "vite-node --config scripts/vite.config.ts scripts/corpus-validate.mts",
    "corpus:check": "vite-node --config scripts/vite.config.ts scripts/corpus-check.mts",
    "corpus:migrate": "vite-node --config scripts/vite.config.ts scripts/corpus-migrate.mts",
    "corpus:review": "vite-node --config scripts/vite.config.ts scripts/corpus-review.mts",
    "corpus:prove": "vite-node --config scripts/vite.config.ts scripts/corpus-prove.mts",
    "corpus:convert": "vite-node --config scripts/vite.config.ts scripts/corpus-convert.mts",
    "dict:build": "vite-node --config scripts/vite.config.ts scripts/dict-build.mts",
    "he:build-biblical": "vite-node --config scripts/vite.config.ts scripts/he-build-biblical.mts",
    "he:build-modern": "vite-node --config scripts/vite.config.ts scripts/he-build-modern.mts",
    "el:build-koine": "vite-node --config scripts/vite.config.ts scripts/el-build-koine.mts",
    "el:build-ancient": "vite-node --config scripts/vite.config.ts scripts/el-build-kaikki.mts --lang grc",
    "el:build-modern": "vite-node --config scripts/vite.config.ts scripts/el-build-kaikki.mts --lang el",
    "el:audit-treebank": "vite-node --config scripts/vite.config.ts scripts/el-audit-treebank.mts",
    "scripture:audit-first-reading": "vite-node --config scripts/vite.config.ts scripts/scripture-audit-first-reading.mts",
    "texts:audit-plain": "vite-node --config scripts/vite.config.ts scripts/texts-audit-plain.mts",
    "biblia:import": "vite-node --config scripts/vite.config.ts scripts/biblia-import.mts",
    "biblia:dev": "vite -c packages/biblia/vite.config.ts --port 5199",
    "biblia:build": "vite build -c packages/biblia/vite.config.ts",
    "dict:build-full": "vite-node --config scripts/vite.config.ts src/dict/build-full.ts",
    "dict:compare": "vite-node --config scripts/vite.config.ts scripts/dict-compare.mts",
    "dict:status": "vite-node --config scripts/vite.config.ts scripts/dict-status.mts",
    "dict:verify-full": "vite-node --config scripts/vite.config.ts scripts/dict-verify-full.mts",
    "dict:publish": "vite-node --config scripts/vite.config.ts scripts/dict-publish.mts",
    "rights:check": "vite-node --config scripts/vite.config.ts scripts/rights-gate.mts",
    "hi:gold": "vite-node --config scripts/vite.config.ts scripts/hi-gold.mts",
    "hi:eval-gold": "vite-node --config scripts/vite.config.ts scripts/eval-hi-gold.mts",
    "hi:probe": "vite-node --config scripts/vite.config.ts scripts/probe-hi-coverage.mts",
    "hi:sentence": "vite-node --config scripts/vite.config.ts scripts/probe-hi-sentence.mts",
    "gutenberg:prose": "vite-node --config scripts/vite.config.ts scripts/acquire-gutenberg-prose.mts",
    "dict:compare-es": "vite-node --config scripts/vite.config.ts scripts/dict-compare-es.mts",
    "es:eval-morph": "vite-node --config scripts/vite.config.ts scripts/eval-es-morph.mts",
    "es:eval-context": "vite-node --config scripts/vite.config.ts scripts/eval-es-context.mts",
    "sq:agreement": "vite-node --config scripts/vite.config.ts scripts/sq-agreement.mts",
    "sq:check-analyzer": "vite-node --config scripts/vite.config.ts scripts/sq-check-analyzer.mts",
    "sq:check-texts": "vite-node --config scripts/vite.config.ts scripts/sq-check-texts.mts",
    "sq:ladder-build": "vite-node --config scripts/vite.config.ts scripts/sq-ladder-build.mts",
    "sq:ladder-author": "vite-node --config scripts/vite.config.ts scripts/sq-ladder-author.mts",
    "sq:dict-expand": "vite-node --config scripts/vite.config.ts scripts/sq-dict-expand.mts",
    "sq:eval-ud": "vite-node --config scripts/vite.config.ts scripts/sq-eval-ud.mts",
    "sq:gold": "vite-node --config scripts/vite.config.ts scripts/sq-gold.mts",
    "authoring:report": "vite-node --config scripts/vite.config.ts scripts/authoring-report.mts",
    "authoring:check": "vite-node --config scripts/vite.config.ts scripts/authoring-check.mts",
    "library:frequency": "vite-node --config scripts/vite.config.ts scripts/library-frequency.mts",
    "library:build": "vite-node --config scripts/vite.config.ts scripts/library-build.mts",
    "library:check": "vite-node --config scripts/vite.config.ts scripts/check-course-libraries.mts",
    "tones:eval": "vite-node --config scripts/vite.config.ts scripts/eval-tones-kaikki.mts",
    "bench:words": "vite-node --config scripts/vite.config.ts scripts/bench-words.mts",
    "bench:units": "vite-node --config scripts/vite.config.ts scripts/bench-units.mts",
    "gold:wiktionary": "vite-node --config scripts/vite.config.ts scripts/gold-wiktionary.mts",
    "gold:draft": "vite-node --config scripts/vite.config.ts scripts/gold-draft.mts",
    "gold:accept": "vite-node --config scripts/vite.config.ts scripts/gold-accept.mts",
    "gold:status": "vite-node --config scripts/vite.config.ts scripts/gold-status.mts",
    "gold:freeze": "vite-node --config scripts/vite.config.ts scripts/gold-freeze.mts",
    "speech:check": "vite-node --config scripts/vite.config.ts scripts/speech-check.mts",
    "hi:gdl": "vite-node --config scripts/vite.config.ts scripts/acquire-hi-gdl.mts",
    "library:audit": "vite-node --config scripts/vite.config.ts scripts/library-audit.mts",
    "library:rebuild": "vite-node --config scripts/vite.config.ts scripts/library-rebuild.mts",
    "library:sentences": "vite-node --config scripts/vite.config.ts scripts/library-sentences.mts",
    "library:order": "vite-node --config scripts/vite.config.ts scripts/library-order.mts",
    "library:sync-catalogue": "vite-node --config scripts/vite.config.ts scripts/sync-library-catalogue.mts",
    "review:packet": "vite-node scripts/review-packet.mts",
    "review:apply": "vite-node scripts/review-apply.mts",
    "norway:audit": "vite-node --config scripts/vite.config.ts scripts/norway-audit.mts",
    "reader:fixture": "vite-node --config scripts/vite.config.ts packages/controlled-reader/scripts/make-fixture.mts",
    "reader:build": "vite build --config packages/controlled-reader/vite.config.ts --mode prototype",
    "ext:build:harness": "vite build -c packages/golearn-extension/vite.config.ts --mode content-harness",
    "local:build": "npm run ext:build && vite build -c packages/golearn-extension/app/vite.config.ts --mode options && vite build -c packages/golearn-extension/app/vite.config.ts --mode web && vite build -c packages/gopractice/vite.config.ts && vite build -c packages/gopractice/vite.config.ts --mode extension",
    "local:seed": "vite-node scripts/local/seed-teams.ts",
    "local:service": "vite-node packages/repository-service/src/main.ts --port 8790 --data data/local-repository --host 127.0.0.1"
  },
  "dependencies": {
    "@open-spaced-repetition/binding": "0.5.0",
    "dexie": "^4",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "epubjs": "^0.3.93",
    "fake-indexeddb": "^6",
    "jsdom": "^26",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6",
    "vitest": "^3.2.7"
  }
}
