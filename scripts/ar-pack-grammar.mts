/// <reference types="node" />
/**
 * npx vite-node --config scripts/vite.config.ts scripts/ar-pack-grammar.mts
 *
 * Writes packages/language-packs/src/packs/ar-grammar.ts: the Arabic pack's grammar tables (the features and the sentence patterns the
 * card explains) as plain data. They are WRITTEN in the analyser (src/adapters/arabic/tags.ts `AR_FEATURES`, constructions.ts
 * `AR_CONSTRUCTIONS`), where the code that produces those features and patterns lives; the pack manifest must not import the analyser
 * (every manifest is linked into the extension's background worker, which must not carry an analyser), so it reads this copy.
 * test/language-packs/arabic.test.ts fails when the copy and the analyser's tables differ: run this script again.
 */
import fs from 'node:fs';
import path from 'node:path';
import { AR_FEATURES } from '../src/adapters/arabic/tags';
import { AR_CONSTRUCTIONS } from '../src/adapters/arabic/constructions';

const out = path.join(process.cwd(), 'packages/language-packs/src/packs/ar-grammar.ts');
/** What each feature does, in plain words (the analyser's table has labels and values only). Machine-drafted. */
const EXPLAIN: Record<string, string> = {
  Case: 'A noun, adjective or name ends in -u (nominative: the subject), -a (accusative: the object, and after إِنَّ) or -i (genitive: after a preposition and the second word of a construct phrase). Most print leaves these endings out, so the card shows a case only where the page prints it or a sentence rule is certain, and marks an inferred case as inferred.',
  Number: 'Arabic has the singular, the dual (two of something: -ān / -ayn) and the plural; the plural of a noun is either sound (an ending added) or broken (the word is reshaped: كِتَاب, كُتُب). Some nouns are collectives or take a paucal plural for three to ten.',
  Gender: 'Every noun is masculine or feminine; the feminine usually ends in ـَة, and the verb, the adjective and the pronoun agree with it.',
  Definite: 'A noun is definite with the article ال, as the first word of a construct phrase (كِتَابُ الطَّالِبِ, no article), or with a possessive pronoun; otherwise it is indefinite, often with the ending -un.',
  Person: 'First, second or third person: who acts. The Arabic verb carries it, with gender and number, in a prefix and a suffix.',
  Aspect: 'The perfect (كَتَبَ) is a finished action, usually past; the imperfect (يَكْتُبُ) is an action in progress or not finished, present or future by the sentence.',
  Mood: 'The imperfect has three moods by its last vowel: indicative (the plain verb), subjunctive (after أَنْ, لَنْ, لِ) and jussive (after لَمْ, لَا of command, and in a command). The imperative is the command form.',
  Voice: 'Active (كَتَبَ, he wrote) or passive (كُتِبَ, it was written): the passive is shown by the vowels, which a printed text usually leaves out, so it is often only recognised from the sentence.',
  VerbForm: 'A finite verb has a person; a participle (كَاتِب, writing, a writer; مَكْتُوب, written) and a verbal noun (كِتَابَة, writing) are nouns or adjectives made from a verb, each its own dictionary word where the dictionary has one.',
  Form: 'A verb is built on a root of three or four letters in one of ten patterns (forms I to X): كَتَبَ is form I, كَاتَبَ (to correspond) form III, اِسْتَكْتَبَ form X. The form changes the meaning in a regular way.',
  Decl: 'A triptote takes all three case endings with -n (tanwīn); a diptote (many names, and some plurals such as مَسَاجِد) never takes tanwīn and takes -a for the genitive; an indeclinable word does not change.',
  PluralType: 'A sound plural adds an ending (مُعَلِّمُونَ, مُعَلِّمَات); a broken plural reshapes the word and must be learned with it (رَجُل, رِجَال).',
  Pausal: 'At the end of a sentence or a verse the last vowel is dropped when the word is spoken; the form is read as the word without its ending.',
};
const q = (s: string): string => `'${s.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
const values = (v: Record<string, string>): string => `{ ${Object.entries(v).map(([k, x]) => `${/^[A-Za-z_]\w*$/.test(k) ? k : q(k)}: ${q(x)}`).join(', ')} }`;

const lines: string[] = [
  '/* GENERATED by scripts/ar-pack-grammar.mts from src/adapters/arabic/tags.ts (AR_FEATURES) and constructions.ts (AR_CONSTRUCTIONS).',
  ' * Do not edit: change the analyser\'s table and run the script. Machine-drafted; not reviewed by a native speaker or an Arabist. */',
  "import type { GrammarConstruction, GrammarFeature } from '../manifest';",
  '',
  'export const AR_GRAMMAR_FEATURES: GrammarFeature[] = [',
  ...AR_FEATURES.map((f) => `  { key: ${q(f.key)}, label: ${q(f.label)}, values: ${values(f.values)}, explain: ${q((f as { explain?: string }).explain ?? EXPLAIN[f.key] ?? (() => { throw new Error('no explanation for ' + f.key); })())} },`),
  '];',
  '',
  'export const AR_GRAMMAR_CONSTRUCTIONS: GrammarConstruction[] = [',
  ...AR_CONSTRUCTIONS.map((c) => `  { id: ${q(c.id)}, label: ${q(c.label)}, explain: ${q(c.explain)} },`),
  '];',
  '',
];
fs.writeFileSync(out, lines.join('\n'));
console.log(`wrote ${path.relative(process.cwd(), out)}: ${AR_FEATURES.length} features, ${AR_CONSTRUCTIONS.length} constructions`);
