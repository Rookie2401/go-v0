{
  "category": "compound-tenses",
  "note": "Compound tenses with avoir and être, passive voice, and past-participle agreement (être; preceding direct object under avoir; none after the verb; pronominal verbs). Expectations are the auxiliary's and the participle's own lemma and features, plus the construction id (docs/french/PLAN.md CONTEXT). An AI's judgement, not native-reviewed.",
  "cases": [
    { "id": "comp-001", "sentence": "Elle a mangé une pomme.", "target": "a", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "3", "Number": "Sing" }, "construction": "passe-compose" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "passé composé: auxiliary avoir in the present" },
    { "id": "comp-002", "sentence": "Elle a mangé une pomme.", "target": "mangé", "expect": { "lemma": "manger", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "source": "kaikki", "level": "core", "why": "the participle: VerbForm Part, Tense Past" },
    { "id": "comp-003", "sentence": "Il est arrivé hier.", "target": "est", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Pres", "Person": "3" }, "construction": "passe-compose" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "passé composé of a verb of motion takes être" },
    { "id": "comp-004", "sentence": "Il est arrivé hier.", "target": "arrivé", "expect": { "lemma": "arriver", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past", "Gender": "Masc", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "masculine singular participle" },
    { "id": "comp-005", "sentence": "Elle est arrivée hier.", "target": "arrivée", "expect": { "lemma": "arriver", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past", "Gender": "Fem", "Number": "Sing" }, "construction": "participle-agreement-etre" }, "source": "kaikki", "level": "core", "why": "with être the participle agrees with the subject" },
    { "id": "comp-006", "sentence": "Elles sont arrivées hier.", "target": "arrivées", "expect": { "lemma": "arriver", "pos": "VERB", "features": { "Gender": "Fem", "Number": "Plur" }, "construction": "participle-agreement-etre" }, "source": "kaikki", "level": "core", "why": "feminine plural agreement with être" },
    { "id": "comp-007", "sentence": "Ils sont partis hier.", "target": "partis", "expect": { "lemma": "partir", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Masc", "Number": "Plur" }, "construction": "participle-agreement-etre" }, "source": "kaikki", "level": "core", "why": "masculine plural agreement with être" },
    { "id": "comp-008", "sentence": "Elle est allée au marché.", "target": "allée", "expect": { "lemma": "aller", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Sing" }, "construction": "participle-agreement-etre" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "aller forms its passé composé with être" },
    { "id": "comp-009", "sentence": "Nous avions fini le travail.", "target": "avions", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Tense": "Imp", "Person": "1", "Number": "Plur" }, "construction": "plus-que-parfait" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "plus-que-parfait: auxiliary in the imparfait" },
    { "id": "comp-010", "sentence": "Il avait dit non.", "target": "dit", "expect": { "lemma": "dire", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "plus-que-parfait" }, "source": "kaikki", "level": "core", "why": "after avait, dit is the participle, not the present or passé simple" },
    { "id": "comp-011", "sentence": "Elle était partie.", "target": "était", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Imp", "Person": "3" }, "construction": "plus-que-parfait" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "plus-que-parfait with être" },
    { "id": "comp-012", "sentence": "Quand il aura fini, il partira.", "target": "aura", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Tense": "Fut", "Person": "3" }, "construction": "futur-anterieur" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "futur antérieur: auxiliary in the futur" },
    { "id": "comp-013", "sentence": "Elle sera partie demain.", "target": "sera", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Fut", "Person": "3" }, "construction": "futur-anterieur" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "futur antérieur with être" },
    { "id": "comp-014", "sentence": "Il aurait mangé.", "target": "aurait", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Mood": "Cnd" }, "construction": "conditionnel-passe" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "conditionnel passé: auxiliary in the conditionnel" },
    { "id": "comp-015", "sentence": "Elle serait venue.", "target": "venue", "expect": { "lemma": "venir", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Sing" }, "construction": "conditionnel-passe" }, "source": "kaikki", "level": "core", "why": "conditionnel passé with être: the participle agrees" },
    { "id": "comp-016", "sentence": "Il faut qu'il ait fini.", "target": "ait", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Mood": "Sub", "Person": "3" }, "construction": "subjonctif-passe" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "advanced", "why": "subjonctif passé: auxiliary in the subjunctive" },
    { "id": "comp-017", "sentence": "Il faut qu'elle soit partie.", "target": "soit", "expect": { "lemma": "être", "pos": "AUX", "features": { "Mood": "Sub", "Person": "3" }, "construction": "subjonctif-passe" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "advanced", "why": "subjonctif passé with être (soit is also a conjunction)" },
    { "id": "comp-018", "sentence": "La maison est vendue.", "target": "vendue", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past", "Gender": "Fem", "Number": "Sing" }, "construction": "passive-voice" }, "alsoAcceptPos": ["ADJ"], "source": "kaikki", "level": "core", "why": "passive: être + participle agreeing with the subject" },
    { "id": "comp-019", "sentence": "Les lettres sont écrites par lui.", "target": "écrites", "expect": { "lemma": "écrire", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Plur" }, "construction": "passive-voice" }, "alsoAcceptPos": ["ADJ"], "source": "kaikki", "level": "core", "why": "passive with an agent introduced by par" },
    { "id": "comp-020", "sentence": "Il sera puni.", "target": "puni", "expect": { "lemma": "punir", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Masc" }, "construction": "passive-voice" }, "alsoAcceptPos": ["ADJ"], "source": "kaikki", "level": "core", "why": "passive in the futur" },
    { "id": "comp-021", "sentence": "Voici les lettres que j'ai écrites.", "target": "écrites", "expect": { "lemma": "écrire", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past", "Gender": "Fem", "Number": "Plur" }, "construction": "participle-agreement-preceding-object" }, "source": "kaikki", "level": "advanced", "why": "avoir + participle agrees with the preceding direct object que (lettres)" },
    { "id": "comp-022", "sentence": "Je les ai vues.", "target": "vues", "expect": { "lemma": "voir", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Plur" }, "construction": "participle-agreement-preceding-object" }, "source": "kaikki", "level": "advanced", "why": "the preceding direct-object pronoun les (feminine) makes vues agree" },
    { "id": "comp-023", "sentence": "Elle a écrit des lettres.", "target": "écrit", "expect": { "lemma": "écrire", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Masc", "Number": "Sing" }, "construction": "participle-no-agreement" }, "source": "kaikki", "level": "core", "why": "the object follows the verb: no agreement" },
    { "id": "comp-024", "sentence": "Elle les a mangés.", "target": "mangés", "expect": { "lemma": "manger", "pos": "VERB", "features": { "VerbForm": "Part", "Number": "Plur" }, "construction": "participle-agreement-preceding-object" }, "source": "kaikki", "level": "advanced", "why": "preceding direct object les makes the participle plural" },
    { "id": "comp-025", "sentence": "Elle s'est levée.", "target": "levée", "expect": { "lemma": "lever", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Sing" }, "construction": "pronominal-verb" }, "source": "kaikki", "level": "core", "why": "reflexive: the pronoun is the direct object, the participle agrees" },
    { "id": "comp-026", "sentence": "Ils se sont parlé.", "target": "parlé", "expect": { "lemma": "parler", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Masc", "Number": "Sing" }, "construction": "participle-no-agreement" }, "source": "kaikki", "level": "advanced", "why": "parler à: se is an indirect object, so no agreement" },
    { "id": "comp-027", "sentence": "Ils se sont vus.", "target": "vus", "expect": { "lemma": "voir", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Masc", "Number": "Plur" }, "construction": "pronominal-verb" }, "source": "kaikki", "level": "core", "why": "reciprocal with a direct object: agreement" },
    { "id": "comp-028", "sentence": "Nous nous sommes lavés.", "target": "lavés", "expect": { "lemma": "laver", "pos": "VERB", "features": { "VerbForm": "Part", "Number": "Plur" }, "construction": "pronominal-verb" }, "source": "kaikki", "level": "core", "why": "reflexive, plural agreement" },
    { "id": "comp-029", "sentence": "Elle a pleuré.", "target": "pleuré", "expect": { "lemma": "pleurer", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "source": "kaikki", "level": "core", "why": "passé composé of a regular verb" },
    { "id": "comp-030", "sentence": "Il est tombé.", "target": "tombé", "expect": { "lemma": "tomber", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Masc" }, "construction": "passe-compose" }, "source": "kaikki", "level": "core", "why": "tomber takes être" },
    { "id": "comp-031", "sentence": "Nous avons fini.", "target": "avons", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Person": "1", "Number": "Plur" }, "construction": "passe-compose" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "auxiliary, first person plural" },
    { "id": "comp-032", "sentence": "Elles ont dormi.", "target": "ont", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Person": "3", "Number": "Plur" }, "construction": "passe-compose" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "auxiliary, third person plural" },
    { "id": "comp-033", "sentence": "Il a été malade.", "target": "été", "expect": { "lemma": "être", "pos": "AUX", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "été after a form of avoir is the participle of être, not the noun" },
    { "id": "comp-034", "sentence": "Il a eu peur.", "target": "eu", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "participle of avoir" },
    { "id": "comp-035", "sentence": "Il a fait ses devoirs.", "target": "fait", "expect": { "lemma": "faire", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "source": "kaikki", "level": "core", "why": "after a form of avoir, fait is the participle (not the noun, not the present)" },
    { "id": "comp-036", "sentence": "Elle a pris le train.", "target": "pris", "expect": { "lemma": "prendre", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "source": "kaikki", "level": "core", "why": "participle of prendre" },
    { "id": "comp-037", "sentence": "Elle a mis la table.", "target": "mis", "expect": { "lemma": "mettre", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "source": "kaikki", "level": "core", "why": "participle of mettre" },
    { "id": "comp-038", "sentence": "Il a vu la mer.", "target": "vu", "expect": { "lemma": "voir", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "source": "kaikki", "level": "core", "why": "participle of voir" },
    { "id": "comp-039", "sentence": "Elle a dû partir.", "target": "dû", "expect": { "lemma": "devoir", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past", "Gender": "Masc" }, "construction": "passe-compose" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "dû is masculine even with a feminine subject (no agreement under avoir)" },
    { "id": "comp-040", "sentence": "Elle est née en mai.", "target": "née", "expect": { "lemma": "naître", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Sing" }, "construction": "participle-agreement-etre" }, "alsoAcceptPos": ["ADJ"], "source": "kaikki", "level": "core", "why": "naître takes être and the participle agrees" },
    { "id": "comp-041", "sentence": "Elle est morte hier.", "target": "morte", "expect": { "lemma": "mourir", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Sing" }, "construction": "participle-agreement-etre" }, "alsoAcceptPos": ["ADJ"], "source": "kaikki", "level": "advanced", "why": "morte is the participle of mourir (and also an adjective); takes être" },
    { "id": "comp-042", "sentence": "Après avoir mangé, il dort.", "target": "avoir", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "VerbForm": "Inf" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "infinitif passé: avoir in the infinitive as the auxiliary" },
    { "id": "comp-043", "sentence": "Il a plu hier.", "target": "plu", "expect": { "lemma": "pleuvoir", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" }, "construction": "passe-compose" }, "source": "kaikki", "level": "advanced", "why": "plu after a form of avoir: pleuvoir (also the participle of plaire, ambiguous in isolation)" },
    { "id": "comp-044", "sentence": "Les fleurs que tu as achetées sont belles.", "target": "achetées", "expect": { "lemma": "acheter", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Plur" }, "construction": "participle-agreement-preceding-object" }, "source": "kaikki", "level": "advanced", "why": "preceding direct object que = fleurs" },
    { "id": "comp-045", "sentence": "Quelles lettres a-t-il écrites ?", "target": "écrites", "expect": { "lemma": "écrire", "pos": "VERB", "features": { "VerbForm": "Part", "Gender": "Fem", "Number": "Plur" }, "construction": "participle-agreement-preceding-object" }, "source": "kaikki", "level": "advanced", "why": "the interrogative quelles lettres precedes the verb and is its direct object" }
  ]
}
