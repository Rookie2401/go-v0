/// <reference types="node" />
/**
 * npm run ko:known-limits: writes src/adapters/korean/generated/known-limits.ts from the common-word sweep's table
 * (test/adapters/korean/common-words.table.json: `known`, `frameKnown`, `twoSidedKnown`), the forms the pack is KNOWN to read wrongly.
 * The review gate (src/adapters/korean/review-gate.ts) holds back every reading of such a written form from GoReview.
 * test/adapters/korean/known-limits.test.ts fails when the generated file and the table are out of step: run this after the sweep regenerates its lists.
 *
 * Keys in the table:
 *   B|<sentence>|<surface>@<state>, C|<sentence>|<surface>@<state>   a block check: the surface
 *   <word>|s<k>@<state>                                                 a headword entry check: the word
 *   T|<word>|bare@<state>, T|<word>|s<k>@<state>                        a two-sided form: the word
 *   F|<noun>|<frame>|bare|sent@<state>                                  a noun + particle frame: the NOUN (the bare noun is recorded, with its frames)
 */
import fs from 'node:fs';
import path from 'node:path';

export interface KnownLimits { surfaces: string[]; frameNouns: string[] }

/** The pure part: the surfaces and frame nouns a table records. Sorted, once each. */
export function knownLimits(table: { known: string[]; frameKnown: string[]; twoSidedKnown?: string[]; entries?: Array<{ w: string; s?: Array<{ at?: string }> }>; twoSided?: Array<{ w: string; s?: Array<{ at?: string }> }> }): KnownLimits {
  const surfaces = new Set<string>();
  const frameNouns = new Set<string>();
  for (const key of [...table.known, ...(table.twoSidedKnown ?? []), ...table.frameKnown]) {
    const p = key.split('|');
    const strip = (s: string): string => s.replace(/@[a-z]+$/u, '');
    if (/^[BCK]$/u.test(p[0])) surfaces.add(strip(p[2] ?? ''));
    else if (p[0] === 'T') { surfaces.add(strip(p[1] ?? '')); const k = /^s([0-9]+)/u.exec(strip(p[2] ?? '')); const at = k ? table.twoSided?.find((e) => e.w === strip(p[1] ?? ''))?.s?.[Number(k[1])]?.at : undefined; if (at) surfaces.add(at); }
    else if (p[0] === 'F') frameNouns.add(strip(p[1] ?? ''));
    else {
      surfaces.add(p[0]);
      // the check's own written form (성|s1 is the sentence 성을, 이르다|s1 is 일러요): the headword alone would not hold it
      const k = /^s([0-9]+)/u.exec(strip(p[1] ?? ''));
      const at = k ? table.entries?.find((e) => e.w === p[0])?.s?.[Number(k[1])]?.at : undefined;
      if (at) surfaces.add(at);
    }
  }
  surfaces.delete(''); frameNouns.delete('');
  const order = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0);
  return { surfaces: [...surfaces].sort(order), frameNouns: [...frameNouns].sort(order) };
}

export const TABLE_PATH = path.resolve(__dirname, '../test/adapters/korean/common-words.table.json');
export const OUT_PATH = path.resolve(__dirname, '../src/adapters/korean/generated/known-limits.ts');

/** The text of the generated file for a table. */
export function render(limits: KnownLimits): string {
  return [
    '/* GENERATED by scripts/ko-known-limits.mts from test/adapters/korean/common-words.table.json (known, frameKnown, twoSidedKnown) - do not edit.',
    ' * The written forms the pack is KNOWN to read wrongly (the common-word sweep records them). The review gate holds their readings back from GoReview. */',
    `export const KO_KNOWN_SURFACES: readonly string[] = ${JSON.stringify(limits.surfaces)};`,
    '/** Nouns whose noun + particle frames the sweep records as read wrongly. */',
    `export const KO_KNOWN_FRAME_NOUNS: readonly string[] = ${JSON.stringify(limits.frameNouns)};`,
    '',
  ].join('\n');
}

if (!process.env.VITEST) {
  const table = JSON.parse(fs.readFileSync(TABLE_PATH, 'utf8'));
  const limits = knownLimits(table);
  fs.writeFileSync(OUT_PATH, render(limits));
  console.log(`known-limits.ts: ${limits.surfaces.length} surfaces, ${limits.frameNouns.length} frame nouns`);
}
