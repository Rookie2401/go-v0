node_modules
dist
dist-review
node_modules/.tmp
*.local
# learner-supplied copies of published works: never committed, never bundled
data/private/
# downloaded dictionary sources and the shards built from them
data/dictionaries/
public/dict/
# the built library (documents, profiles, index): regenerated by npm run library:build
public/library/
# gold data derived from the dictionary source (CC BY-SA): regenerated, never committed
data/benchmarks/th/generated/
# raw evaluation dumps
data/review/th/*-eval-*.json
# extracts of the Spanish dictionary source for review (CC BY-SA): regenerated by scripts/es-regional.mts, never committed
data/review/es/generated/
# research and validation material (treebanks, reference editions): never committed, never bundled, never course text
data/research/
# reviewer packets (printable HTML and return files, with names and corrections): npm run review:packet
data/review/*/packets/

# GoRead team server data (sqlite, team codes)
data/goread/
# the keeper's Cloudflare config (holds the D1 database id): docs/goread/DEPLOY.md
wrangler.toml
.wrangler/

# Go Repository service data (sqlite + smoke runs)
data/repository/
packages/golearn-extension/dist-web/
data/local-repository/

# Go Repository backups written by scripts/ops/backup.mts (default --out)
/backups/
