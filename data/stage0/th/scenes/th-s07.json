    {
      "id": "n1",
      "kind": "grammar",
      "title": "มี and ไม่มี",
      "text": "มี means \"to have\" and also \"there is\": มีชา (there is tea). ไม่มี is \"do not have; there is none\". ไม่ always comes just before the word it makes negative.",
      "explains": [
        "th.have-mi"
      ],
      "afterScenes": 1
    },
    {
      "id": "n2",
      "kind": "usage",
      "title": "ขอ … ครับ",
      "text": "ขอ means \"to ask for\". ขอชาครับ is a polite way to ask for tea: \"could I have tea?\". It works for anything you want to be given.",
      "explains": [
        "th.request-kho"
      ],
      "afterScenes": 1
    }
  ],
