      "paragraphs": [
        {
          "sentences": [
            {
              "text": "— Përshëndetje! Unë quhem Marku.",
              "english": "\"Hello! My name is Mark."
            },
            {
              "text": "Si quheni ju?",
              "english": "What is your name?\""
            },
            {
              "text": "— Unë quhem Dritan.",
              "english": "\"My name is Dritan."
            },
            {
              "text": "Gëzohem që ju njoh.",
              "english": "I am glad to meet you.\""
            },
            {
              "text": "— Edhe unë gëzohem.",
              "english": "\"I am glad too."
            }
          ]
        },
        {
          "sentences": [
            {
              "text": "Nga jeni?",
              "english": "Where are you from?\""
            },
            {
              "text": "— Jam nga Tirana.",
              "english": "\"I am from Tirana."
            },
            {
              "text": "Po ju?",
              "english": "And you?\""
            },
            {
              "text": "— Unë jam nga Amerika.",
              "english": "\"I am from America."
            },
            {
              "text": "Tani jetoj në Tiranë.",
              "english": "Now I live in Tirana.\""
            }
          ]
        },
        {
          "sentences": [
            {
              "text": "— A flisni shqip?",
              "english": "\"Do you speak Albanian?\""
            },
            {
              "text": "— Flas pak.",
              "english": "\"I speak a little."
            },
            {
              "text": "Po mësoj.",
              "english": "I am learning.\""
            },
            {
              "text": "— Flisni mirë!",
              "english": "\"You speak well!\""
            },
            {
              "text": "— Faleminderit.",
              "english": "\"Thank you.\""
            }
          ]
        }
      ]
    }
