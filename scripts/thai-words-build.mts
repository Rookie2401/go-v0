/**
 * Builds src/adapters/thai/dictionary-words-data.ts: every Thai-script headword of the installed Thai dictionary
 * (public/dict/th, built from Wiktionary via kaikki.org, CC BY-SA 4.0) with its parts of speech in the dictionary's order.
 * Headwords and parts of speech only: no definitions, pronunciations or examples (the card asks the dictionary for those).
 *
 *   npx vite-node scripts/thai-words-build.mts            write the module
 *   npx vite-node scripts/thai-words-build.mts --check    compare only; exit 1 when the module differs
 *
 * Line format: `<headword>\t<codes>`; one letter per part of speech (CODES below), the dictionary's first first.
 * Skipped: headwords with a space or any letter outside the Thai block, and the part of speech X.
 */
import fs from 'node:fs';
import path from 'node:path';

const DIR = 'public/dict/th';
const OUT = 'src/adapters/thai/dictionary-words-data.ts';
export const CODES: Readonly<Record<string, string>> = {
  NOUN: 'N', VERB: 'V', ADJ: 'A', PROPN: 'P', ADV: 'D', INTJ: 'I', CLF: 'C', NUM: 'M', PRON: 'R', ADP: 'S', CONJ: 'J', PART: 'T', DET: 'E',
};
const THAI_WORD = /^[ก-๛]+$/u;

const manifest = JSON.parse(fs.readFileSync(path.join(DIR, 'manifest.json'), 'utf8')) as { id: string; entries: number; source?: { sha256?: string; lastModified?: string } };
const words = new Map<string, string>();
for (const f of fs.readdirSync(DIR).filter((n) => /^s-[0-9a-f]{2}\.json$/.test(n)).sort()) {
  const shard = JSON.parse(fs.readFileSync(path.join(DIR, f), 'utf8')) as Record<string, Array<{ p?: string }>>;
  for (const [head, entries] of Object.entries(shard)) {
    const w = head.normalize('NFC');
    if (!THAI_WORD.test(w)) continue;
    let codes = words.get(w) ?? '';
    for (const e of entries) { const c = e.p ? CODES[e.p] : undefined; if (c && !codes.includes(c)) codes += c; }
    if (codes) words.set(w, codes);
  }
}
const lines = [...words].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)).map(([w, c]) => `${w}\t${c}`);
const body = `/**
 * GENERATED by scripts/thai-words-build.mts from the installed Thai dictionary ${manifest.id} (${manifest.entries} entries; source
 * sha256 ${manifest.source?.sha256 ?? 'unknown'}). Wiktionary, via kaikki.org — CC BY-SA 4.0. Headwords and parts of speech only.
 * Line: headword TAB codes (N noun, V verb, A adjective, P proper noun, D adverb, I interjection, C classifier, M numeral, R pronoun,
 * S adposition, J conjunction, T particle, E determiner), the dictionary's first part of speech first. Do not edit by hand.
 */
export const THAI_DICTIONARY_ID = ${JSON.stringify(manifest.id)};
export const THAI_DICTIONARY_WORDS = ${JSON.stringify(lines.join('\n'))};
`;
if (process.argv.includes('--check')) {
  const same = fs.existsSync(OUT) && fs.readFileSync(OUT, 'utf8') === body;
  console.log(JSON.stringify({ words: lines.length, same }));
  if (!same) process.exitCode = 1;
} else {
  fs.writeFileSync(OUT, body);
  console.log(JSON.stringify({ words: lines.length, bytes: Buffer.byteLength(body), out: OUT }));
}
