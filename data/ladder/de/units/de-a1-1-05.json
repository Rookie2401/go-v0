      "title": "Bei Marta",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Es ist Sonntag.",
              "english": "It is Sunday."
            },
            {
              "text": "Anna, Lukas, Ben und Sam sind bei Marta.",
              "english": "Anna, Lukas, Ben and Sam are at Marta's."
            },
            {
              "speaker": "marta",
              "text": "Guten Tag!",
              "english": "Good day!"
            },
            {
              "speaker": "marta",
              "text": "Kommt, kommt!",
              "english": "Come in, come in!"
            },
            {
              "speaker": "marta",
              "text": "Das Mittagessen ist da!",
              "english": "Lunch is ready!"
            },
            {
              "speaker": "ben",
              "text": "Oma, ich habe Hunger!",
              "english": "Grandma, I am hungry!"
            },
            {
              "speaker": "marta",
              "text": "Ich weiß, Ben.",
              "english": "I know, Ben."
            },
            {
              "speaker": "marta",
              "text": "Ich koche gern am Sonntag.",
              "english": "I like cooking on Sundays."
            },
            {
              "speaker": "sam",
              "text": "Es ist sehr schön hier, Marta.",
              "english": "It is very nice here, Marta."
            },
            {
              "speaker": "marta",
              "text": "Danke, Sam.",
              "english": "Thank you, Sam."
            },
            {
              "speaker": "marta",
              "text": "Das Haus ist klein, aber so schön.",
              "english": "The house is small, but so nice."
            },
            {
              "speaker": "anna",
              "text": "Was gibt es heute zum Mittagessen?",
              "english": "What is there for lunch today?"
            },
            {
              "speaker": "marta",
              "text": "Es gibt Suppe, Kartoffeln und Fleisch.",
              "english": "There is soup, potatoes and meat."
            },
            {
              "speaker": "ben",
              "text": "Und Kuchen!",
              "english": "And cake!"
            },
            {
              "speaker": "marta",
              "text": "Ja!",
              "english": "Yes!"
            }
          ]
        }
      ]
    },
    {
      "title": "Am Tisch",
      "paragraphs": [
        {
          "sentences": [
            {
              "speaker": "marta",
              "text": "Nehmt Suppe!",
              "english": "Take some soup!"
            },
            {
              "speaker": "sam",
              "text": "Danke, Marta.",
              "english": "Thank you, Marta."
            },
            {
              "speaker": "sam",
              "text": "Die Suppe ist so lecker!",
              "english": "The soup is so tasty!"
            },
            {
              "speaker": "lukas",
              "text": "Du kochst sehr gut, Marta.",
              "english": "You cook very well, Marta."
            },
            {
              "speaker": "anna",
              "text": "Das Fleisch ist auch lecker.",
              "english": "The meat is tasty too."
            },
            {
              "speaker": "ben",
              "text": "Ich esse Kartoffeln, aber ich esse kein Fleisch.",
              "english": "I eat potatoes, but I do not eat meat."
            },
            {
              "speaker": "marta",
              "text": "Nimm Kartoffeln, Ben.",
              "english": "Take potatoes, Ben."
            },
            {
              "speaker": "sam",
              "text": "Zum Frühstück esse ich ein Brötchen mit Butter.",
              "english": "For breakfast I eat a roll with butter."
            },
            {
              "speaker": "sam",
              "text": "Das Mittagessen ist so lecker!",
