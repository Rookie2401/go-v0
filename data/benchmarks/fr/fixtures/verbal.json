    { "id": "verb-069", "sentence": "Il irait à Paris.", "target": "irait", "expect": { "lemma": "aller", "pos": "VERB", "features": { "Mood": "Cnd" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "aller conditionnel" },
