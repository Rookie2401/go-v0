    {"text":"Cuando llegué a casa, mi madre ya había salido.","tokens":["Cuando","llegué","a","casa","mi","madre","ya","había","salido"],"heads":[1,8,3,1,5,8,8,8,-1],"relations":["mark","advcl","case","obl","det","nsubj","advmod","aux","root"]},
    {"text":"El niño que vive al lado es muy simpático.","tokens":["El","niño","que","vive","al","lado","es","muy","simpático"],"heads":[1,8,3,1,5,3,8,8,-1],"relations":["det","nsubj","nsubj","acl","case","obl","cop","advmod","root"]},
    {"text":"Mis amigos y yo jugamos al fútbol los sábados.","tokens":["Mis","amigos","y","yo","jugamos","al","fútbol","los","sábados"],"heads":[1,4,3,1,-1,6,4,8,4],"relations":["det","nsubj","cc","conj","root","case","obl","det","obl"]},
    {"text":"¿Quién te dio esta información?","tokens":["Quién","te","dio","esta","información"],"heads":[2,2,-1,4,2],"relations":["nsubj","iobj","root","det","obj"]},
