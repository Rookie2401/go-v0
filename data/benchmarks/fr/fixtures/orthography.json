{
  "category": "orthography",
  "note": "Accents, ligatures, apostrophes, elision, whole words with an apostrophe, hyphen compounds, hyphen clitics, capitals, NFD input. `expect.tokens` is the exact list of word-token surfaces (hyphens are non-word tokens, elisions keep their apostrophe) per the contract in docs/french/PLAN.md. Written from grammar; an AI's judgement, not native-reviewed.",
  "cases": [
    { "id": "orth-001", "sentence": "La côte est belle.", "target": "côte", "expect": { "lemma": "côte", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "côte (coast, rib) keeps its circumflex: a different word from cote and côté" },
    { "id": "orth-002", "sentence": "Le côté gauche est faible.", "target": "côté", "expect": { "lemma": "côté", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "côté (side) is masculine and is not côte" },
    { "id": "orth-003", "sentence": "Cette cote est élevée.", "target": "cote", "expect": { "lemma": "cote", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "cote (rating, quota) without accent; after the feminine determiner it is the noun, not a form of coter" },
    { "id": "orth-004", "sentence": "Il a faim.", "target": "a", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Person": "3", "Number": "Sing" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "a without accent is the third person singular of avoir" },
    { "id": "orth-005", "sentence": "Il va à Paris.", "target": "à", "expect": { "lemma": "à", "pos": "ADP" }, "source": "grammar", "level": "core", "why": "à with the grave accent is the preposition, not a form of avoir" },
    { "id": "orth-006", "sentence": "Tu veux du thé ou du café ?", "target": "ou", "expect": { "lemma": "ou", "pos": "CONJ" }, "source": "grammar", "level": "core", "why": "ou without accent is the coordinating conjunction (or)" },
    { "id": "orth-007", "sentence": "Où vas-tu ?", "target": "où", "expect": { "lemma": "où", "pos": "ADV", "tokens": ["Où", "vas", "tu"] }, "source": "grammar", "level": "core", "why": "où with the grave accent is the adverb (where)" },
    { "id": "orth-008", "sentence": "Il a dû partir.", "target": "dû", "expect": { "lemma": "devoir", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past", "Gender": "Masc" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "dû with the circumflex is the masculine past participle of devoir; du (no accent) is the contraction" },
    { "id": "orth-009", "sentence": "Je suis sûr de lui.", "target": "sûr", "expect": { "lemma": "sûr", "pos": "ADJ" }, "source": "kaikki", "level": "core", "why": "sûr (certain) keeps its circumflex; sur is the preposition" },
    { "id": "orth-010", "sentence": "Le livre est sur la table.", "target": "sur", "expect": { "lemma": "sur", "pos": "ADP" }, "source": "grammar", "level": "core", "why": "sur without accent is the preposition (on)" },
    { "id": "orth-011", "sentence": "Mon cœur bat vite.", "target": "cœur", "expect": { "lemma": "cœur", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "the ligature œ is part of the spelling of cœur" },
    { "id": "orth-012", "sentence": "Mon coeur bat vite.", "target": "coeur", "expect": { "lemma": "cœur", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "advanced", "why": "a page that writes oe for œ (keyboard) must still reach the lemma cœur; the page spelling itself is never rewritten" },
    { "id": "orth-013", "sentence": "Cette œuvre est célèbre.", "target": "œuvre", "expect": { "lemma": "œuvre", "pos": "NOUN" }, "source": "kaikki", "level": "core", "why": "œuvre with the ligature" },
    { "id": "orth-014", "sentence": "Cette oeuvre est célèbre.", "target": "oeuvre", "expect": { "lemma": "œuvre", "pos": "NOUN" }, "source": "kaikki", "level": "advanced", "why": "page spelling oe for œ reaches the lemma œuvre" },
    { "id": "orth-015", "sentence": "Ma sœur dort.", "target": "sœur", "expect": { "lemma": "sœur", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "sœur with the ligature, feminine" },
    { "id": "orth-016", "sentence": "Ma soeur dort.", "target": "soeur", "expect": { "lemma": "sœur", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "advanced", "why": "page spelling oe for œ reaches the lemma sœur" },
    { "id": "orth-017", "sentence": "L'homme aime le vin.", "target": "l'", "expect": { "lemma": "le", "pos": "DET", "tokens": ["L'", "homme", "aime", "le", "vin"] }, "source": "grammar", "level": "core", "why": "an elided article is its own token keeping the apostrophe: l'homme is l' + homme" },
    { "id": "orth-018", "sentence": "L’homme aime le vin.", "target": "l'", "expect": { "lemma": "le", "pos": "DET", "tokens": ["L’", "homme", "aime", "le", "vin"] }, "source": "grammar", "level": "core", "why": "the typographic apostrophe cuts the word the same way and the surface keeps the page's own character; the normalized form is the same as with the straight one" },
    { "id": "orth-019", "sentence": "J'aime le thé.", "target": "j'", "expect": { "lemma": "je", "pos": "PRON", "tokens": ["J'", "aime", "le", "thé"] }, "source": "grammar", "level": "core", "why": "j' is the elided je" },
    { "id": "orth-020", "sentence": "Je sais qu'il vient.", "target": "qu'", "expect": { "lemma": "que", "pos": "SCONJ", "tokens": ["Je", "sais", "qu'", "il", "vient"] }, "alsoAcceptPos": ["CONJ"], "source": "grammar", "level": "core", "why": "qu' is the elided conjunction que" },
    { "id": "orth-021", "sentence": "Il n'est pas là.", "target": "n'", "expect": { "lemma": "ne", "pos": "ADV", "tokens": ["Il", "n'", "est", "pas", "là"] }, "alsoAcceptPos": ["PART"], "source": "grammar", "level": "core", "why": "n' is the elided negation ne" },
    { "id": "orth-022", "sentence": "S'il vient, je pars.", "target": "s'", "expect": { "lemma": "si", "pos": "SCONJ", "tokens": ["S'", "il", "vient", "je", "pars"] }, "alsoAcceptPos": ["CONJ"], "source": "grammar", "level": "core", "why": "si elides only before il and ils: s'il" },
    { "id": "orth-023", "sentence": "Il parle d'un ami.", "target": "d'", "expect": { "lemma": "de", "pos": "ADP", "tokens": ["Il", "parle", "d'", "un", "ami"] }, "source": "grammar", "level": "core", "why": "d' is the elided preposition de" },
    { "id": "orth-024", "sentence": "Il marche jusqu'à la gare.", "target": "jusqu'", "expect": { "lemma": "jusque", "pos": "ADP", "tokens": ["Il", "marche", "jusqu'", "à", "la", "gare"] }, "alsoAcceptPos": ["ADV"], "source": "kaikki", "level": "core", "why": "jusqu' is the elided jusque; à is a separate token" },
    { "id": "orth-025", "sentence": "Lorsqu'il arrive, nous partons.", "target": "lorsqu'", "expect": { "lemma": "lorsque", "pos": "SCONJ", "tokens": ["Lorsqu'", "il", "arrive", "nous", "partons"] }, "alsoAcceptPos": ["CONJ"], "source": "kaikki", "level": "core", "why": "lorsqu' is the elided lorsque" },
    { "id": "orth-026", "sentence": "Je pars aujourd'hui.", "target": "aujourd'hui", "expect": { "lemma": "aujourd'hui", "pos": "ADV", "tokens": ["Je", "pars", "aujourd'hui"] }, "source": "kaikki", "level": "core", "why": "a lexical word with an apostrophe stays one token and one lemma" },
    { "id": "orth-027", "sentence": "Quelqu'un frappe à la porte.", "target": "quelqu'un", "expect": { "lemma": "quelqu'un", "pos": "PRON", "tokens": ["Quelqu'un", "frappe", "à", "la", "porte"] }, "source": "kaikki", "level": "core", "why": "quelqu'un is one word although it contains an apostrophe" },
    { "id": "orth-028", "sentence": "Il est peut-être malade.", "target": "peut-être", "expect": { "lemma": "peut-être", "pos": "ADV", "tokens": ["Il", "est", "peut-être", "malade"] }, "source": "kaikki", "level": "core", "why": "a hyphenated compound is one token; it is not peut + être" },
    { "id": "orth-029", "sentence": "C'est-à-dire que je pars.", "target": "c'est-à-dire", "expect": { "tokens": ["C'est-à-dire", "que", "je", "pars"] }, "source": "grammar", "level": "advanced", "why": "c'est-à-dire is one token (a fixed compound written with hyphens and an apostrophe)" },
    { "id": "orth-030", "sentence": "Ma grand-mère chante.", "target": "grand-mère", "expect": { "lemma": "grand-mère", "pos": "NOUN", "features": { "Gender": "Fem" }, "tokens": ["Ma", "grand-mère", "chante"] }, "source": "kaikki", "level": "core", "why": "a hyphenated compound noun is one token" },
    { "id": "orth-031", "sentence": "Donne-le-moi !", "target": "donne", "expect": { "lemma": "donner", "pos": "VERB", "features": { "Mood": "Imp", "Person": "2", "Number": "Sing" }, "tokens": ["Donne", "le", "moi"] }, "source": "kaikki", "level": "core", "why": "a hyphen clitic is its own token without the hyphen; the verb is the imperative donne" },
    { "id": "orth-032", "sentence": "Donne-le-moi !", "target": "le", "expect": { "lemma": "le", "pos": "PRON", "features": { "Case": "Acc" } }, "source": "grammar", "level": "advanced", "why": "le after an imperative is the direct-object pronoun, not the article" },
    { "id": "orth-033", "sentence": "A-t-il faim ?", "target": "a", "expect": { "lemma": "avoir", "pos": "VERB", "tokens": ["A", "t", "il", "faim"] }, "alsoAcceptPos": ["AUX"], "source": "grammar", "level": "core", "why": "a-t-il: the euphonic t is its own token between two hyphens; the verb is avoir" },
    { "id": "orth-034", "sentence": "Qu'est-ce que tu veux ?", "target": "qu'", "expect": { "tokens": ["Qu'", "est", "ce", "que", "tu", "veux"] }, "source": "grammar", "level": "core", "why": "qu'est-ce que is cut qu' · est · ce · que" },
    { "id": "orth-035", "sentence": "Y a-t-il du pain ?", "target": "y", "expect": { "lemma": "y", "pos": "PRON", "tokens": ["Y", "a", "t", "il", "du", "pain"] }, "source": "grammar", "level": "core", "why": "inverted il y a: y · a · t · il" },
    { "id": "orth-036", "sentence": "Va-t'en !", "target": "va", "expect": { "lemma": "aller", "pos": "VERB", "tokens": ["Va", "t'", "en"] }, "alsoAcceptPos": ["AUX"], "source": "grammar", "level": "advanced", "why": "va-t'en: the elided clitic t' keeps its apostrophe, the hyphens are non-word tokens" },
    { "id": "orth-037", "sentence": "Est-ce vrai ?", "target": "est", "expect": { "lemma": "être", "pos": "AUX", "tokens": ["Est", "ce", "vrai"] }, "alsoAcceptPos": ["VERB"], "source": "grammar", "level": "core", "why": "est-ce is cut est · ce" },
    { "id": "orth-038", "sentence": "Cet homme-là est grand.", "target": "là", "expect": { "lemma": "là", "pos": "ADV", "tokens": ["Cet", "homme", "là", "est", "grand"] }, "alsoAcceptPos": ["PART"], "source": "grammar", "level": "advanced", "why": "-là written on a noun is its own token without the hyphen" },
    { "id": "orth-039", "sentence": "LA MAISON EST GRANDE.", "target": "MAISON", "expect": { "lemma": "maison", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "capitals are normalized by lower-casing; the surface is untouched" },
    { "id": "orth-040", "sentence": "Écoute !", "target": "Écoute", "expect": { "lemma": "écouter", "pos": "VERB", "features": { "Mood": "Imp" } }, "source": "kaikki", "level": "core", "why": "a capital with an accent (É) lower-cases to é" },
    { "id": "orth-041", "sentence": "L'École est fermée.", "target": "École", "expect": { "lemma": "école", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "a capitalised noun after an elision" },
    { "id": "orth-042", "sentence": "Le père dort.", "target": "père", "expect": { "lemma": "père", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "NFD input (e + combining grave) must behave as è" },
    { "id": "orth-043", "sentence": "Elle a vécu ici.", "target": "vécu", "expect": { "lemma": "vivre", "pos": "VERB", "features": { "VerbForm": "Part", "Tense": "Past" } }, "source": "kaikki", "level": "core", "why": "NFD input (e + combining acute) must behave as é" },
    { "id": "orth-044", "sentence": "Une école ferme.", "target": "école", "expect": { "lemma": "école", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "NFD input at the start of a word" },
    { "id": "orth-045", "sentence": "Il est né à Saint-Denis.", "target": "Saint-Denis", "expect": { "pos": "PROPN", "tokens": ["Il", "est", "né", "à", "Saint-Denis"] }, "source": "grammar", "level": "advanced", "why": "a hyphenated place name is one token and a proper noun" },
    { "id": "orth-046", "sentence": "Quatre-vingt-dix élèves sont là.", "target": "quatre-vingt-dix", "expect": { "tokens": ["Quatre-vingt-dix", "élèves", "sont", "là"] }, "source": "grammar", "level": "core", "why": "a hyphenated numeral is one token" },
    { "id": "orth-047", "sentence": "Nous irons là-bas.", "target": "là-bas", "expect": { "lemma": "là-bas", "pos": "ADV", "tokens": ["Nous", "irons", "là-bas"] }, "source": "kaikki", "level": "core", "why": "là-bas is one lexical word (contrast with homme-là)" },
    { "id": "orth-048", "sentence": "Je l'ai vu.", "target": "l'", "expect": { "lemma": "le", "pos": "PRON", "tokens": ["Je", "l'", "ai", "vu"] }, "source": "grammar", "level": "core", "why": "before a verb, elided l' is the object pronoun, not the article" },
    { "id": "orth-049", "sentence": "Dis-le-lui.", "target": "dis", "expect": { "lemma": "dire", "pos": "VERB", "features": { "Mood": "Imp" }, "tokens": ["Dis", "le", "lui"] }, "source": "kaikki", "level": "core", "why": "two hyphen clitics after an imperative" },
    { "id": "orth-050", "sentence": "Il est peut‑être malade.", "target": "peut-être", "expect": { "lemma": "peut-être", "pos": "ADV", "tokens": ["Il", "est", "peut‑être", "malade"] }, "source": "grammar", "level": "advanced", "why": "a non-breaking hyphen (U+2011) is the same hyphen: one token, same identity" },
    { "id": "orth-051", "sentence": "Qu’est-ce que c’est ?", "target": "c'", "expect": { "lemma": "ce", "pos": "PRON", "tokens": ["Qu’", "est", "ce", "que", "c’", "est"] }, "source": "grammar", "level": "core", "why": "typographic apostrophes in a hyphen cluster; c' is the elided ce" },
    { "id": "orth-052", "sentence": "Il y avait du monde aujourd’hui.", "target": "aujourd'hui", "expect": { "lemma": "aujourd'hui", "pos": "ADV", "tokens": ["Il", "y", "avait", "du", "monde", "aujourd’hui"] }, "source": "grammar", "level": "core", "why": "the typographic apostrophe inside a whole word: same token, same identity" }
  ]
}
