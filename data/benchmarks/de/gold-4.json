    { "id": "r4-03", "category": "native prose (Kafka)", "text": "Was aber sollte er jetzt tun?",
      "tokens": [
        { "form": "sollte", "lemma": "sollen", "pos": "AUX", "morph": { "Person": "3", "Number": "Sing" } },
        { "form": "tun", "lemma": "tun", "pos": "VERB", "morph": { "VerbForm": "Inf" } },
