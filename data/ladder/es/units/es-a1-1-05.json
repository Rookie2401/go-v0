      "paragraphs": [
        {
          "sentences": [
            {
              "text": "El domingo, la familia come en la casa de doña Marta.",
              "english": "On Sunday the family eats at doña Marta's house."
            },
            {
              "text": "La mesa es grande.",
              "english": "The table is big."
            },
            {
              "text": "Doña Marta tiene sopa de pollo.",
              "english": "Doña Marta has chicken soup."
            },
            {
              "text": "También tiene arroz, frijoles y tortillas.",
              "english": "She also has rice, beans and tortillas."
            },
            {
              "text": "Hay tamales en un plato grande.",
              "english": "There are tamales on a big plate."
            },
            {
              "text": "Sam está con su amigo Daniel.",
              "english": "Sam is with his friend Daniel."
            },
            {
              "text": "Ana, Luis y Nico también están en la casa.",
              "english": "Ana, Luis and Nico are in the house too."
            },
            {
              "text": "El papá de Ana es Ricardo, el hijo de doña Marta.",
              "english": "Ana's dad is Ricardo, doña Marta's son."
            },
            {
              "text": "Su mamá es la señora Isabel.",
              "english": "Her mom is señora Isabel."
            }
          ]
        },
        {
          "sentences": [
            {
              "speaker": "ana",
              "text": "Buenas tardes, abuela.",
              "english": "Good afternoon, grandma."
