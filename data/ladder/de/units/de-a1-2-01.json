    {
      "title": "Am Bahnhof",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Am Morgen fährt Sam gerade mit der Straßenbahn zum Bahnhof.",
              "english": "In the morning Sam is just taking the tram to the station."
            },
            {
              "text": "Er hat eine Fahrkarte.",
              "english": "He has a ticket."
            },
            {
              "text": "Die Haltestelle ist in der Straße.",
              "english": "The stop is in the street."
            },
            {
              "text": "Die Straßenbahn fährt in zwei Minuten ab.",
              "english": "The tram leaves in two minutes."
            },
            {
              "text": "Der Zug aus Berlin kommt um acht Uhr an.",
              "english": "The train from Berlin arrives at eight o'clock."
            },
            {
              "text": "Sam muss um acht Uhr da sein.",
              "english": "Sam has to be there at eight o'clock."
            },
            {
              "speaker": "sam",
              "text": "Hallo, Daniel!",
              "english": "Hello, Daniel!"
            },
            {
              "speaker": "sam",
              "text": "Ich bin Sam.",
              "english": "I am Sam."
            },
            {
              "speaker": "daniel",
              "text": "Hallo, Sam!",
              "english": "Hello, Sam!"
            },
            {
              "speaker": "daniel",
              "text": "Freut mich!",
              "english": "Nice to meet you!"
            },
            {
              "speaker": "sam",
              "text": "Der Zug ist schon da.",
              "english": "How are you?"
            },
            {
              "speaker": "sam",
              "text": "Soll ich deine Tasche nehmen?",
              "english": "Shall I take your bag?"
            },
            {
              "speaker": "daniel",
              "text": "Gut, danke.",
              "english": "Fine, thank you."
            },
            {
              "speaker": "daniel",
              "text": "Ich bin müde, aber ich bin da.",
              "english": "I am tired, but I am here."
            },
            {
              "speaker": "daniel",
              "text": "Ich spreche nur: Hallo!",
              "english": "I only speak: hello!"
            },
            {
              "speaker": "daniel",
              "text": "Ich telefoniere mit meiner Mama in den USA.",
              "english": "I phone my mama in the USA."
            },
            {
              "speaker": "sam",
              "text": "Ich lerne auch noch.",
              "english": "I am still learning too."
            },
            {
              "speaker": "sam",
              "text": "Wir können zusammen lernen.",
              "english": "We can learn together."
            },
            {
              "speaker": "daniel",
              "text": "Wo ist unsere Gemeinde?",
              "english": "Where is our church?"
            },
            {
              "speaker": "sam",
              "text": "Unsere Gemeinde ist in der Stadt.",
              "english": "Our church is in the city."
            },
            {
              "speaker": "sam",
              "text": "Da siehst du sie.",
              "english": "There you can see it."
            },
            {
              "speaker": "sam",
              "text": "Thomas ist unser Pastor.",
              "english": "Thomas is our pastor."
            },
            {
              "speaker": "sam",
              "text": "In der Woche helfen wir in der Gemeinde.",
              "english": "During the week we help at the church."
            },
            {
              "speaker": "sam",
              "text": "Am Sonntag fängt der Gottesdienst um zehn Uhr an.",
              "english": "On Sunday the service starts at ten o'clock."
            },
            {
              "speaker": "sam",
              "text": "Wir singen Lieder und beten.",
              "english": "We sing songs and pray."
            },
            {
              "speaker": "sam",
              "text": "Die Musik ist schön.",
              "english": "The music is lovely."
            },
            {
              "speaker": "sam",
              "text": "Du kannst auch singen.",
              "english": "You can sing too."
            },
            {
              "speaker": "daniel",
              "text": "Ich habe auch eine Bibel.",
              "english": "I have a Bible too."
            },
            {
              "speaker": "sam",
              "text": "Gut.",
              "english": "Good."
            },
            {
              "speaker": "sam",
              "text": "Du bist ein Freund, Daniel!",
              "english": "You are a friend, Daniel!"
            },
            {
              "speaker": "sam",
              "text": "Wir spielen auch gern im Park.",
              "english": "We like playing in the park too."
            },
            {
              "speaker": "daniel",
              "text": "Das ist schön.",
              "english": "That is nice."
            },
            {
              "speaker": "daniel",
              "text": "Aber ich habe Hunger, und mein Bauch tut weh.",
              "english": "But I am hungry, and my stomach hurts."
            },
            {
              "speaker": "daniel",
              "text": "Ich will Brot!",
              "english": "I want bread!"
            },
            {
              "speaker": "sam",
              "text": "Wir gehen in die Bäckerei zu Herrn Schmidt.",
              "english": "We are going to the bakery to Herr Schmidt."
            },
            {
              "speaker": "sam",
              "text": "Da gibt es Brötchen mit Butter und Käse, und Kaffee mit Milch.",
              "english": "There are rolls with butter and cheese, and coffee with milk."
            },
            {
              "speaker": "sam",
              "text": "Dann schläfst du.",
              "english": "Then you sleep."
            },
            {
              "speaker": "sam",
              "text": "Unser Haus ist nicht groß, aber das Bett ist da.",
              "english": "Our house is not big, but the bed is there."
            },
            {
              "speaker": "daniel",
              "text": "Danke, Sam!",
              "english": "Thank you, Sam!"
            },
            {
              "speaker": "daniel",
              "text": "Tschüs!",
              "english": "Bye!"
            }
          ]
        }
