      "title": "Anna ruft an",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Es ist Abend.",
              "english": "It is evening."
            },
            {
              "text": "Sam ist in seinem Zimmer.",
              "english": "Sam is in his room."
            },
            {
              "text": "Das Handy ist da, und Anna ruft an.",
              "english": "The phone is there, and Anna calls."
            },
            {
              "speaker": "anna",
              "text": "Hallo, Sam!",
              "english": "Hello, Sam!"
            },
            {
              "speaker": "anna",
              "text": "Was machst du gerade?",
              "english": "What are you doing right now?"
            },
            {
              "speaker": "sam",
              "text": "Hallo, Anna!",
              "english": "Hello, Anna!"
            },
            {
              "speaker": "sam",
              "text": "Ich lese gerade.",
              "english": "I am reading right now."
            },
            {
              "speaker": "anna",
              "text": "Was liest du?",
              "english": "What are you reading?"
            },
            {
              "speaker": "sam",
              "text": "Ich lese nur die Bibel.",
              "english": "I am only reading the Bible."
            },
            {
              "speaker": "sam",
              "text": "Und ich höre Musik.",
              "english": "And I am listening to music."
            },
            {
              "speaker": "anna",
              "text": "Hörst du mich?",
              "english": "Can you hear me?"
            },
            {
              "speaker": "anna",
              "text": "Das Handy ist nicht gut.",
              "english": "The phone is not good."
            },
            {
              "speaker": "sam",
              "text": "Ja, ich höre dich gut.",
              "english": "Yes, I can hear you well."
            },
            {
              "speaker": "anna",
              "text": "Hast du Zeit?",
              "english": "Do you have time?"
            },
            {
              "speaker": "sam",
              "text": "Ja, ich habe Zeit.",
              "english": "Yes, I have time."
            },
            {
              "speaker": "anna",
              "text": "Ich telefoniere gern mit dir, Sam.",
              "english": "I like phoning you, Sam."
            },
            {
              "speaker": "anna",
              "text": "Ich telefoniere auch mit Marta.",
              "english": "I phone Marta too."
            },
            {
              "speaker": "sam",
              "text": "Ich auch.",
              "english": "Me too."
            },
            {
              "speaker": "sam",
              "text": "Aber es ist schon spät.",
              "english": "But it is already late."
            },
            {
              "speaker": "anna",
              "text": "Hast du noch Zeit?",
              "english": "Do you still have time?"
            },
            {
              "speaker": "sam",
              "text": "Ja, ich bin noch nicht müde.",
              "english": "Yes, I am not tired yet."
            },
            {
              "speaker": "anna",
              "text": "Ich bin schon müde.",
              "english": "I am already tired."
            },
            {
              "speaker": "anna",
              "text": "Ich lege mich bald ins Bett.",
              "english": "I will lie down in bed soon."
            },
            {
              "speaker": "anna",
              "text": "Mein Kopf und mein Hals tun weh.",
              "english": "My head and my throat hurt."
            },
            {
              "speaker": "sam",
              "text": "Du bist krank?",
              "english": "You are ill?"
            },
            {
              "speaker": "sam",
              "text": "Hast du Fieber?",
              "english": "Do you have a fever?"
            },
            {
              "speaker": "anna",
              "text": "Ich habe nur eine Tablette, danke.",
              "english": "I have just one tablet, thank you."
            },
            {
              "speaker": "sam",
              "text": "Dann schlaf gut!",
              "english": "Then sleep well!"
            },
            {
              "speaker": "anna",
              "text": "Und du?",
              "english": "And you?"
            },
            {
              "speaker": "anna",
              "text": "Schläfst du auch bald?",
              "english": "Are you going to sleep soon too?"
            },
            {
              "speaker": "sam",
              "text": "Ich lese noch, dann höre ich Musik, und dann schlafe ich.",
              "english": "I will read a bit more, then I listen to music, and then I sleep."
            },
            {
              "speaker": "anna",
              "text": "Lukas spielt mit Ben im Park.",
              "english": "Lukas is playing with Ben in the park."
            },
            {
              "speaker": "anna",
              "text": "Ben spielt immer, auch am Abend!",
              "english": "Ben always plays, even in the evening!"
            },
            {
              "speaker": "anna",
              "text": "Tschüs, Sam!",
              "english": "Bye, Sam!"
            },
            {
              "speaker": "anna",
              "text": "Bis bald!",
