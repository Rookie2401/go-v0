let all = 0, miss = 0;
for (const [name, list] of Object.entries(GROUPS)) {
  // an adjective is checked without its article
  const words = [...new Set(list.split(/\s+/).filter((w) => w && !['i', 'e', 'të', 'së', 'më'].includes(w)))];
  const missing = words.filter((w) => !sqKnownForm(w));
  all += words.length; miss += missing.length;
  console.log(`\n${name}: ${words.length} checked; ${missing.length} unknown (${(100 * missing.length / words.length).toFixed(0)} %)\n  unknown: ${missing.join(' ')}`);
}
console.log(`\nTOTAL: ${all} everyday words checked; ${miss} are not known to the adapter's own data (${(100 * miss / all).toFixed(0)} %)`);
