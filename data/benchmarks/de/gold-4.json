        { "form": "Hunger", "lemma": "Hunger", "pos": "NOUN", "morph": { "Case": "Acc", "Gender": "Masc", "Number": "Sing" } },
        { "form": "kräftigen", "lemma": "kräftig", "pos": "ADJ", "morph": { "Case": "Acc", "Gender": "Masc", "Number": "Sing", "Decl": "Mixed" } },
