    { "id": "amb-028", "sentence": "Le mode d'emploi est simple.", "target": "mode", "expect": { "lemma": "mode", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "le mode (way, method) is masculine" },
