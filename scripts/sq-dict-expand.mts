/// <reference types="node" />
/**
 * npm run sq:dict-expand -- [--in data/research/kaikki/kaikki.org-dictionary-Albanian.jsonl] [--out <file>]
 *
 * English Wiktionary gives most Albanian inflected forms only inside the inflection TABLE of their lemma's entry, not as
 * entries of their own; the dictionary builder (npm run dict:build) reads entries. This script writes a second
 * JSON-Lines file next to the extract: every line of the extract UNCHANGED, followed by one "X of Y" line for each
 * single-word cell of each inflection table — in the extract's own shape (word, pos, lang_code, a sense with `form_of`
 * and the cell's own labels), so that the builder needs no change and the built dictionary knows those forms.
 *
 * What is added, and what is not:
 *   - only tables that agree with their entry's own head line (src/bench/sq/wiktionary.ts `hasConsistentTable`): the
 *     tables are generated by templates, and an entry with the wrong template has a wrong table;
 *   - only Standard cells written as one word ("të hip" counts as "hip", "i mirë" as "mirë"; "kam hipur" is a phrase);
 *   - never a cell that is the headword itself, and never a line the extract already has (same form, part of speech,
 *     lemma and labels);
 *   - each added sense says where it comes from: its gloss is "<labels> of <lemma> (from the inflection table of the
 *     entry)", and it carries `"raw_tags": ["from-inflection-table"]`.
 * Nothing is corrected: a table's own mistake (one table has "qeshqesh" where the form is "qeshi") is carried over as
 * it stands — it is what the source says — and is harmless unless a text contains that written form.
 *
 * The output is research material like the extract (data/research/, never committed); only the dictionary built from it
 * is shipped, under the extract's licence (CC BY-SA, Wiktionary contributors, via kaikki.org). Reads and writes local
 * files; no network. Exit 1 when the input is missing.
 */
import fs from 'node:fs';
import { sqNormalize } from '../src/adapters/albanian/orthography';
import { kaikkiTableCells, type KaikkiEntry } from '../src/bench/sq/wiktionary';

const args = process.argv.slice(2).filter((a) => a !== '--');
const opt = (k: string): string | undefined => { const i = args.indexOf(`--${k}`); return i >= 0 ? args[i + 1] : undefined; };
const input = opt('in') ?? 'data/research/kaikki/kaikki.org-dictionary-Albanian.jsonl';
const output = opt('out') ?? input.replace(/\.jsonl$/, '+tables.jsonl');
if (!fs.existsSync(input)) { console.error(`cannot read ${input}: the extract is downloaded only with the owner's permission (see data/benchmarks/sq/RESOURCES.json)`); process.exit(1); }
if (output === input) { console.error('--out must not be the input file'); process.exit(1); }

const lines = fs.readFileSync(input, 'utf8').split('\n').filter((l) => l.trim());
const key = (form: string, pos: string, lemma: string, tags: readonly string[]) => `${sqNormalize(form)}|${pos}|${sqNormalize(lemma)}|${tags.filter((t) => t !== 'form-of').sort().join(' ')}`;

// what the extract already says as "X of Y" entries
const have = new Set<string>();
const entries: KaikkiEntry[] = [];
for (const l of lines) {
  let e: KaikkiEntry;
  try { e = JSON.parse(l) as KaikkiEntry; } catch { continue; }
  entries.push(e);
  for (const s of e.senses ?? []) for (const t of s.form_of ?? []) if (e.word && e.pos && t.word) have.add(key(e.word, e.pos, t.word, s.tags ?? []));
}

const added: string[] = [];
let tables = 0;
for (const e of entries) {
  const cells = kaikkiTableCells(e);
  if (!cells.length) continue;
  tables++;
  for (const c of cells) {
    const k = key(c.form, e.pos!, e.word!, c.tags);
    if (have.has(k)) continue;
    have.add(k);
    added.push(JSON.stringify({
      word: c.form, lang: 'Albanian', lang_code: 'sq', pos: e.pos,
      senses: [{ glosses: [`${c.tags.join(' ')} of ${e.word} (from the inflection table of the entry)`], tags: ['form-of', ...c.tags], raw_tags: ['from-inflection-table'], form_of: [{ word: e.word }] }],
    }));
  }
}

fs.writeFileSync(output, `${lines.join('\n')}\n${added.join('\n')}\n`, 'utf8');
console.log(`sq:dict-expand - ${lines.length} lines of the extract kept unchanged; ${added.length} "form of" lines added from ${tables} inflection tables that agree with their head line -> ${output}`);
