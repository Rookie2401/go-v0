{
  "manifest_version": 3,
  "name": "GoLearn reader",
  "version": "0.1.0",
  "description": "Look up words as you read. See meanings, grammar and pronunciation. Your history stays on this device unless you sign in.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://github.com/rookie2401/go-v0",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "contextMenus", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "app/index.html",
  "action": {
    "default_title": "GoLearn",
    "default_popup": "action/popup.html"
  },
  "commands": {
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Look up the current selection with GoLearn"
    }
  },
  "web_accessible_resources": [
    { "resources": ["analysers/*.js", "lexicon/*"], "matches": ["<all_urls>"] }
  ]
}
