zbritja":[{"w":"zbritja","p":"NOUN","s":[{"g":"subtraction","t":2}],"ety":{"text":"From zbres.","tpl":[]}}],"zojs":[{"w":"Zojs","p":"PROPN","s":[{"g":"a village in the municipality of Dajç, district of Lezhë, county of Lezhë","t":1,"x":["Zoizi ašt ńi katunn n Zadrim. […] Atü kü Zoizi ka pęm šum. Ašt ńi katunn i vogl, jo fort i hapt, me nizet a triδet špi katunn."]}],"f":[["Zojsi",7],["Zojs",6,3],["Zojsi",5,3],["Zojs",4,3],["Zojsin",3,3],["Zojsi",22,3],["Zojsit",19,3],["Zojz",0]],"tpl":["sq-noun-m-unc"],"ipa":[{"i":"/ˈzojs/"}],"ety":{"text":"First attested as Italian Loiz [1671], likely erroneously, and as Soisi [1688]. Considering how the village is on the shore of the Drin river, Gurakuqi (1940) connects it to zall, plural zaje (“river shore”), and compares it to Zajs, Zajz in Mirdita, also on the shore of a river, the Fand. Topalli (2017) considers it a derivation from zog (“chick, young bird”), comparing it to other toponyms Zogaj, Zogas and Zogjaj in northern Albania.","tpl":[{"k":29,"lang":"it","form":"Loiz"}]}}],"çaj bjeshke":[{"w":"çaj bjeshke","p":"NOUN","s":[{"g":"dried leaves and stems of sweet marjoram plant (of genus Origanum majorana) or oregano (Origanum vulgare), for making tea","t":1},{"g":"an infusion of the of the above","t":1},{"g":"an infusion of the leaves of ironwort, mountain tea","t":1}],"f":[["çajra mali",8]],"ipa":[{"i":"/t͡ʃaj ˈbjɛʃkɛ/"}],"ety":{"text":"From çaj (“tea”) + bjeshke (“mountain pasture”) (indef. abl. singular).","tpl":[]},"rel":{"syn":["çaj mali"]}}]}}
