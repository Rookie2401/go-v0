      "title": "Ku është Ardi?",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Luan është mësues.",
              "english": "Luan is a teacher."
            },
            {
              "text": "Ardi është nxënës.",
              "english": "Ardi is a pupil."
            },
            {
              "text": "Sot Ardi nuk është në shkollë.",
              "english": "Today Ardi is not at school."
            },
            {
              "text": "Ku është Ardi?",
              "english": "Where is Ardi?"
            },
            {
              "text": "Luan nuk e di.",
              "english": "Luan does not know."
            },
            {
              "text": "Ardi është në shtëpi.",
              "english": "Ardi is at home."
            },
            {
              "text": "Ai është i lodhur.",
              "english": "He is tired."
            },
            {
              "text": "Gjyshja thotë: — Ardi, a je mirë?",
              "english": "Grandmother says: \"Ardi, are you well?\""
            },
            {
              "text": "— Jo, gjyshe. Jam i lodhur.",
              "english": "\"No, grandmother. I am tired.\""
            },
            {
              "text": "— Pi ujë dhe çaj.",
              "english": "\"Drink water and tea.\""
            },
            {
              "text": "Ardi pi ujë.",
              "english": "Ardi drinks water."
            },
            {
              "text": "Gjyshja ka bukë dhe oriz.",
              "english": "Grandmother has bread and rice."
            },
            {
              "text": "Ardi ha bukë dhe oriz.",
              "english": "Ardi eats bread and rice."
            },
            {
              "text": "Nesër Ardi shkon në shkollë.",
              "english": "Tomorrow Ardi goes to school."
            }
          ]
        }
      ]
    }
