        {
          "sentences": [
            {
              "text": "Kjo është shkolla.",
              "english": "This is the school."
            },
            {
              "text": "Shkolla është e madhe.",
              "english": "The school is big."
            },
            {
              "text": "Luan është mësues këtu.",
              "english": "Luan is a teacher here."
            },
            {
              "text": "Në shkollë ka djem dhe vajza.",
              "english": "At the school there are boys and girls."
            },
            {
              "text": "Ardi është nxënës.",
              "english": "Ardi is a pupil."
            },
            {
              "text": "Ardi ka një libër të ri.",
              "english": "Ardi has a new book."
            },
            {
              "text": "Sam shkon në shkollë me Luanin.",
              "english": "Sam goes to the school with Luan."
            },
            {
              "text": "— Kush është ky?",
              "english": "\"Who is this?\""
            },
            {
              "text": "— Ky është Ardi.",
              "english": "\"This is Ardi.\""
            },
            {
              "text": "— Përshëndetje, Ardi!",
              "english": "\"Hello, Ardi!\""
            },
            {
              "text": "— Përshëndetje, Sam!",
              "english": "\"Hello, Sam!\""
            },
            {
              "text": "Ardi lexon.",
              "english": "Ardi reads."
            },
            {
              "text": "Sam pi kafe me Luanin.",
              "english": "Sam drinks coffee with Luan."
            },
            {
              "text": "Ardit i pëlqen shkolla shumë.",
              "english": "Ardi likes the school very much."
            },
            {
              "text": "Mësuesi ka kafe mbi tavolinë.",
              "english": "The teacher has coffee on the table."
            }
          ]
        }
      ]
    }
