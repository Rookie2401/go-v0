{
  "name": "go-v0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Go — a missions-oriented language-acquisition system (Comprehensible Input Corpus, Bible Corpus, My Testimony) with GoLearn / GoListen / GoTell engines underneath.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gate": "tsc -b && vitest run",
    "corpus:validate": "vite-node scripts/corpus-validate.mts",
    "corpus:check": "vite-node scripts/corpus-check.mts",
    "corpus:migrate": "vite-node scripts/corpus-migrate.mts",
    "corpus:review": "vite-node scripts/corpus-review.mts",
    "corpus:prove": "vite-node scripts/corpus-prove.mts",
    "corpus:convert": "vite-node scripts/corpus-convert.mts",
    "dict:build": "vite-node scripts/dict-build.mts",
    "dict:compare": "vite-node scripts/dict-compare.mts",
    "tones:eval": "vite-node scripts/eval-tones-kaikki.mts",
    "bench:words": "vite-node scripts/bench-words.mts",
    "bench:units": "vite-node scripts/bench-units.mts",
    "gold:wiktionary": "vite-node scripts/gold-wiktionary.mts",
    "gold:draft": "vite-node scripts/gold-draft.mts",
    "gold:accept": "vite-node scripts/gold-accept.mts",
    "gold:status": "vite-node scripts/gold-status.mts",
    "gold:freeze": "vite-node scripts/gold-freeze.mts",
    "speech:check": "vite-node scripts/speech-check.mts"
  },
  "dependencies": {
    "dexie": "^4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fake-indexeddb": "^6",
    "jsdom": "^26",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6",
    "vitest": "^3.2.7"
  }
}
