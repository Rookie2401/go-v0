{
  "category": "literary",
  "note": "Passé simple (regular and irregular, all persons used in narrative), passé antérieur, imparfait du subjonctif, literary negation (ne ... point, guère, ne alone), inversion after direct speech, and single short sentences from public-domain authors (La Fontaine, Perrault, Voltaire, Hugo, Maupassant, Flaubert, Dumas), quoted from memory and named in `why`. Forms like finit, dit, vit, rit also exist in the present: those cases are `advanced` because only the context decides. An AI's judgement, not native-reviewed.",
  "cases": [
    { "id": "lit-001", "sentence": "Il entra dans la salle.", "target": "entra", "expect": { "lemma": "entrer", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "regular -er passé simple, third person singular" },
    { "id": "lit-002", "sentence": "Elle finit son repas, puis elle sortit.", "target": "finit", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "advanced", "why": "finit is both the present and the passé simple; the narrative sequence with puis ... sortit decides" },
    { "id": "lit-003", "sentence": "Il vendit sa maison.", "target": "vendit", "expect": { "lemma": "vendre", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "-re verbs take -it in the passé simple" },
    { "id": "lit-004", "sentence": "Il fut roi.", "target": "fut", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "passé simple of être" },
    { "id": "lit-005", "sentence": "Elle eut peur.", "target": "eut", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "passé simple of avoir" },
    { "id": "lit-006", "sentence": "Il alla à la ville.", "target": "alla", "expect": { "lemma": "aller", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "passé simple of aller (regular -er endings)" },
    { "id": "lit-007", "sentence": "Il fit un pas.", "target": "fit", "expect": { "lemma": "faire", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of faire" },
    { "id": "lit-008", "sentence": "Il dit adieu et partit.", "target": "dit", "expect": { "lemma": "dire", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "advanced", "why": "dit is both present and passé simple; the second verb partit shows the narrative tense" },
    { "id": "lit-009", "sentence": "Il vint hier.", "target": "vint", "expect": { "lemma": "venir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of venir" },
    { "id": "lit-010", "sentence": "Il prit son manteau.", "target": "prit", "expect": { "lemma": "prendre", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of prendre" },
    { "id": "lit-011", "sentence": "Il mit son chapeau.", "target": "mit", "expect": { "lemma": "mettre", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of mettre (the participle is mis; mit is only the passé simple)" },
    { "id": "lit-012", "sentence": "Il vit la mer et sourit.", "target": "vit", "expect": { "lemma": "voir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "advanced", "why": "vit is voir (passé simple) or vivre (present): the object la mer and sourit show voir in the past" },
    { "id": "lit-013", "sentence": "Il put sortir.", "target": "put", "expect": { "lemma": "pouvoir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "passé simple of pouvoir" },
    { "id": "lit-014", "sentence": "Il voulut partir.", "target": "voulut", "expect": { "lemma": "vouloir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "passé simple of vouloir" },
    { "id": "lit-015", "sentence": "Il sut la vérité.", "target": "sut", "expect": { "lemma": "savoir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of savoir" },
    { "id": "lit-016", "sentence": "Il dut partir.", "target": "dut", "expect": { "lemma": "devoir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "passé simple of devoir" },
    { "id": "lit-017", "sentence": "Il crut le voir.", "target": "crut", "expect": { "lemma": "croire", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of croire" },
    { "id": "lit-018", "sentence": "Il tint parole.", "target": "tint", "expect": { "lemma": "tenir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of tenir" },
    { "id": "lit-019", "sentence": "Il reçut une lettre.", "target": "reçut", "expect": { "lemma": "recevoir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of recevoir keeps the cedilla before u" },
    { "id": "lit-020", "sentence": "Il connut la faim.", "target": "connut", "expect": { "lemma": "connaître", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "passé simple of connaître" },
    { "id": "lit-021", "sentence": "Ils entrèrent dans la salle.", "target": "entrèrent", "expect": { "lemma": "entrer", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Plur" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "-èrent: third person plural of the -er passé simple" },
    { "id": "lit-022", "sentence": "Ils finirent le travail.", "target": "finirent", "expect": { "lemma": "finir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Plur" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "-irent: third person plural, -ir verbs" },
    { "id": "lit-023", "sentence": "Ils furent surpris.", "target": "furent", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Past", "Person": "3", "Number": "Plur" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "-urent: passé simple of être" },
    { "id": "lit-024", "sentence": "Ils eurent peur.", "target": "eurent", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Plur" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "-urent: passé simple of avoir" },
    { "id": "lit-025", "sentence": "Ils vinrent hier.", "target": "vinrent", "expect": { "lemma": "venir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-inrent: passé simple plural of venir" },
    { "id": "lit-026", "sentence": "Ils tinrent bon.", "target": "tinrent", "expect": { "lemma": "tenir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-inrent: passé simple plural of tenir" },
    { "id": "lit-027", "sentence": "Nous entrâmes dans la salle.", "target": "entrâmes", "expect": { "lemma": "entrer", "pos": "VERB", "features": { "Tense": "Past", "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-âmes: first person plural passé simple" },
    { "id": "lit-028", "sentence": "Vous entrâtes dans la salle.", "target": "entrâtes", "expect": { "lemma": "entrer", "pos": "VERB", "features": { "Tense": "Past", "Person": "2", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "-âtes: second person plural passé simple" },
    { "id": "lit-029", "sentence": "Quand il eut fini, il sortit.", "target": "eut", "expect": { "lemma": "avoir", "pos": "AUX", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-anterieur" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "passé antérieur: passé simple of the auxiliary + participle" },
    { "id": "lit-030", "sentence": "Dès qu'elle fut partie, il pleura.", "target": "fut", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Past", "Person": "3" }, "construction": "passe-anterieur" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "advanced", "why": "passé antérieur with être" },
    { "id": "lit-031", "sentence": "Il fallait qu'il fût là.", "target": "fût", "expect": { "lemma": "être", "pos": "AUX", "features": { "Mood": "Sub", "Tense": "Imp", "Person": "3", "Number": "Sing" }, "construction": "literary-subjunctive-imperfect" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "advanced", "why": "imparfait du subjonctif; fût is also a noun (barrel)" },
    { "id": "lit-032", "sentence": "Il fallait qu'il eût raison.", "target": "eût", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Mood": "Sub", "Tense": "Imp", "Person": "3" }, "construction": "literary-subjunctive-imperfect" }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "advanced", "why": "imparfait du subjonctif of avoir" },
    { "id": "lit-033", "sentence": "Il voulait qu'il parlât.", "target": "parlât", "expect": { "lemma": "parler", "pos": "VERB", "features": { "Mood": "Sub", "Tense": "Imp", "Person": "3", "Number": "Sing" }, "construction": "literary-subjunctive-imperfect" }, "source": "kaikki", "level": "advanced", "why": "-ât: imparfait du subjonctif, third person singular" },
    { "id": "lit-034", "sentence": "Il fallait qu'ils fussent là.", "target": "fussent", "expect": { "lemma": "être", "pos": "AUX", "features": { "Mood": "Sub", "Tense": "Imp", "Person": "3", "Number": "Plur" }, "construction": "literary-subjunctive-imperfect" }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "advanced", "why": "imparfait du subjonctif, third person plural" },
    { "id": "lit-035", "sentence": "Il ne pouvait point sortir.", "target": "point", "expect": { "lemma": "point", "pos": "ADV", "construction": "negation" }, "source": "kaikki", "level": "advanced", "why": "ne ... point is the literary negation; point after ne is the adverb, not the noun or a form of poindre" },
    { "id": "lit-036", "sentence": "Il ne sortait guère.", "target": "guère", "expect": { "lemma": "guère", "pos": "ADV", "construction": "negation" }, "source": "kaikki", "level": "core", "why": "ne ... guère: hardly" },
    { "id": "lit-037", "sentence": "Il ne cesse de pleurer.", "target": "ne", "expect": { "lemma": "ne", "pos": "ADV", "construction": "negation" }, "alsoAcceptPos": ["PART"], "source": "grammar", "level": "advanced", "why": "ne alone with cesser is a complete negation in literary style" },
    { "id": "lit-038", "sentence": "Allons, dit-il.", "target": "dit", "expect": { "lemma": "dire", "pos": "VERB", "tokens": ["Allons", "dit", "il"] }, "source": "kaikki", "level": "core", "why": "inversion after direct speech: dit-il is dit · il" },
    { "id": "lit-039", "sentence": "Non, répondit-elle.", "target": "répondit", "expect": { "lemma": "répondre", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "tokens": ["Non", "répondit", "elle"] }, "source": "kaikki", "level": "core", "why": "répondit after direct speech is the passé simple; -elle is its own token" },
    { "id": "lit-040", "sentence": "La raison du plus fort est toujours la meilleure.", "target": "meilleure", "expect": { "lemma": "meilleur", "pos": "ADJ", "features": { "Gender": "Fem", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "La Fontaine, Le Loup et l'Agneau; meilleure is the feminine of meilleur" },
    { "id": "lit-041", "sentence": "Maître Corbeau, sur un arbre perché, tenait en son bec un fromage.", "target": "tenait", "expect": { "lemma": "tenir", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Imp", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "La Fontaine, Le Corbeau et le Renard; imparfait of tenir" },
    { "id": "lit-042", "sentence": "Rien ne sert de courir.", "target": "sert", "expect": { "lemma": "servir", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "La Fontaine, Le Lièvre et la Tortue; sert is servir (rien ne sert: it is no use)" },
    { "id": "lit-043", "sentence": "Tire la chevillette, la bobinette cherra.", "target": "cherra", "expect": { "lemma": "choir", "pos": "VERB", "features": { "Tense": "Fut", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "advanced", "why": "Perrault, Le Petit Chaperon rouge; cherra is the futur of the archaic verb choir (to fall)" },
    { "id": "lit-044", "sentence": "Il faut cultiver notre jardin.", "target": "faut", "expect": { "lemma": "falloir", "pos": "VERB", "features": { "Mood": "Ind", "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "Voltaire, Candide; falloir is impersonal, third person singular only" },
    { "id": "lit-045", "sentence": "Tout est pour le mieux dans le meilleur des mondes possibles.", "target": "mieux", "expect": { "lemma": "mieux", "pos": "ADV" }, "alsoAcceptPos": ["NOUN"], "source": "kaikki", "level": "advanced", "why": "Voltaire, Candide (Pangloss); after le, mieux is a nominalised adverb" },
    { "id": "lit-046", "sentence": "Demain, dès l'aube, à l'heure où blanchit la campagne, je partirai.", "target": "blanchit", "expect": { "lemma": "blanchir", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "advanced", "why": "Hugo, Demain, dès l'aube; inverted subject after où: present of blanchir (the passé simple has the same spelling)" },
    { "id": "lit-047", "sentence": "Demain, dès l'aube, à l'heure où blanchit la campagne, je partirai.", "target": "partirai", "expect": { "lemma": "partir", "pos": "VERB", "features": { "Tense": "Fut", "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "Hugo, Demain, dès l'aube; futur of partir" },
    { "id": "lit-048", "sentence": "C'était une de ces jolies et charmantes filles.", "target": "était", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Imp", "Person": "3", "Number": "Sing" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "Maupassant, La Parure (opening); imparfait of être after the elided c'" },
    { "id": "lit-049", "sentence": "Attendre et espérer !", "target": "espérer", "expect": { "lemma": "espérer", "pos": "VERB", "features": { "VerbForm": "Inf" } }, "source": "kaikki", "level": "core", "why": "Dumas, Le Comte de Monte-Cristo (last words); infinitive" },
    { "id": "lit-050", "sentence": "Nous étions à l'étude, quand le proviseur entra.", "target": "entra", "expect": { "lemma": "entrer", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" }, "construction": "passe-simple" }, "source": "kaikki", "level": "core", "why": "Flaubert, Madame Bovary (opening, shortened); passé simple interrupting the imparfait" },
    { "id": "lit-051", "sentence": "Nous étions à l'étude, quand le proviseur entra.", "target": "étions", "expect": { "lemma": "être", "pos": "AUX", "features": { "Tense": "Imp", "Person": "1", "Number": "Plur" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "Flaubert, Madame Bovary; imparfait first person plural" },
    { "id": "lit-052", "sentence": "Ce siècle avait deux ans.", "target": "avait", "expect": { "lemma": "avoir", "pos": "VERB", "features": { "Tense": "Imp", "Person": "3", "Number": "Sing" } }, "alsoAcceptPos": ["AUX"], "source": "kaikki", "level": "core", "why": "Hugo, Les Feuilles d'automne (first line); imparfait of avoir" },
    { "id": "lit-053", "sentence": "Il naquit à Paris.", "target": "naquit", "expect": { "lemma": "naître", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of naître" },
    { "id": "lit-054", "sentence": "Il mourut jeune.", "target": "mourut", "expect": { "lemma": "mourir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of mourir" },
    { "id": "lit-055", "sentence": "Il écrivit une lettre.", "target": "écrivit", "expect": { "lemma": "écrire", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of écrire" },
    { "id": "lit-056", "sentence": "Il lut le livre.", "target": "lut", "expect": { "lemma": "lire", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of lire" },
    { "id": "lit-057", "sentence": "Il but un verre.", "target": "but", "expect": { "lemma": "boire", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "advanced", "why": "but is the passé simple of boire; the noun but (goal) has the same spelling" },
    { "id": "lit-058", "sentence": "Il courut vers elle.", "target": "courut", "expect": { "lemma": "courir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of courir" },
    { "id": "lit-059", "sentence": "Il ouvrit la porte.", "target": "ouvrit", "expect": { "lemma": "ouvrir", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "ouvrir has an -ir passé simple although its present is like an -er verb" },
    { "id": "lit-060", "sentence": "Il vécut longtemps.", "target": "vécut", "expect": { "lemma": "vivre", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of vivre" },
    { "id": "lit-061", "sentence": "Il suivit son père.", "target": "suivit", "expect": { "lemma": "suivre", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of suivre" },
    { "id": "lit-062", "sentence": "Il conduisit la voiture.", "target": "conduisit", "expect": { "lemma": "conduire", "pos": "VERB", "features": { "Tense": "Past", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "passé simple of conduire" }
  ]
}
