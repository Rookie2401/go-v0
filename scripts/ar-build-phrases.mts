/// <reference types="node" />
/**
 * npx vite-node --config scripts/vite.config.ts scripts/ar-build-phrases.mts -- [--in <kaikki-arabic.jsonl>] [--out <file>] [--limit <bytes>]
 *
 * Builds src/adapters/arabic/generated/phrases.ts: the multi-word Arabic headwords of the Wiktionary extract (kaikki.org, CC BY-SA 4.0)
 * that have a sense of their own, for src/adapters/arabic/phrases.ts. Only entries whose word has a space and Arabic letters only (no Persian
 * letters ک ی, no Latin, no digits), a real sense that is not a form-of or alt-of, and a gloss. Entries are ranked by usefulness to a reader
 * (prepositional and adverbial phrases, conjunctions, set phrases and interjections first; compound nouns and names last, shorter first) and
 * kept until the file reaches --limit bytes (default 58000). Deterministic: the same input gives the same file.
 */
import fs from 'node:fs';
import path from 'node:path';
import readline from 'node:readline';

const args = process.argv.slice(2).filter((a) => a !== '--');
const opt = (name: string, dflt: string): string => { const i = args.indexOf(`--${name}`); return i >= 0 && args[i + 1] ? args[i + 1] : dflt; };
const IN = opt('in', 'C:/Users/CJWal/dev/lisan-v0/data/dict/kaikki-arabic.jsonl');
const OUT = path.resolve(opt('out', 'src/adapters/arabic/generated/phrases.ts'));
const LIMIT = Number(opt('limit', '58000'));

const ARABIC_OK = /^[\u0621-\u063A\u0641-\u064A\u064B-\u0652\u0670\u0671 ]+$/u;
const RANK: Record<string, number> = { prep: 0, prep_phrase: 0, conj: 1, adv: 1, intj: 2, phrase: 2, verb: 3, num: 3, proverb: 4, adj: 5, noun: 6, name: 7 };

interface Row { text: string; pos: string; gloss: string }

function shorten(g: string): string {
  let out = g.replace(/\s+/g, ' ').trim();
  const semi = out.indexOf(';');
  if (semi > 0) out = out.slice(0, semi);
  if (out.length > 60) { const comma = out.indexOf(',', 12); if (comma > 0 && comma < 60) out = out.slice(0, comma); }
  if (out.length > 70) out = `${out.slice(0, 67).replace(/\s+\S*$/, '')}…`;
  return out.replace(/"/g, '\u201D');
}

async function main(): Promise<void> {
  const rows = new Map<string, Row>();
  const rl = readline.createInterface({ input: fs.createReadStream(IN), crlfDelay: Infinity });
  let seen = 0;
  for await (const line of rl) {
    seen++;
    const m = /"word":\s*"([^"]*)"/.exec(line);
    if (!m || !m[1].includes(' ')) continue;
    const word = m[1].normalize('NFC').trim();
    if (!ARABIC_OK.test(word) || word.split(' ').filter(Boolean).length < 2) continue;
    let o: { pos?: string; senses?: Array<{ glosses?: string[]; form_of?: unknown; alt_of?: unknown }> };
    try { o = JSON.parse(line); } catch { continue; }
    if (!o.pos || !(o.pos in RANK)) continue;
    const sense = (o.senses ?? []).find((x) => x.glosses?.length && !x.form_of && !x.alt_of);
    if (!sense) continue;
    const gloss = shorten(sense.glosses![0]);
    if (!gloss) continue;
    const key = word.replace(/[\u064B-\u0652\u0670]/g, '');
    const old = rows.get(key);
    if (!old || RANK[o.pos] < RANK[old.pos]) rows.set(key, { text: word.split(' ').filter(Boolean).join(' '), pos: o.pos, gloss });
  }
  const list = [...rows.values()].sort((a, b) => RANK[a.pos] - RANK[b.pos] || a.text.length - b.text.length || a.text.localeCompare(b.text));
  const head = `/**
 * GENERATED by scripts/ar-build-phrases.mts from the Wiktionary Arabic extract (kaikki.org, CC BY-SA 4.0). Do not edit.
 * Multi-word Arabic headwords with a sense of their own: [headword as the dictionary writes it, its part of speech there, a short gloss].
 */
export const AR_PHRASES: ReadonlyArray<readonly [string, string, string]> = [
`;
  const tail = '];\n';
  let body = '';
  let kept = 0;
  for (const r of list) {
    const line = `  ["${r.text}", "${r.pos}", "${r.gloss}"],\n`;
    if (Buffer.byteLength(head + body + line + tail) > LIMIT) continue;
    body += line;
    kept++;
  }
  fs.writeFileSync(OUT, head + body + tail, 'utf8');
  console.log(`read ${seen} lines; ${rows.size} candidate phrases; kept ${kept}; ${Buffer.byteLength(head + body + tail)} bytes -> ${OUT}`);
}
void main();
