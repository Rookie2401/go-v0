        { "form": "wird", "lemma": "werden", "pos": "AUX", "morph": { "Person": "3", "Number": "Sing" } },
        { "form": "gemacht", "lemma": "machen", "pos": "VERB", "morph": { "VerbForm": "Part", "Tense": "Past" } },
        { "form": "große", "lemma": "groß", "pos": "ADJ", "morph": { "Case": "Nom", "Gender": "Masc", "Number": "Sing", "Decl": "Weak" } },
        { "form": "Schnitt", "lemma": "Schnitt", "pos": "NOUN", "morph": { "Case": "Nom", "Gender": "Masc", "Number": "Sing" } }
      ], "constructions": ["passive"], "notConstructions": ["future"] },
    { "id": "r3-k10", "category": "native prose (Kafka)", "text": "Vorläufig allerdings muß ich aufstehen, denn mein Zug fährt um fünf.",
      "tokens": [
        { "form": "muß", "lemma": "müssen", "pos": "AUX", "morph": { "Person": "1", "Number": "Sing" }, "orthography": { "modern": "muss", "period": "de-1901" } },
