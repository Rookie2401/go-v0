              "text": "Está bien, Ana.",
              "english": "(Message) That is fine, Ana."
            },
            {
              "speaker": "marta",
              "text": "Hay sopa para vos.",
              "english": "There is soup for you."
            },
            {
              "speaker": "sam",
              "text": "Doña Marta, estoy en la terminal.",
              "english": "(Message) Doña Marta, I am at the terminal."
            },
            {
              "speaker": "sam",
              "text": "El autobús llega a las seis.",
              "english": "The bus arrives at six."
            },
            {
              "speaker": "marta",
              "text": "Sam, ¿tenés dinero para el boleto?",
              "english": "(Message) Sam, do you have money for the ticket?"
            },
            {
              "speaker": "sam",
              "text": "Sí, tengo dinero.",
              "english": "(Message) Yes, I have money."
            },
            {
              "speaker": "sam",
              "text": "Gracias, doña Marta.",
              "english": "Thank you, doña Marta."
            },
            {
              "speaker": "marta",
              "text": "¿Y tu teléfono?",
              "english": "(Message) And your phone?"
            },
            {
              "speaker": "marta",
              "text": "¿Está en la casa?",
              "english": "Is it at home?"
            },
            {
              "speaker": "sam",
              "text": "No, aquí está.",
              "english": "(Message) No, here it is."
            },
            {
              "speaker": "karla",
              "text": "Estoy cerca de la iglesia.",
              "english": "(Message) I am near the church."
            },
            {
              "speaker": "karla",
              "text": "¿Y ustedes?",
              "english": "And you?"
            },
            {
              "speaker": "daniel",
