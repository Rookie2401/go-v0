        { "form": "des", "pos": "DET", "morph": { "Case": "Gen", "Gender": "Masc", "Number": "Sing" } },
        { "form": "Kreatur", "pos": "NOUN", "morph": { "Gender": "Fem", "Number": "Sing" }, "includes": { "Case": "Nom" } },
        { "form": "Verstand", "lemma": "Verstand", "pos": "NOUN", "includes": { "Case": "Acc" } }
      ], "constructions": ["genitive-attribute"] },
    { "id": "r4-05", "category": "native prose (Kafka)", "text": "Wie nun, wenn er sich krank meldete?",
