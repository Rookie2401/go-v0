/** Acquire a small, lawful beginner-reading bridge from official GDL language catalogues.
 * Albanian is queried first and recorded explicitly when unavailable; no translation is generated.
 */
import fs from 'node:fs'; import path from 'node:path'; import crypto from 'node:crypto';
import { readEpub } from '../src/ingest/epub'; import { plainTextToDocuments } from '../src/ingest/plaintext'; import { contentSignatureOf } from '../src/ingest/publish';
const root=process.cwd(), lang=(process.argv.find(x=>x.startsWith('--lang='))?.split('=')[1]??'de'), docLang=(lang.startsWith('es')?'es':lang.startsWith('th')?'th':lang) as any, limit=Number(process.argv.find(x=>x.startsWith('--limit='))?.split('=')[1]??12), api=`https://content.digitallibrary.io/wp-json/content-api/v1/books/${lang}`, out=path.join(root,'data','sources','reading-bridge',lang); fs.mkdirSync(out,{recursive:true});
if (process.argv.includes('--repair-existing') && ['de','es','th'].includes(docLang)) {
  const mf = path.join(out, 'library-manifest.json'); const manifest = JSON.parse(fs.readFileSync(mf, 'utf8')); const repaired:any[]=[];
  for (const e of manifest.entries) { const file=path.join(out,e.source.file); const d=JSON.parse(fs.readFileSync(file,'utf8')); const credits:string[]=[]; for (const sec of d.sections??[]) { const kept:any[]=[]; for (const p of sec.paragraphs??[]) { const t=String(p.text??'').replace(/^\]>\s*/,'').trim(); const hasCredit=/Autor(?:es)?\s*:|Author(?:s)?\s*:|Auteur\s*:|Illustrator|Illustrateur|Ilustrador|Translator|Traductor|Traducido/i.test(t); if (hasCredit) credits.push(t.replace(/\s+/g,' ').trim()); const wrapper=/This book was made possible|Some rights reserved|Pratham Books goes digital|Illustration Attributions|^Page \d+:|Disclaimer:|The Lion Runs|\(Englisch\)|https?:\/\//i.test(t); if (wrapper && !hasCredit) continue; if (t) kept.push({...p,text:t}); } sec.paragraphs=kept; } if (credits.length) d.source.attribution += ` Credits retained from source front matter: ${credits.join(' | ')}`; delete d.quality; d.review={...d.review,contentSignature:contentSignatureOf(d),notes:`Identified StoryWeaver wrapper blocks removed while credit/story paragraphs were retained; ${docLang} wording retained. Source-fidelity only; no native-speaker claim.`}; fs.writeFileSync(file,JSON.stringify(d)); const sha=crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex'); e.review={...e.review,coversSourceSha256:sha}; repaired.push(d); }
  const usable = repaired.filter((d:any) => d.sections?.some((s:any) => s.paragraphs?.some((p:any) => /\p{L}/u.test(String(p.text??''))))); const quarantined = new Set(docLang==='es'?['bridge-navy-et-bora-uapv-hdr4','bridge-increible-margarita','bridge-el-cuervo-generoso-2']:[]); for (const d of usable) if (quarantined.has(d.work?.slug)) d.review={...d.review,status:'quarantined',notes:'Quarantined after source inspection: language mismatch or obvious source-language quality issue; wording retained and no native-speaker claim.'}; const published=usable.filter((d:any)=>!quarantined.has(d.work?.slug)); manifest.entries = manifest.entries.filter((e:any) => published.some((d:any) => d.work?.slug === e.slug));
  fs.writeFileSync(path.join(out,'documents.json'),JSON.stringify(published)); fs.writeFileSync(mf,JSON.stringify(manifest,null,2)); fs.writeFileSync(path.join(out,'quarantine.json'),JSON.stringify({language:docLang,slugs:[...quarantined],reason:'Source inspection; no text rewriting.'},null,2)); console.log(JSON.stringify({repaired:repaired.length,usable:published.length,quarantined:quarantined.size,out})); process.exit(0);
}
const r=await fetch(api); if(!r.ok) throw new Error(`GDL ${lang} catalogue HTTP ${r.status}`); const payload=await r.json() as any; const books=(payload.books??[]).filter((b:any)=>b.license?.some((x:any)=>/cc-by-4-0|CC-BY-4.0/i.test(x.slug??x.name??''))).slice(0,limit);
const docs:any[]=[]; const entries:any[]=[]; for(const b of books){if(!b.epubUrl)continue; const got=await fetch(`${b.epubUrl}${b.epubUrl.includes("?")?"&":"?"}bridge-fetch=20261002`); if(!got.ok)continue; const bytes=new Uint8Array(await got.arrayBuffer()); let epub:any; try { epub=await readEpub(bytes); } catch { continue; } const text=epub.chapters.map((c:any)=>c.text).join('\n\n'); const result=plainTextToDocuments(text,{lang:docLang,title:b.title,idPrefix:`bridge-${b.post_name}`,chapters:'none',paragraphs:'blank-line',sourceKind:'plain'}); const d=result.documents[0]; const sha=crypto.createHash('sha256').update(text).digest('hex'); d.source={id:`src:bridge:${docLang}:${b.post_name}`,title:b.title,publisher:b.publisher??'StoryWeaver',url:b.postLink,edition:`Global Digital Library ${b.bookId??b.postId}`,attribution:`${b.title} — ${b.publisher??'StoryWeaver'}; CC BY 4.0; Global Digital Library.`,provenance:`Exact source EPUB downloaded from the official GDL API on 2026-10-02; wording retained, with no translation or rewriting.`,rights:'licensed',licenseNote:'CC BY 4.0; attribution required and changes must be indicated.',authorship:'licensed'}; d.review={status:'reviewed',reviewedBy:'acquire-reading-bridge source-fidelity check',reviewedAt:'2026-10-02',contentSignature:contentSignatureOf(d),notes:'Source-fidelity review only; no native-speaker claim.'}; d.corpus={id:`reading-bridge-${docLang}`,kind:'comprehensible-input',title:`GDL ${docLang} reading bridge`}; d.work={slug:`bridge-${b.post_name}`,chapter:{index:docs.length,title:b.title}}; docs.push(d); entries.push({slug:`bridge-${b.post_name}`,title:b.title,streams:['library'],contentType:'story',rights:{state:'verified-open-licence',copyrightStatus:'licensed',permission:'not-needed',canBundle:true,userImportOnly:false,canModify:true,canStoreOffline:true,verified:true,verifiedBy:'Official GDL API book licence',verifiedAt:'2026-10-02',basis:`GDL API marks this book CC BY 4.0; official book page and API retained.`,licensing:'CC BY 4.0',statusByJurisdiction:{'*':'licensed'},evidence:[api,b.postLink]},source:{file:`${b.post_name}.json`,kind:'documents',url:b.postLink,edition:`Global Digital Library ${b.bookId??b.postId}`,attribution:`${b.title} — ${b.publisher??'StoryWeaver'}; CC BY 4.0; Global Digital Library.`,provenance:'Source document generated from the exact official GDL EPUB; source wording retained.'},review:{status:'reviewed',reviewedBy:'acquire-reading-bridge source-fidelity check',reviewedAt:'2026-10-02',coversSourceSha256:sha}}); fs.writeFileSync(path.join(out,`${b.post_name}.json`),JSON.stringify(d)); }
fs.writeFileSync(path.join(out,'documents.json'),JSON.stringify(docs)); fs.writeFileSync(path.join(out,'library-manifest.json'),JSON.stringify({schema:1,lang:docLang,apiLanguage:lang,entries},null,2)); fs.writeFileSync(path.join(out,'catalogue.json'),JSON.stringify({api,apiLanguage:lang,language:docLang,available:books.length,imported:entries.length,albanianStatus:/^(sq|sqi|als)$/.test(lang)?(books.length?'available':'no books in official catalogue'):'not queried'},null,2)); console.log(JSON.stringify({lang,language:docLang,available:books.length,imported:entries.length,out}));
