        { "form": "Schlaf", "lemma": "Schlaf", "pos": "NOUN", "morph": { "Case": "Acc", "Gender": "Masc", "Number": "Sing" } },
        { "form": "haben", "lemma": "haben", "morph": { "VerbForm": "Inf" } }
      ], "constructions": ["modal-infinitive"] },
    { "id": "r3-k05", "category": "native prose (Kafka)", "text": "Andere Reisende leben wie Haremsfrauen.",
      "tokens": [
        { "form": "leben", "lemma": "leben", "pos": "VERB", "morph": { "Person": "3", "Number": "Plur" } },
        { "form": "Reisende", "lemma": ["Reisende", "Reisender", "reisend", "reisen"], "pos": ["NOUN", "ADJ"], "morph": { "Number": "Plur" } },
        { "form": "Haremsfrauen", "lemma": "Haremsfrau", "pos": "NOUN", "morph": { "Number": "Plur" } }
      ] },
    { "id": "r3-k06", "category": "native prose (Kafka)", "text": "Das sollte ich bei meinem Chef versuchen; ich würde auf der Stelle hinausfliegen.",
      "tokens": [
        { "form": "sollte", "lemma": "sollen", "pos": "AUX", "morph": { "Person": "1", "Number": "Sing" } },
