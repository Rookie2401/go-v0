      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Sam është në rrugë.",
              "english": "Sam is in the street."
            },
            {
              "text": "Ai ka një çantë me bukë.",
              "english": "He has a bag with bread."
            },
            {
              "text": "Ardi është me një vajzë.",
              "english": "Ardi is with a girl."
            },
            {
              "text": "Kush është ajo?",
              "english": "Who is she?"
            },
            {
              "text": "Sam nuk e di.",
              "english": "Sam does not know."
            },
            {
              "text": "— Përshëndetje, Ardi!",
              "english": "\"Hello, Ardi!\""
            },
            {
              "text": "— Përshëndetje, Sam! Kjo është Elira.",
              "english": "\"Hello, Sam! This is Elira.\""
            },
            {
              "text": "— Gëzohem, Elira!",
              "english": "\"Pleased to meet you, Elira!\""
            },
            {
              "text": "— Gëzohem, Sam!",
              "english": "\"Pleased to meet you, Sam!\""
            },
            {
              "text": "Ardi dhe Elira shkojnë në shkollë.",
              "english": "Ardi and Elira go to school."
            },
            {
              "text": "Ardi është djalë i mirë.",
              "english": "Ardi is a good boy."
            },
            {
              "text": "Edhe Elira është shumë e mirë.",
              "english": "Elira is very good too."
            },
            {
              "text": "Sam shkon në shtëpi me bukë.",
              "english": "Sam goes home with bread."
            }
          ]
        }
      ]
    }
