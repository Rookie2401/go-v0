    {
      "id": "n1",
      "kind": "grammar",
      "title": "อยู่ที่ and ที่ไหน",
      "text": "อยู่ที่ means \"is at / lives at\": ต้นอยู่ที่บ้าน. For a question, put ที่ไหน (where) in the place slot: ต้นอยู่ที่ไหน? Thai does not move the question word to the front.",
      "explains": [
        "th.location-yu-thi",
        "th.where-thi-nai"
      ],
      "afterScenes": 1
    },
    {
      "id": "n2",
      "kind": "usage",
      "title": "ไม่เห็น, and \"I don't know\"",
      "text": "ไม่เห็นครับ means \"I do not see (him)\": ไม่ comes just before the verb. To say \"I don't know\", Thai says ไม่รู้ครับ, a phrase you will hear all the time; learn it as one piece.",
      "explains": [
        "th.not-see"
      ],
      "afterScenes": 1
    }
  ],
