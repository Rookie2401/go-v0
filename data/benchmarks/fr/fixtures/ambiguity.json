    { "id": "amb-001", "sentence": "Elle ouvre la porte.", "target": "porte", "expect": { "lemma": "porte", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "after the article la, porte is the noun" },
    { "id": "amb-002", "sentence": "Il porte un manteau.", "target": "porte", "expect": { "lemma": "porter", "pos": "VERB", "features": { "Tense": "Pres", "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "after a subject pronoun, porte is the verb" },
    { "id": "amb-003", "sentence": "J'ai lu un livre.", "target": "livre", "expect": { "lemma": "livre", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "un livre: the masculine noun (book)" },
    { "id": "amb-004", "sentence": "Elle a acheté une livre de beurre.", "target": "livre", "expect": { "lemma": "livre", "pos": "NOUN", "features": { "Gender": "Fem" } }, "source": "kaikki", "level": "advanced", "why": "une livre is the feminine noun (a pound): the gender follows the article" },
    { "id": "amb-005", "sentence": "Je livre le colis demain.", "target": "livre", "expect": { "lemma": "livrer", "pos": "VERB", "features": { "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "after je, livre is livrer" },
    { "id": "amb-006", "sentence": "Il est malade.", "target": "est", "expect": { "lemma": "être", "pos": "AUX", "features": { "Person": "3", "Number": "Sing" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "after il, est is être" },
    { "id": "amb-007", "sentence": "Le soleil se lève à l'est.", "target": "est", "expect": { "lemma": "est", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "advanced", "why": "after l' (the east) est is the noun" },
    { "id": "amb-008", "sentence": "L'été est chaud.", "target": "été", "expect": { "lemma": "été", "pos": "NOUN", "features": { "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "after l' (summer) été is the noun" },
    { "id": "amb-009", "sentence": "Elle n'a pas été là.", "target": "été", "expect": { "lemma": "être", "pos": "AUX", "features": { "VerbForm": "Part", "Tense": "Past" } }, "alsoAcceptPos": ["VERB"], "source": "kaikki", "level": "core", "why": "after a form of avoir, été is the participle of être" },
