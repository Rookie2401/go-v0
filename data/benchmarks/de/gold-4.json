      ], "constructions": ["modal-particle"] },
    { "id": "r4-14", "category": "native prose (Kafka)", "text": "Es war halb sieben Uhr, und die Zeiger gingen ruhig vorwärts, es war sogar halb vorüber, es näherte sich schon dreiviertel.",
      "tokens": [
        { "form": "gingen", "lemma": ["gehen", "vorwärtsgehen"], "pos": "VERB", "morph": { "Person": "3", "Number": "Plur", "Tense": "Past" } },
