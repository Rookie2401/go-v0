      "title": "Në treg",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Sam shkon në treg.",
              "english": "Sam goes to the market."
            },
            {
              "text": "Ai ka një çantë.",
              "english": "He has a bag."
            },
            {
              "text": "Gjyshja Drita shet bukë.",
              "english": "Grandmother Drita sells bread."
            },
            {
              "text": "— Mirëmëngjes, Drita!",
              "english": "\"Good morning, Drita!\""
            },
            {
              "text": "— Përshëndetje, Sam! Si je?",
              "english": "\"Hello, Sam! How are you?\""
            },
            {
              "text": "— Jam mirë, faleminderit.",
              "english": "\"I am well, thank you.\""
            },
            {
              "text": "— Çfarë dëshiron sot?",
              "english": "\"What would you like today?\""
            },
            {
              "text": "— Dua bukë, ju lutem.",
              "english": "\"I want bread, please.\""
            },
            {
              "text": "— Ja buka. Buka sot është shumë e mirë.",
              "english": "\"Here is the bread. The bread is very good today.\""
            },
            {
              "text": "— Sa kushton?",
              "english": "\"How much is it?\""
            },
            {
              "text": "— Dhjetë lekë.",
              "english": "\"Ten lek.\""
            },
            {
              "text": "— Faleminderit, Drita.",
              "english": "\"Thank you, Drita.\""
            },
            {
              "text": "— S'ka përse, Sam.",
              "english": "\"You're welcome, Sam.\""
            },
            {
              "text": "Sam ka bukë në çantë.",
              "english": "Sam has bread in the bag."
            },
            {
              "text": "Ai shkon në shtëpi.",
              "english": "He goes home."
            }
          ]
        }
      ]
    }
