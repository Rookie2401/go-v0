      "title": "Ana punon",
      "paragraphs": [
        {
          "sentences": [
            {
              "text": "Ana punon në klinikë.",
              "english": "Ana works at the clinic."
            },
            {
              "text": "Klinika është e madhe.",
              "english": "The clinic is big."
            },
            {
              "text": "Sot Ana është e lodhur.",
              "english": "Today Ana is tired."
            },
            {
              "text": "Ajo do kafe, por nuk ka kafe.",
              "english": "She wants coffee, but she has no coffee."
            },
            {
              "text": "Luan ka kafe.",
              "english": "Luan has coffee."
            },
            {
              "text": "Ai i jep kafe.",
              "english": "He gives her coffee."
            },
            {
              "text": "— Faleminderit, Luan!",
              "english": "\"Thank you, Luan!\""
            },
            {
              "text": "— S'ka përse, Ana.",
              "english": "\"You're welcome, Ana.\""
            },
            {
              "text": "Ana pi kafe.",
              "english": "Ana drinks coffee."
            },
            {
              "text": "Kafeja është shumë e mirë.",
              "english": "The coffee is very good."
            },
            {
              "text": "Tani Ana nuk është e lodhur.",
              "english": "Now Ana is not tired."
            },
            {
              "text": "Luan shkon në shkollë.",
              "english": "Luan goes to school."
            },
            {
              "text": "Ana shkon në shtëpi.",
              "english": "Ana goes home."
            }
          ]
        }
      ]
    }
  ],
