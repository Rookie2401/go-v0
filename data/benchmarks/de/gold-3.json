        { "form": "hinausfliegen", "lemma": "hinausfliegen", "pos": "VERB", "morph": { "VerbForm": "Inf" } },
        { "form": "Chef", "lemma": "Chef", "pos": "NOUN", "morph": { "Case": "Dat", "Gender": "Masc", "Number": "Sing" } },
