{
  "category": "pronouns",
  "note": "Subject, object, reflexive and disjunctive pronouns, y and en, double clitics, imperative clitics, on, ce/c'est, and the pairs that share a form (lui, leur, en, y, le/la/les). The lemma of the third-person plural and feminine forms (ils, elles, eux, la) is left unasserted where dictionaries and the Universal Dependencies treebank disagree about it. An AI's judgement, not native-reviewed.",
  "cases": [
    { "id": "pron-001", "sentence": "Je dors.", "target": "Je", "expect": { "lemma": "je", "pos": "PRON", "features": { "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "first person singular subject" },
    { "id": "pron-002", "sentence": "Tu dors.", "target": "Tu", "expect": { "lemma": "tu", "pos": "PRON", "features": { "Person": "2", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "second person singular subject (tu is also a past participle of taire, not here)" },
    { "id": "pron-003", "sentence": "Il dort.", "target": "Il", "expect": { "lemma": "il", "pos": "PRON", "features": { "Person": "3", "Number": "Sing", "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "third person masculine singular subject" },
    { "id": "pron-004", "sentence": "Elle dort.", "target": "Elle", "expect": { "lemma": "elle", "pos": "PRON", "features": { "Person": "3", "Number": "Sing", "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "third person feminine singular subject" },
    { "id": "pron-005", "sentence": "Nous dormons.", "target": "Nous", "expect": { "lemma": "nous", "pos": "PRON", "features": { "Person": "1", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "first person plural subject" },
    { "id": "pron-006", "sentence": "Vous dormez.", "target": "Vous", "expect": { "lemma": "vous", "pos": "PRON", "features": { "Person": "2" } }, "source": "kaikki", "level": "core", "why": "second person (plural or polite) subject" },
    { "id": "pron-007", "sentence": "Ils dorment.", "target": "Ils", "expect": { "pos": "PRON", "features": { "Person": "3", "Number": "Plur", "Gender": "Masc" } }, "source": "kaikki", "level": "core", "why": "third person masculine plural subject" },
    { "id": "pron-008", "sentence": "Elles dorment.", "target": "Elles", "expect": { "pos": "PRON", "features": { "Person": "3", "Number": "Plur", "Gender": "Fem" } }, "source": "kaikki", "level": "core", "why": "third person feminine plural subject" },
    { "id": "pron-009", "sentence": "Il me voit.", "target": "me", "expect": { "lemma": "me", "pos": "PRON", "features": { "Person": "1", "Number": "Sing" }, "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "first person singular object clitic (direct or indirect)" },
    { "id": "pron-010", "sentence": "Il te voit.", "target": "te", "expect": { "lemma": "te", "pos": "PRON", "features": { "Person": "2", "Number": "Sing" }, "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "second person singular object clitic" },
    { "id": "pron-011", "sentence": "Il nous voit.", "target": "nous", "expect": { "lemma": "nous", "pos": "PRON", "features": { "Person": "1", "Number": "Plur", "Case": "Acc" }, "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "nous after the subject and before a verb is an object" },
    { "id": "pron-012", "sentence": "Je l'aime.", "target": "l'", "expect": { "lemma": "le", "pos": "PRON", "features": { "Case": "Acc" }, "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "elided l' before a verb is the direct-object pronoun" },
    { "id": "pron-013", "sentence": "Je lui parle.", "target": "lui", "expect": { "lemma": "lui", "pos": "PRON", "features": { "Person": "3", "Number": "Sing", "Case": "Dat" }, "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "lui before the verb is the indirect-object pronoun (parler à)" },
    { "id": "pron-014", "sentence": "Je parle avec lui.", "target": "lui", "expect": { "lemma": "lui", "pos": "PRON", "features": { "Person": "3", "Number": "Sing" } }, "source": "grammar", "level": "core", "why": "lui after a preposition is the disjunctive (stressed) pronoun" },
    { "id": "pron-015", "sentence": "Je leur parle.", "target": "leur", "expect": { "lemma": "leur", "pos": "PRON", "features": { "Person": "3", "Number": "Plur", "Case": "Dat" }, "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "leur before a verb is the invariable indirect-object pronoun" },
    { "id": "pron-016", "sentence": "Je vois leur maison.", "target": "leur", "expect": { "lemma": "leur", "pos": "DET", "features": { "Poss": "Yes" } }, "source": "grammar", "level": "core", "why": "leur before a noun is the possessive determiner" },
    { "id": "pron-017", "sentence": "Il se lave.", "target": "se", "expect": { "lemma": "se", "pos": "PRON", "features": { "Person": "3", "Reflex": "Yes" } }, "source": "grammar", "level": "core", "why": "reflexive third person" },
    { "id": "pron-018", "sentence": "Je me lave.", "target": "me", "expect": { "lemma": "me", "pos": "PRON", "features": { "Person": "1", "Reflex": "Yes" } }, "source": "grammar", "level": "core", "why": "reflexive first person" },
    { "id": "pron-019", "sentence": "Moi, je dors.", "target": "Moi", "expect": { "lemma": "moi", "pos": "PRON", "features": { "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "disjunctive first person" },
    { "id": "pron-020", "sentence": "Toi, tu dors.", "target": "Toi", "expect": { "lemma": "toi", "pos": "PRON", "features": { "Person": "2", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "disjunctive second person" },
    { "id": "pron-021", "sentence": "Lui, il dort.", "target": "Lui", "expect": { "lemma": "lui", "pos": "PRON", "features": { "Person": "3", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "disjunctive third person (lui is also a past participle of luire, not here)" },
    { "id": "pron-022", "sentence": "Eux, ils dorment.", "target": "Eux", "expect": { "pos": "PRON", "features": { "Person": "3", "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "disjunctive third person plural" },
    { "id": "pron-023", "sentence": "J'y vais.", "target": "y", "expect": { "lemma": "y", "pos": "PRON", "construction": "pronoun-y" }, "source": "kaikki", "level": "core", "why": "y replaces a place" },
    { "id": "pron-024", "sentence": "Il y a du pain.", "target": "y", "expect": { "lemma": "y", "pos": "PRON", "phrase": "il y a", "construction": "il-y-a" }, "source": "kaikki", "level": "core", "why": "il y a is a fixed unit" },
    { "id": "pron-025", "sentence": "J'en veux deux.", "target": "en", "expect": { "lemma": "en", "pos": "PRON", "construction": "pronoun-en" }, "source": "kaikki", "level": "core", "why": "en before a verb replaces a quantity: a pronoun" },
    { "id": "pron-026", "sentence": "Je vais en France.", "target": "en", "expect": { "lemma": "en", "pos": "ADP" }, "source": "kaikki", "level": "core", "why": "en before a noun is the preposition" },
    { "id": "pron-027", "sentence": "Je le lui donne.", "target": "le", "expect": { "lemma": "le", "pos": "PRON", "features": { "Case": "Acc" }, "construction": "double-object-pronouns" }, "source": "grammar", "level": "core", "why": "double clitic: direct object first" },
    { "id": "pron-028", "sentence": "Je le lui donne.", "target": "lui", "expect": { "lemma": "lui", "pos": "PRON", "features": { "Case": "Dat" }, "construction": "double-object-pronouns" }, "source": "grammar", "level": "core", "why": "double clitic: indirect object second" },
    { "id": "pron-029", "sentence": "Il me le donne.", "target": "le", "expect": { "lemma": "le", "pos": "PRON", "features": { "Case": "Acc" }, "construction": "double-object-pronouns" }, "source": "grammar", "level": "core", "why": "me le: the third-person direct object follows me" },
    { "id": "pron-030", "sentence": "Donne-le-moi !", "target": "moi", "expect": { "lemma": "moi", "pos": "PRON", "construction": "imperative-pronouns" }, "source": "grammar", "level": "advanced", "why": "after a positive imperative the object is moi, not me" },
    { "id": "pron-031", "sentence": "Parle-lui !", "target": "lui", "expect": { "lemma": "lui", "pos": "PRON", "features": { "Case": "Dat" }, "construction": "imperative-pronouns" }, "source": "grammar", "level": "advanced", "why": "lui after an imperative is the indirect object" },
    { "id": "pron-032", "sentence": "On mange ici.", "target": "On", "expect": { "lemma": "on", "pos": "PRON", "features": { "Person": "3", "Number": "Sing" } }, "source": "ud", "level": "core", "why": "on is a third person singular subject (UD GSD: Person=3, Number=Sing; the extract labels its 'we' sense plural, which is a meaning, not the agreement)" },
    { "id": "pron-033", "sentence": "C'est vrai.", "target": "c'", "expect": { "lemma": "ce", "pos": "PRON", "construction": "c-est" }, "source": "kaikki", "level": "core", "why": "c' is the elided pronoun ce" },
    { "id": "pron-034", "sentence": "Ce n'est pas vrai.", "target": "Ce", "expect": { "lemma": "ce", "pos": "PRON" }, "source": "grammar", "level": "core", "why": "ce before est is the pronoun, not the determiner" },
    { "id": "pron-035", "sentence": "Celui-ci est grand.", "target": "Celui-ci", "expect": { "lemma": "celui-ci", "pos": "PRON", "tokens": ["Celui-ci", "est", "grand"] }, "source": "kaikki", "level": "core", "why": "a hyphenated demonstrative pronoun is one token" },
    { "id": "pron-036", "sentence": "Qui est là ?", "target": "Qui", "expect": { "lemma": "qui", "pos": "PRON", "features": { "PronType": "Int" } }, "source": "kaikki", "level": "core", "why": "interrogative who" },
    { "id": "pron-037", "sentence": "Que veux-tu ?", "target": "Que", "expect": { "lemma": "que", "pos": "PRON", "features": { "PronType": "Int" } }, "source": "kaikki", "level": "core", "why": "interrogative what (object); not the conjunction" },
    { "id": "pron-038", "sentence": "Tout est fini.", "target": "Tout", "expect": { "lemma": "tout", "pos": "PRON" }, "source": "kaikki", "level": "advanced", "why": "tout as the subject, followed by a verb, is the pronoun (everything)" },
    { "id": "pron-039", "sentence": "Chacun parle à son tour.", "target": "Chacun", "expect": { "lemma": "chacun", "pos": "PRON" }, "source": "kaikki", "level": "core", "why": "indefinite pronoun" },
    { "id": "pron-040", "sentence": "Je ne le vois pas.", "target": "le", "expect": { "lemma": "le", "pos": "PRON", "features": { "Case": "Acc" } }, "source": "grammar", "level": "core", "why": "le between ne and the verb is the pronoun" },
    { "id": "pron-041", "sentence": "Vous me donnez cela ?", "target": "cela", "expect": { "lemma": "cela", "pos": "PRON" }, "source": "kaikki", "level": "core", "why": "demonstrative pronoun" },
    { "id": "pron-042", "sentence": "Ceci est bon.", "target": "Ceci", "expect": { "lemma": "ceci", "pos": "PRON" }, "source": "kaikki", "level": "core", "why": "demonstrative pronoun" },
    { "id": "pron-043", "sentence": "Je ne les connais pas.", "target": "les", "expect": { "lemma": "le", "pos": "PRON", "features": { "Number": "Plur" } }, "source": "kaikki", "level": "core", "why": "les before a verb is the plural direct object" },
    { "id": "pron-044", "sentence": "Elle l'a vue.", "target": "l'", "expect": { "lemma": "le", "pos": "PRON", "construction": "object-pronouns" }, "source": "grammar", "level": "core", "why": "l' before a form of avoir is the object pronoun" },
    { "id": "pron-045", "sentence": "Tu m'écoutes ?", "target": "m'", "expect": { "lemma": "me", "pos": "PRON", "features": { "Person": "1", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "m' is the elided me" },
    { "id": "pron-046", "sentence": "Il t'aime.", "target": "t'", "expect": { "lemma": "te", "pos": "PRON", "features": { "Person": "2", "Number": "Sing" } }, "source": "kaikki", "level": "core", "why": "t' is the elided te" },
    { "id": "pron-047", "sentence": "Elle s'habille.", "target": "s'", "expect": { "lemma": "se", "pos": "PRON", "features": { "Reflex": "Yes" } }, "source": "kaikki", "level": "core", "why": "s' is the elided reflexive se" },
    { "id": "pron-048", "sentence": "Il y en a trois.", "target": "en", "expect": { "lemma": "en", "pos": "PRON", "construction": "pronoun-en" }, "source": "grammar", "level": "advanced", "why": "y en a: en is the pronoun of quantity after y" }
  ]
}
