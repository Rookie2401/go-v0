      ], "constructions": ["modal-infinitive"], "notConstructions": ["separable-prefix-verb"] },
    { "id": "r3-k11", "category": "native prose (Kafka)", "text": "Er glitt wieder in seine frühere Lage zurück.",
      "tokens": [
