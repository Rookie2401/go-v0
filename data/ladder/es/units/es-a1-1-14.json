              "speaker": "karla",
              "text": "Sam, ¿qué número tenés?",
              "english": "Sam, what number do you have?"
            },
            {
              "speaker": "sam",
              "text": "Mi número es 9987-2345.",
              "english": "My number is 9987-2345."
            },
            {
              "speaker": "karla",
              "text": "Gracias.",
              "english": "Thanks."
            },
            {
              "speaker": "karla",
              "text": "Voy a escribir el número.",
              "english": "I am going to write the number down."
            },
            {
              "speaker": "sam",
              "text": "Pero siempre pierdo mi celular.",
              "english": "But I always lose my phone."
            },
            {
              "speaker": "sam",
              "text": "Busco mi celular y no encuentro nada.",
              "english": "I look for my phone and find nothing."
