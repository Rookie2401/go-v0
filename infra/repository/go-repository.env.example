# /etc/go-repository/env  (mode 0640, owner root:go-repository). Read by go-repository.service and the backup/purge units through EnvironmentFile=.
# Plain KEY=value lines, no quotes, no export. Secrets live HERE and nowhere in the repository. See docs/ops/DEPLOY.md.

# --- store ---------------------------------------------------------------------------------------------------------
# Leave empty for SQLite (/var/lib/go-repository/repository.sqlite). For Postgres: postgres://go_repository:PASSWORD@HOST:5432/go_repository?sslmode=require
DATABASE_URL=

# --- behind Caddy -------------------------------------------------------------------------------------------------
# The service listens on 127.0.0.1 only; Caddy forwards the client address in X-Forwarded-For. Rate limits are per client address only with this on.
TRUST_PROXY=1
LOG_FORMAT=json

# --- monitoring ----------------------------------------------------------------------------------------------------
# openssl rand -base64 32     (Prometheus sends it as a bearer token; Caddy does not expose /metrics publicly anyway)
METRICS_TOKEN=

# --- email ---------------------------------------------------------------------------------------------------------
# Either SMTP (smtp://USER:PASSWORD@smtp.example.org:587 uses STARTTLS; smtps://… is TLS from the first byte) or Resend. MAIL_FROM is required with either.
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM=Go <no-reply@golearn-global-languages.com>
# The hosted GoLearn setup app that handles the links in the emails (#/verify?token=…, #/reset?token=…). No default.
APP_PUBLIC_URL=

# --- accounts ------------------------------------------------------------------------------------------------------
GRACE_DAYS=7
DELETE_GRACE_DAYS=14

# --- rate limits (defaults shown; RATE_LIMIT=off disables all) -------------------------------------------------------
#RATE_SIGNIN_MAX=10
#RATE_SIGNIN_WINDOW_S=60
#RATE_SIGNUP_MAX=5
#RATE_SIGNUP_WINDOW_S=3600
#RATE_SYNC_PUSH_MAX=60
#RATE_SYNC_PUSH_WINDOW_S=60
#RATE_GENERAL_MAX=600
#RATE_GENERAL_WINDOW_S=60

# --- backups (used by go-repository-backup.service) ------------------------------------------------------------------
# Encrypts every backup before it leaves the box. Keep a copy of this value somewhere that is NOT this server: without it the backups cannot be read.
BACKUP_PASSPHRASE=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=auto
# Alternative or additional: a command run with the backup path appended, e.g.  rclone copyto --  (see docs/ops/BACKUP-RESTORE.md)
BACKUP_UPLOAD_CMD=
