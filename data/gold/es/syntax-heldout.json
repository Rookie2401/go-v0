    {"text":"Mi abuela prepara el desayuno todas las mañanas.","tokens":["Mi","abuela","prepara","el","desayuno","todas","las","mañanas"],"heads":[1,2,-1,4,2,7,7,2],"relations":["det","nsubj","root","det","obj","det","det","obl"]},
