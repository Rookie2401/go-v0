        "status": "needed"
      }
    },
    {
      "id": "l2",
      "text": "मैं हिंदी बोलना सीखता हूँ।",
      "en": "I am learning to speak Hindi.",
      "speaker": "sam",
      "picture": "🗣️📚",
      "audio": {
        "status": "needed"
      }
    },
    {
      "id": "l3",
      "text": "मीरा और रवि मेरे दोस्त हैं।",
